      "Kind": "text",
      "Section": "What a verification represents",
      "Anchor": "what-a-verification-represents",
      "SectionPath": [
        "What a verification represents"
      ],
      "Text": "A member can hold multiple verifications, such as several employers. This schema currently includes identity and workplace verifications. LinkedIn shares which dimensions are verified and limited metadata, but not the underlying evidence (for example, an ID number or work email address).",
      "Headers": [],
      "Rows": []
