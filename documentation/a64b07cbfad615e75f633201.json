      "Kind": "text",
      "Section": "Verification data schema",
      "Anchor": "verification-data-schema",
      "SectionPath": [],
      "Text": "VerificationData is the decoded record model shared by Apply Connect with Verifications and Apply with LinkedIn with Verifications. It describes verified identity and workplace information. For AWLI, LinkedIn delivers the signed wrapper in verificationData.signature; the schema below represents the decoded claims, not the top-level browser payload.",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Verification data schema",
      "Anchor": "verification-data-schema",
      "SectionPath": [],
      "Text": "Note",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Verification data schema",
      "Anchor": "verification-data-schema",
      "SectionPath": [],
      "Text": "Verification data only confirms an applicant\u0027s verified identity or workplace. Its absence never indicates that an applicant is fraudulent, and it carries no negative meaning.",
      "Headers": [],
      "Rows": []
    },
