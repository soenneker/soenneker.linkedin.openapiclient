    {
      "Kind": "text",
      "Section": "Retrieve Lead Gen Form Response",
      "Anchor": "retrieve-lead-gen-form-response",
      "SectionPath": [
        "Retrieve Lead Gen Form Response"
      ],
      "Text": "How to determine which organizational pages you can query:\nTo find the organizations you can query {{resource, plural}} for, please use OrganizationAuthorization\u2019s BATCH_FIND by AuthorizationAction and AuthenticatedMember with an authorization action of LeadGenerationAuthorizationActionType.LEAD_GENERATION_READ.",
      "Headers": [],
      "Rows": []
    },
    {
