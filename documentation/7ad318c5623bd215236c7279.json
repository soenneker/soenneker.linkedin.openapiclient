      "Kind": "text",
      "Section": "Organizational Page Edge Analytics",
      "Anchor": "organizational-page-edge-analytics",
      "SectionPath": [],
      "Text": "The Organizational Page Edge Analytics API will provide visitor and follower analytics for an organizational page.\nThis API doesn\u2019t share members personal data as part of the API response.",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Organizational Page Edge Analytics",
      "Anchor": "organizational-page-edge-analytics",
      "SectionPath": [],
      "Text": "This API provides the following methods:",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Organizational Page Edge Analytics",
      "Anchor": "organizational-page-edge-analytics",
      "SectionPath": [],
      "Text": "Finder dimension provides aggregate demographic breakdown analytics based on facets such as location, job function, seniority, industry, and company size across a given time range.\nFinder trend provides the trend of visitors/followers gained over a period of time up to 365 days.",
      "Headers": [],
      "Rows": []
    },
