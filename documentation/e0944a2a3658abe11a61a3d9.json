      "Text": "",
      "Headers": [
        "Permission",
        "Description"
      ],
      "Rows": [
        [
          {
            "Text": "r_dma_admin_pages_content",
            "Links": [],
            "Values": []
          },
          {
            "Text": "Retrieve your organization\u2019s posts, comments, reactions, and other engagement data. Retrieve your organization\u2019s pages and reporting data (including follower, visitor, and content analytics). Restricted to organizations where the authenticated member has one of the following company page roles. ADMINISTRATORCONTENT_ADMINISTRATOR,ANALYST",
            "Links": [],
            "Values": [
              "ADMINISTRATOR",
              "CONTENT_ADMINISTRATOR,",
              "ANALYST"
            ]
          }
        ]
      ]
    },
