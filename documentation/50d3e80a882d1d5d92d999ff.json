      "Kind": "text",
      "Section": "Prerequisites",
      "Anchor": "prerequisites",
      "SectionPath": [
        "Prerequisites"
      ],
      "Text": "Before starting, ensure you have:",
      "Headers": [],
      "Rows": []
    },
    {
