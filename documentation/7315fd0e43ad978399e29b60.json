      "Kind": "text",
      "Section": "Job Resync Notifications",
      "Anchor": "job-resync-notifications",
      "SectionPath": [],
      "Text": "The Job Resync Notifications API allows your application to be notified by LinkedIn to request a job or multiple jobs to be re-synced via the SimpleJobPostings API. This allows us to resolve any inconsistencies between customer\u0027s job data between the ATS and LinkedIn for API posted jobs.",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Job Resync Notifications",
      "Anchor": "job-resync-notifications",
      "SectionPath": [],
      "Text": "Note",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Job Resync Notifications",
      "Anchor": "job-resync-notifications",
      "SectionPath": [],
      "Text": "Ensure to register and enable only one webhook for each event type per parent application in the developer portal\u0027s webhooks tab.",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Requirements",
      "Anchor": "requirements",
      "SectionPath": [
        "Requirements"
      ],
      "Text": "Configure a webhook url which is publicly acccesible.\nRegister and validate the webhook url in the LinkedIn Developer Portal",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Webhook Registration and Validation",
      "Anchor": "webhook-registration-and-validation",
      "SectionPath": [
        "Webhook Registration and Validation"
      ],
      "Text": "To receive notifications at your webhook, your webhook must be registered and validated. Please review and complete the steps in the documentation for Webhooks.",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Receive Resync Request",
      "Anchor": "receive-resync-request",
      "SectionPath": [
        "Receive Resync Request"
      ],
      "Text": "Registered webhook URLs will receive notifications from LinkedIn for job resync events. This request will contain the developerApplicationUrn associated to the customer and requested jobs. Process the requested job(s) for the specified developerApplicationUrn and using the jobPostingOperationType with UPDATE request for those job within 30 minutes. More details can be found here.",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "code",
      "Section": "Sample Request",
      "Anchor": "sample-request",
      "SectionPath": [
        "Receive Resync Request",
        "Sample Request"
      ],
      "Text": "POST https://{webhookUrl}",
      "Headers": [],
      "Rows": []
    },
