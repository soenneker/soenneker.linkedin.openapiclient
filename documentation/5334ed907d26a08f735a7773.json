      "Kind": "text",
      "Section": "Organization Email Domain Mapping",
      "Anchor": "organization-email-domain-mapping",
      "SectionPath": [],
      "Text": "The Organization Email Domain Mapping API retrieves domain mappings for different use cases. Domain mapping information includes the domain name and details of the company or administrator responsible for adding, modifying, or deleting the domain.",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Organization Email Domain Mapping",
      "Anchor": "organization-email-domain-mapping",
      "SectionPath": [],
      "Text": "The service currently provides the following method:",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Organization Email Domain Mapping",
      "Anchor": "organization-email-domain-mapping",
      "SectionPath": [],
      "Text": "Finder organizationalPageAndUseCase to get an email domain mapping by organizational page urn and use case.",
      "Headers": [],
      "Rows": []
    },
