      "Kind": "text",
      "Section": "Retrieve Organization Email Domain Mapping data",
      "Anchor": "retrieve-organization-email-domain-mapping-data",
      "SectionPath": [
        "Retrieve Organization Email Domain Mapping data"
      ],
      "Text": "How to determine which organizational pages you can query:\nTo find the organizations you can query {{resource, plural}} for, please use OrganizationAuthorization\u2019s BATCH_FIND by AuthorizationAction and AuthenticatedMember with an authorization action of OrganizationProfileAuthorizationActionType.ORGANIZATION_PROFILE_WRITE.",
      "Headers": [],
      "Rows": []
    },
    {
