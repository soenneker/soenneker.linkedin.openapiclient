        "FINDER",
        "Sample Request"
      ],
      "Text": "http\n\n\ncurl",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "code",
      "Section": "Sample Request",
      "Anchor": "sample-request",
      "SectionPath": [
        "Retrieve Organization Email Domain Mapping data",
        "FINDER",
        "Sample Request"
      ],
      "Text": "GET https://api.linkedin.com/rest/dmaOrganizationalPageEmailDomainMapping?q=organizationalPageAndUseCase\u0026organizationalPageUrn={ORGANIZATIONAL_PAGE_URN}\u0026useCase=(value:JOB_POSTING)\u0026start=1\u0026count=10",
      "Headers": [],
      "Rows": []
    },
