      "Section": "Sync Application Stages",
      "Anchor": "",
      "SectionPath": [
        "Sync Application Stages"
      ],
      "Text": "Use the following endpoint to create and update application stages:",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "code",
      "Section": "Sync Application Stages",
      "Anchor": "",
      "SectionPath": [
        "Sync Application Stages"
      ],
      "Text": "PUT https://api.linkedin.com/v2/atsApplications/atsJobApplicationId={id1}\u0026dataProvider=ATS\u0026integrationContext={organization URN}/stages?ids={stage id 1}\u0026ids={stage id 2}",
      "Headers": [],
      "Rows": []
    },
