          {
            "Text": "atsCreatedAt",
            "Links": [],
            "Values": []
          },
          {
            "Text": "Date record was created in your ATS. Must be greater than 0.",
            "Links": [],
            "Values": []
          },
          {
            "Text": "UTC Epoch Milliseconds",
            "Links": [],
            "Values": []
          },
          {
            "Text": "Yes",
            "Links": [],
