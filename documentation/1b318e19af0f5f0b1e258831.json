      "Section": "Sync Application Stages",
      "Anchor": "sync-application-stages",
      "SectionPath": [],
      "Text": "All application stages should be sent via the Middleware Platform whenever they are created or updated in your ATS. Use both your application identifier and stage identifier when syncing application stages via API.",
      "Headers": [],
      "Rows": []
    },
