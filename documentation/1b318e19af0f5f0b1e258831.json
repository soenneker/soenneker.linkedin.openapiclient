        [
          {
            "Text": "stage",
            "Links": [],
            "Values": []
          },
          {
            "Text": "Stage in which the application stayed supplied by external ATS (e.g. Phone Screen, Onsite Interview, Rejected, Hired, etc.). Must be at least one character and not Not Available.",
