      "Anchor": "sample-request-2",
      "SectionPath": [
        "Search by Filters",
        "Sample Request"
      ],
      "Text": "GET https://api.linkedin.com/v2/companySearch?q=search\u0026query=LinkedIn%20Corporation\u0026filter.industry%5B0%5D=6\u0026filter.companySize%5B0%5D=H",
      "Headers": [],
      "Rows": []
