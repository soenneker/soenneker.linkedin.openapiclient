    {
      "Kind": "text",
      "Section": "Search Response",
      "Anchor": "search-response",
      "SectionPath": [
        "Filter Details",
        "Search Response"
      ],
      "Text": "By default, results will contain an organization URN for each search hit. Get the id, name, localizedName, vanityName, logoV2, and locations for each search hit using decoration in the request via the projection query parameter.",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Search Response",
      "Anchor": "search-response",
      "SectionPath": [
        "Filter Details",
        "Search Response"
      ],
      "Text": "For example:",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Search Response",
      "Anchor": "search-response",
      "SectionPath": [
        "Filter Details",
        "Search Response"
      ],
      "Text": "\u0026projection=(elements*(entity~(vanityName)),paging)",
      "Headers": [],
      "Rows": []
    },
