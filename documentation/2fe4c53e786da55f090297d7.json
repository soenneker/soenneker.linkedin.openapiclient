    {
      "Kind": "text",
      "Section": "Company Search",
      "Anchor": "company-search",
      "SectionPath": [],
      "Text": "Deprecation Notice:\nThe Marketing Version 202510 (Marketing October 2025) will be sunset on October 15, 2026. We recommend that you migrate to the latest versioned APIs to avoid disruptions. For information on all the supported versions, refer to the migrations documentation.\nIf you haven\u2019t yet migrated and have questions, submit a request on the LinkedIn Developer Support Portal.",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Company Search",
      "Anchor": "company-search",
      "SectionPath": [],
      "Text": "The Company Search API enables you to find companies using keywords, industry, location, and other criteria. It returns a collection of matching companies. Each entry can contain an entity field represented by an organization URN.",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Company Search",
      "Anchor": "company-search",
      "SectionPath": [],
      "Text": "The API also supports filters to further refine your request, which is similar to using the filters on the left-hand side of the LinkedIn Search results page.",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Company Search",
      "Anchor": "company-search",
      "SectionPath": [],
      "Text": "Note",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Company Search",
      "Anchor": "company-search",
      "SectionPath": [],
      "Text": "The Company Search endpoint is restricted. This permission is granted to selected developers only.",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Search for Companies",
      "Anchor": "search-for-companies",
      "SectionPath": [
        "Search for Companies"
      ],
      "Text": "Here are a few examples of how to use the Company Search API.",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Sample Request",
      "Anchor": "sample-request",
      "SectionPath": [
        "Search for Companies",
        "Sample Request"
      ],
      "Text": "http\n\n\ncurl",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "code",
      "Section": "Sample Request",
      "Anchor": "sample-request",
      "SectionPath": [
        "Search for Companies",
        "Sample Request"
      ],
      "Text": "GET https://api.linkedin.com/v2/companySearch?q=search",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "code",
      "Section": "Sample Request",
      "Anchor": "sample-request",
      "SectionPath": [
        "Search for Companies",
        "Sample Request"
      ],
      "Text": "curl -X GET \u0027https://api.linkedin.com/v2/companySearch?q=search\u0027 \\\n-H \u0027X-Restli-Protocol-Version: 2.0.0\u0027 \\\n-H \u0027Authorization: Bearer {INSERT_TOKEN}\u0027 \\\n-H \u0027Linkedin-Version: {version number in the format YYYYMM}\u0027 \\\n-H \u0027Content-Type: application/json\u0027",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Sample Request",
      "Anchor": "sample-request",
      "SectionPath": [
        "Search for Companies",
        "Sample Request"
      ],
      "Text": "Unless otherwise specified:",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Sample Request",
      "Anchor": "sample-request",
      "SectionPath": [
        "Search for Companies",
        "Sample Request"
      ],
      "Text": "All input is case insensitive.\nMultiple words should be joined using a space. Since you need to URL encode input, this translates to %20. For example, Andrew%20Clark.\nWhen you pass in multiple words, a search is made for the complete string.\nWildcards and Boolean logic is not supported (for example: *, ?, AND, and OR).",
      "Headers": [],
      "Rows": []
    },
