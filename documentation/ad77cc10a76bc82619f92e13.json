  "Blocks": [
    {
      "Kind": "text",
      "Section": "Job Status Change Notifications",
      "Anchor": "job-status-change-notifications",
      "SectionPath": [],
      "Text": "After jobs have successfully posted on LinkedIn a jobs\u0027 status can change at a later time. Some examples are jobs converting from an on-site to off-site application flow, jobs being reported by members resulting in that job being closed, or the promotion status changed by LinkedIn or the customer. With those changes partners do not have visibility into these changes as they happen, and have no way to retrieve the current status of a job posting on LinkedIn. This limitation also prevents ATS partners from having a way to display accurate job status information to customers in their UI.",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Job Status Change Notifications",
      "Anchor": "job-status-change-notifications",
      "SectionPath": [],
      "Text": "With the Job Status Change Notifications API this allows partners to be notified by LinkedIn in near real-time of up-to-date statuses of their customer posted jobs.",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Job Status Change Notifications",
      "Anchor": "job-status-change-notifications",
      "SectionPath": [],
      "Text": "Note",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Job Status Change Notifications",
      "Anchor": "job-status-change-notifications",
      "SectionPath": [],
      "Text": "Ensure to register and enable only one webhook for each event type per parent application in the developer portal\u0027s webhooks tab.",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Requirements",
      "Anchor": "requirements",
      "SectionPath": [
        "Requirements"
      ],
      "Text": "Configure a webhook url which is publicly acccesible.\nRegister and validate the webhook url in the LinkedIn Developer Portal",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Webhook Registration and Validation",
      "Anchor": "webhook-registration-and-validation",
      "SectionPath": [
        "Webhook Registration and Validation"
      ],
      "Text": "To receive notifications at your webhook, your webhook must be registered and validated. Please review and complete the steps in the documentation for Webhooks.",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Receive Job Status Change Notification",
      "Anchor": "receive-job-status-change-notification",
      "SectionPath": [
        "Receive Job Status Change Notification"
      ],
      "Text": "Registered webhook URLs will receive notifications from LinkedIn for job status change events. This request will contain the developerApplicationUrn associated to the customer and the externalJobPostingId of the updated job.",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "code",
      "Section": "Sample Request",
      "Anchor": "sample-request",
      "SectionPath": [
        "Receive Job Status Change Notification",
        "Sample Request"
      ],
      "Text": "POST https://{webhookUrl}",
      "Headers": [],
      "Rows": []
    },
