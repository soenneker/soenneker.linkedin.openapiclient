    },
    {
      "Kind": "text",
      "Section": "Button Rendering for AWLI V2",
      "Anchor": "button-rendering-for-awli-v2",
      "SectionPath": [
        "What\u0027s New",
        "Button Rendering for AWLI V2"
      ],
      "Text": "When not signed in \nAfter sign in to LinkedIn, you will have a LinkedIn cookie on your browser and the \u0022Apply with LinkedIn\u0022 button renders",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Button Rendering for AWLI V3",
      "Anchor": "button-rendering-for-awli-v3",
      "SectionPath": [
        "What\u0027s New",
        "Button Rendering for AWLI V3"
      ],
      "Text": "Apply with LinkedIn button is rendered as shown below. Also if you are not signed in, the button still displays and you are directed to the sign in screen when you click it",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "User Consent Management",
      "Anchor": "user-consent-management",
      "SectionPath": [
        "What\u0027s New",
        "User Consent Management"
      ],
      "Text": "With new Apply With Linkedin, the current cookie-based Apply with LinkedIn experience is replaced with an OAuth model. Candidate consents are now handled within the OAuth flow. The below images display the non-staffing and staffing variant of the consent screen",
      "Headers": [],
      "Rows": []
    },
