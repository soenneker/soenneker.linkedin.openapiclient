      "SectionPath": [
        "Configuration",
        "Knowledge Anywhere Configuration"
      ],
      "Text": "Client ID\n\nClient Secret",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Knowledge Anywhere Configuration",
      "Anchor": "knowledge-anywhere-configuration",
      "SectionPath": [
        "Configuration",
        "Knowledge Anywhere Configuration"
      ],
      "Text": "Once you\u2019ve gathered the required information, follow Knowledge Anywhere\u0027s configuration instructions.",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Knowledge Anywhere Configuration",
      "Anchor": "knowledge-anywhere-configuration",
