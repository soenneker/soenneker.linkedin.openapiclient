      "Kind": "text",
      "Section": "Profile Edit API - Courses",
      "Anchor": "profile-edit-api---courses",
      "SectionPath": [],
      "Text": "This sub-resource API will allow you to create, update, and delete courses of a member.\u00A0See Course Fields for a description of the fields available within this object.",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Supported Methods",
      "Anchor": "supported-methods",
      "SectionPath": [
        "Supported Methods"
      ],
      "Text": "CREATE | PARTIAL_UPDATE | DELETE",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "code",
      "Section": "CREATE",
      "Anchor": "create",
      "SectionPath": [
        "CREATE"
      ],
      "Text": "POST https://api.linkedin.com/v2/people/id={person ID}/courses",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "code",
      "Section": "sample request body",
      "Anchor": "sample-request-body",
      "SectionPath": [
        "CREATE",
        "sample request body"
      ],
      "Text": "{\n    \u0022name\u0022: {\n        \u0022localized\u0022: {\n            \u0022en_US\u0022: \u0022Introduction to Computer Science\u0022\n        },\n        \u0022preferredLocale\u0022: {\n            \u0022country\u0022: \u0022US\u0022,\n            \u0022language\u0022: \u0022en\u0022\n        }\n    },\n    \u0022number\u0022: \u0022171636\u0022,\n    \u0022occupation\u0022: \u0022urn:li:position:(urn:li:person:1234ABC,677616236)\u0022\n}",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "sample request body",
      "Anchor": "sample-request-body",
      "SectionPath": [
