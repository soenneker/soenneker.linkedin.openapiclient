    {
      "Kind": "table",
      "Section": "AdSegmentStatus",
      "Anchor": "adsegmentstatus",
      "SectionPath": [
        "Schema",
        "AdSegmentStatus"
      ],
      "Text": "",
      "Headers": [
        "Enum",
        "Description"
      ],
      "Rows": [
        [
          {
            "Text": "BUILDING",
            "Links": [],
            "Values": []
          },
          {
            "Text": "A status representing that this segment is being built by the Audience pipeline and not ready to be used yet.",
            "Links": [],
            "Values": []
          }
        ],
        [
          {
            "Text": "CREATION_PENDING",
            "Links": [],
            "Values": []
          },
          {
            "Text": "The segment is being created.",
            "Links": [],
            "Values": []
          }
        ],
        [
          {
            "Text": "UPDATING",
            "Links": [],
            "Values": []
          },
          {
            "Text": "A status representing that a segment is being updated and is being built by the backend again to pick up the updates.",
            "Links": [],
            "Values": []
          }
        ],
        [
          {
            "Text": "READY",
            "Links": [],
            "Values": []
          },
          {
            "Text": "A status representing that all information about this segment is ready and that campaigns using this segment can start to serve.",
            "Links": [],
            "Values": []
          }
        ],
        [
          {
            "Text": "FAILED",
            "Links": [],
            "Values": []
          },
          {
            "Text": "A status representing that some failure happened during the backend processing of this segment. For DMPSegments, failure specifics can be found in the \u0027failure\u0027 field under DMPDestinationSegmentInfo.",
            "Links": [],
            "Values": []
          }
        ],
        [
          {
            "Text": "ARCHIVED",
            "Links": [],
            "Values": []
          },
          {
            "Text": "A status representing that the segment hasn\u0027t been used in any active campaign for more than 30 days. The segment can still be used in a campaign before it gets expired in 90 days.",
            "Links": [],
            "Values": []
          }
        ],
        [
          {
            "Text": "EXPIRED",
            "Links": [],
            "Values": []
          },
          {
            "Text": "A status representing that a segment audience has been purged from our system due to data retention policy. Segments that haven\u0027t been used in any campaign for 90 days will become expired.",
            "Links": [],
            "Values": []
          }
        ]
      ]
    },
