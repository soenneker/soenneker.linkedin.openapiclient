          {
            "Text": "double",
            "Links": [],
            "Values": []
          },
          {
            "Text": "The probability that this lift was caused by random chance, assuming that the null hypothesis is correct. (In this case, the null hypothesis is that there\u0027s no lift.) The p-value is in the range of [0, 1].",
            "Links": [],
            "Values": []
          },
          {
            "Text": "Read only",
            "Links": [],
            "Values": []
          }
        ],
