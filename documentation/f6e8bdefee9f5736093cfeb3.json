    {
      "Kind": "text",
      "Section": "Ad Lift Test Results",
      "Anchor": "ad-lift-test-results",
      "SectionPath": [],
      "Text": "This is the resource for advertisers to view the result of an Ad Lift Test.",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Ad Lift Test Results",
      "Anchor": "ad-lift-test-results",
      "SectionPath": [],
      "Text": "It can take several days for the surveys to begin delivering, so you won\u0027t immediately see results upon launching an Ad Lift Test.",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Ad Lift Test Results",
      "Anchor": "ad-lift-test-results",
      "SectionPath": [],
      "Text": "Results can continue to fluctuate for up to 15 days after the end date as we continue to survey responses. This is caused by surveys that were served while the lift test was still running, but not viewed until after.",
      "Headers": [],
      "Rows": []
    },
