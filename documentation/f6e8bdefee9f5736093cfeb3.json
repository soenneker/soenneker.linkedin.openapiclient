    {
      "Kind": "text",
      "Section": "FindByAdLiftTests Finder",
      "Anchor": "findbyadlifttests-finder",
      "SectionPath": [
        "FindByAdLiftTests Finder"
      ],
      "Text": "This finder can be used to request the results for an Ad Lift Test. It returns a list of AdLiftTestResults.",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "FindByAdLiftTests Finder",
      "Anchor": "findbyadlifttests-finder",
      "SectionPath": [
        "FindByAdLiftTests Finder"
      ],
      "Text": "The request must include a header for Restli Protocol 2.0.0 as X-Restli-Protocol-Version: 2.0.0Restli 2.0 requires URNs in query params to be URL encoded. For example, urn:li:adLiftTest:1245678 would become urn%3Ali%3AadLiftTest%3A1245678",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "table",
      "Section": "Query Parameters",
      "Anchor": "query-parameters",
      "SectionPath": [
        "FindByAdLiftTests Finder",
        "Query Parameters"
      ],
      "Text": "",
      "Headers": [
        "Parameter",
        "Type",
        "Description",
        "Required"
      ],
      "Rows": [
        [
          {
            "Text": "adLiftTests",
            "Links": [],
            "Values": []
          },
          {
            "Text": "Array of Ad Lift Test Urns",
            "Links": [],
            "Values": []
          },
          {
            "Text": "The ad lift tests to fetch results for",
            "Links": [],
            "Values": []
          },
          {
            "Text": "Yes",
            "Links": [],
            "Values": []
          }
        ]
      ]
    },
    {
      "Kind": "code",
      "Section": "Sample Request",
      "Anchor": "sample-request",
      "SectionPath": [
        "FindByAdLiftTests Finder",
        "Sample Request"
      ],
      "Text": "GET https://api.linkedin.com/rest/adLiftTestResults?q=adLiftTests\u0026adLiftTests=List(urn%3Ali%3AadLiftTest%3A{liftTestId})",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Sample Response",
      "Anchor": "sample-response",
      "SectionPath": [
        "FindByAdLiftTests Finder",
        "Sample Response"
      ],
      "Text": "AdLiftTestResults will return an array containing all relevant results. If an Ad Lift Test is requested for which the member doesn\u0027t have access, it will be omitted from the results. If the request contains no valid Ad Lift Test Results, an empty array will be returned.",
      "Headers": [],
      "Rows": []
    },
