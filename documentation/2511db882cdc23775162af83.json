      "Kind": "text",
      "Section": "Industries - Standardized Data API",
      "Anchor": "industries---standardized-data-api",
      "SectionPath": [],
      "Text": "The industries API provides standardized industry data across the LinkedIn platform.",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Supported Methods",
      "Anchor": "supported-methods",
      "SectionPath": [
        "Supported Methods"
      ],
      "Text": "GET | BATCH_GET | GET_ALL",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Versions",
      "Anchor": "versions",
      "SectionPath": [
        "Versions"
      ],
      "Text": "The industries API currently supports only the static version (V1) of industry data from LinkedIn. To access other available versions of the Industry Taxonomy, please refer to the Industry Taxonomy Versions API and use the appropriate endpoint to retrieve the desired version.",
      "Headers": [],
      "Rows": []
    },
