        "Create Ad Lift Test Survey Questions"
      ],
      "Text": "New Ad Lift Tests Survey question can be created by issuing a POST to the below URL.",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "code",
      "Section": "Create Ad Lift Test Survey Questions",
      "Anchor": "create-ad-lift-test-survey-questions",
      "SectionPath": [
        "Create Ad Lift Test Survey Questions"
      ],
      "Text": "POST https://api.linkedin.com/rest/adLiftTests/{id}/adLiftTestSurveys",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "code",
      "Section": "Sample Request",
      "Anchor": "sample-request",
      "SectionPath": [
        "Create Ad Lift Test Survey Questions",
        "Sample Request"
      ],
      "Text": "POST https://api.linkedin.com/rest/adLiftTests/15715/adLiftTestSurveys",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "code",
      "Section": "Sample Response",
      "Anchor": "sample-response",
      "SectionPath": [
        "Create Ad Lift Test Survey Questions",
        "Sample Response"
      ],
