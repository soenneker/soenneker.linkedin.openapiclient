      "Anchor": "delete-ad-lift-test-survey-questions",
      "SectionPath": [
        "Create Ad Lift Test Survey Questions",
        "Delete Ad Lift Test Survey Questions"
      ],
      "Text": "An Ad Lift Test Survey questions can be deleted by issuing a DELETE call to the URL below. Ad Lift Test Survey questions are deleted in batches. Provide a list of questions to delete to the method below. Questions to delete are specified as a List for ids parameter. See sample request below. If an id parameter from the above Available Key Metrics table is not specified, an error will be thrown.",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "code",
      "Section": "Delete Ad Lift Test Survey Questions",
      "Anchor": "delete-ad-lift-test-survey-questions",
      "SectionPath": [
        "Create Ad Lift Test Survey Questions",
        "Delete Ad Lift Test Survey Questions"
      ],
      "Text": "DELETE https://api.linkedin.com/rest/adLiftTests/{AdLiftTestId}/adLiftTestSurveys?ids=List(RECALL)\u0022",
      "Headers": [],
      "Rows": []
    },
