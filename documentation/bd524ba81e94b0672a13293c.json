      "Kind": "text",
      "Section": "Ad Lift Tests Surveys",
      "Anchor": "ad-lift-tests-surveys",
      "SectionPath": [],
      "Text": "The Ad Lift Test Survey API enables advertisers to create, and delete the survey questions (Ad Lift Test Key Metrics) that are asked as part of an Ad Lift Test via API. Users may test for the metrics listed in Available Key Metrics.",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Ad Lift Tests Surveys",
      "Anchor": "ad-lift-tests-surveys",
      "SectionPath": [],
      "Text": "Tip",
