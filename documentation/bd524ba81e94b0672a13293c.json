      "Kind": "table",
      "Section": "AdLiftTestSurvey Schema",
      "Anchor": "adlifttestsurvey-schema",
      "SectionPath": [
        "AdLiftTestSurvey Schema"
      ],
      "Text": "",
      "Headers": [
        "Field Name",
        "Type",
        "Description",
        "Read only, create only"
      ],
      "Rows": [
        [
          {
            "Text": "id",
            "Links": [],
            "Values": []
          },
          {
            "Text": "enum AdLiftKeyMetric Available Options: AWARENESSRECALLFAMILIARITYFAVORABILITYRECOMMENDATIONCONSIDERATIONEMPLOYER_FAMILIARITYEMPLOYER_FAVORABILITYEMPLOYER_RECOMMENDATIONEMPLOYER_CONSIDERATION",
            "Links": [],
            "Values": [
              "AWARENESS",
              "RECALL",
              "FAMILIARITY",
              "FAVORABILITY",
              "RECOMMENDATION",
              "CONSIDERATION",
              "EMPLOYER_FAMILIARITY",
              "EMPLOYER_FAVORABILITY",
              "EMPLOYER_RECOMMENDATION",
              "EMPLOYER_CONSIDERATION"
            ]
          },
          {
            "Text": "RequiredThe lift key metric we\u0027re measuring using these surveys. E.g. we send a survey to the control/test splits that asks \u0022Have you heard of [brand]?\u0022 to measure recall. This is used as the key for the subresource.",
            "Links": [],
            "Values": []
          },
          {
            "Text": "Create Only",
            "Links": [],
            "Values": []
          }
        ],
        [
          {
            "Text": "adLiftTest",
            "Links": [],
            "Values": []
          },
          {
            "Text": "AdLiftTestUrn (e.g. urn:li:adLiftTest:1)",
            "Links": [],
            "Values": []
          },
          {
            "Text": "Ad Lift Test that this survey belongs to.",
            "Links": [],
            "Values": []
          },
          {
            "Text": "Read Only",
            "Links": [],
            "Values": []
          }
        ],
        [
          {
            "Text": "liftTestAccount",
            "Links": [],
            "Values": []
          },
          {
            "Text": "SponsoredAccountUrn (e.g urn:li:sponsoredAccount:123)",
            "Links": [],
            "Values": []
          },
          {
            "Text": "Advertising account that owns the Ad Lift test that this survey is associated with. (the account that owns the advertising campaigns and the account that serves surveys have to be different for security and survey fairness reasons). Lift Test is owned by the advertiser but we make a special account for serving surveys from LinkedIn on behalf of the advertiser (e.g. \u0022LinkedIn Surveys\u0022) and serve from there. This is the advertiser account that \u0022owns\u0022 the surveys and whom is interested in the results of the survey.",
            "Links": [],
            "Values": []
          },
          {
            "Text": "Read Only",
            "Links": [],
            "Values": []
          }
        ],
        [
          {
            "Text": "localizedQuestionText",
            "Links": [],
            "Values": []
          },
          {
            "Text": "string (e.g. \u0022Do you recall seeing an ad for your brand?\u0022)",
            "Links": [],
            "Values": []
          },
          {
            "Text": "Localized question text for this AdLiftKeyMetric. This be in the same locale as brandNameLocale defined in the associated lift test Ad Lift Test. Ad lift tests only target a single locale, so this string is only available in that single locale. Can be used to generate survey preview.",
            "Links": [],
            "Values": []
          },
          {
            "Text": "",
            "Links": [],
            "Values": []
          }
        ],
        [
          {
            "Text": "answers",
            "Links": [],
            "Values": []
          },
          {
            "Text": "Array of AdLiftTestSurveyAnswerMetadata",
            "Links": [
              "https://learn.microsoft.com/en-us/linkedin/marketing/integrations/experimentation/brand-lift-testing/ad-lift-test-surveys?view=li-lms-2026-09#adlifttestsurveyanswermetadata-schema"
            ],
            "Values": []
          },
          {
            "Text": "The localized answer text (like \u0022Yes\u0022 or \u0022Somewhat Familiar\u0022) for this answer. This be in the same locale as brandNameLocale defined in the lift test Ad Lift Test that this survey is for.",
            "Links": [],
            "Values": []
          },
          {
            "Text": "",
            "Links": [],
            "Values": []
          }
        ]
      ]
    },
