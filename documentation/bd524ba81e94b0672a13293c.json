      "Kind": "text",
      "Section": "Get Ad Lift Test Survey Question List",
      "Anchor": "get-ad-lift-test-survey-question-list",
      "SectionPath": [
        "Create Ad Lift Test Survey Questions",
        "Get Ad Lift Test Survey Question List"
      ],
      "Text": "Ad Lift Test Surveys are fetched in batches. Use the endpoint below to fetch all surveys under an Ad LiftTest.",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "code",
      "Section": "Get Ad Lift Test Survey Question List",
      "Anchor": "get-ad-lift-test-survey-question-list",
      "SectionPath": [
        "Create Ad Lift Test Survey Questions",
        "Get Ad Lift Test Survey Question List"
      ],
      "Text": "GET https://api.linkedin.com/rest/adLiftTests/{AdLiftTestId}/adLiftTestSurveys",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "code",
      "Section": "Sample Response",
