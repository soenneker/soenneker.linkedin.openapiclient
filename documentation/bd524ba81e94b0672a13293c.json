        "Available Key Metrics"
      ],
      "Text": "",
      "Headers": [
        "Symbol",
        "Description"
      ],
      "Rows": [
        [
          {
            "Text": "AWARENESS",
            "Links": [],
            "Values": []
          },
          {
            "Text": "Ask the user: \u0022Have you heard of brand?\u0022",
            "Links": [],
            "Values": []
          }
        ],
        [
          {
            "Text": "RECALL",
            "Links": [],
            "Values": []
          },
          {
            "Text": "Ask the user: \u0022Do you recall seeing an ad for brand/product online or on a mobile device in the last 7 days?\u0022We don\u0027t specify \u0022seen on LinkedIn\u0022 intentionally as these can also be seen on LAN.",
            "Links": [],
            "Values": []
          }
        ],
        [
          {
            "Text": "FAMILIARITY",
            "Links": [],
            "Values": []
          },
          {
            "Text": "Ask the user: \u0022How familiar are you with brand?\u0022",
            "Links": [],
            "Values": []
          }
        ],
        [
          {
            "Text": "FAVORABILITY",
            "Links": [],
            "Values": []
          },
          {
            "Text": "Ask the user: \u0022How favorably do you view brand/product?\u0022",
            "Links": [],
            "Values": []
          }
        ],
        [
          {
            "Text": "RECOMMENDATION",
            "Links": [],
            "Values": []
          },
          {
            "Text": "Ask the user: \u0022How likely are you to recommend brand/product to someone else?\u0022",
            "Links": [],
            "Values": []
          }
        ],
        [
          {
            "Text": "CONSIDERATION",
            "Links": [],
            "Values": []
          },
          {
            "Text": "Ask the user: \u0022How likely are you to consider brand/product for your next purchase?\u0022",
            "Links": [],
            "Values": []
          }
        ],
        [
          {
            "Text": "EMPLOYER_FAMILIARITY",
            "Links": [],
            "Values": []
          },
          {
            "Text": "Ask the user: \u0022How familiar are you with brand as an employer?\u0022",
            "Links": [],
            "Values": []
          }
        ],
        [
          {
            "Text": "EMPLOYER_FAVORABILITY",
            "Links": [],
            "Values": []
          },
          {
            "Text": "Ask the user: \u0022How favorably do you view brand as an employer?\u0022",
            "Links": [],
            "Values": []
          }
        ],
        [
          {
            "Text": "EMPLOYER_RECOMMENDATION",
            "Links": [],
            "Values": []
          },
          {
            "Text": "Ask the user: \u0022How likely would you recommend brand as employer to your friend or colleague?\u0022",
            "Links": [],
            "Values": []
          }
        ],
        [
          {
            "Text": "EMPLOYER_CONSIDERATION",
            "Links": [],
            "Values": []
          },
          {
            "Text": "Ask the user: \u0022If you were looking for a job, how likely would you be to consider brand?\u0022",
            "Links": [],
            "Values": []
          }
        ],
        [
          {
            "Text": "TOP_OF_MIND",
            "Links": [],
            "Values": []
          },
          {
            "Text": "Ask the user: \u0022What [a] _____ comes to mind, when you [b] _____________ ?\u0022 where a and b are defined by the user. Sample [a] is \u0022brand\u0022 and sample [b] is \u0022think of cloud computing.\u0022",
            "Links": [],
            "Values": []
          }
        ]
      ]
