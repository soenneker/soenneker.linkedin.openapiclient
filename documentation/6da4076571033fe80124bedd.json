      "Section": "Decoration Change to Activity URNs",
      "Anchor": "decoration-change-to-activity-urns",
      "SectionPath": [],
      "Text": "This page will outline the changes for decoration on activity URN in processedActivity in Compliance Events API . This change took effect on October 20, 2018.",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Decoration Change to Activity URNs",
      "Anchor": "decoration-change-to-activity-urns",
      "SectionPath": [],
