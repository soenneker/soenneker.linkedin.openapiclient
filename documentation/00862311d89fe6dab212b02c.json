    {
      "Kind": "text",
      "Section": "Video Ads",
      "Anchor": "video-ads",
      "SectionPath": [],
      "Text": "Deprecation Notice:\nThe Marketing Version 202510 (Marketing October 2025) will be sunset on October 15, 2026. We recommend that you migrate to the latest versioned APIs to avoid disruptions. For information on all the supported versions, refer to the migrations documentation.\nIf you haven\u2019t yet migrated and have questions, submit a request on the LinkedIn Developer Support Portal.",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Video Ads",
      "Anchor": "video-ads",
      "SectionPath": [],
      "Text": "Video Ads is the next generation of our Sponsored Content products that help you engage business decision-makers on LinkedIn\u0027s mobile and desktop news feed.",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Video Ads",
      "Anchor": "video-ads",
      "SectionPath": [],
      "Text": "Create video ads in two ways:",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Video Ads",
      "Anchor": "video-ads",
      "SectionPath": [],
      "Text": "Post videos to your company page and sponsor the post to reach more than just your followers. With a company page video, your organization can share a first-hand look into your company culture, products, news, and events to drive engagement and conversation with members right from their LinkedIn Company Page.\nCreate video ads that bypass Company Page followers and go directly to the news feed.",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Video Ads",
      "Anchor": "video-ads",
      "SectionPath": [],
      "Text": "Refer to Advertising Specifications for Video Ads for video ad requirements.",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Permissions",
      "Anchor": "permissions",
      "SectionPath": [
        "Permissions"
      ],
      "Text": "To use Video Ads, you must have the following permissions:",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "table",
      "Section": "Permissions",
      "Anchor": "permissions",
      "SectionPath": [
        "Permissions"
      ],
      "Text": "",
      "Headers": [
        "Permission",
        "Description"
      ],
      "Rows": [
        [
          {
            "Text": "w_organization_social",
            "Links": [],
            "Values": []
          },
          {
            "Text": "Post, comment, and like posts on behalf of an organization. Restricted to organizations in which the authenticated member has one of the following company page roles: ADMINISTRATOR DIRECT_SPONSORED_CONTENT_POSTER CONTENT_ADMIN",
            "Links": [],
            "Values": [
              "ADMINISTRATOR",
              "DIRECT_SPONSORED_CONTENT_POSTER",
              "CONTENT_ADMIN"
            ]
          }
        ],
        [
          {
            "Text": "w_member_social",
            "Links": [],
            "Values": []
          },
          {
            "Text": "Post, comment, and like posts on behalf of authenticated member",
            "Links": [],
            "Values": []
          }
        ],
        [
          {
            "Text": "rw_ads",
            "Links": [],
            "Values": []
          },
          {
            "Text": "Create ads and creatives for a sponsored account",
            "Links": [],
            "Values": []
          }
        ],
        [
          {
            "Text": "r_ads",
            "Links": [],
            "Values": []
          },
          {
            "Text": "Read an authenticated member\u0027s ad accounts. Restricted to ad accounts in which the authenticated member has one of the following ad account roles: ACCOUNT_BILLING_ADMINACCOUNT_MANAGERCAMPAIGN_MANAGERCREATIVE_MANAGERVIEWER",
            "Links": [],
            "Values": [
              "ACCOUNT_BILLING_ADMIN",
              "ACCOUNT_MANAGER",
              "CAMPAIGN_MANAGER",
              "CREATIVE_MANAGER",
              "VIEWER"
            ]
          }
        ]
      ]
    },
