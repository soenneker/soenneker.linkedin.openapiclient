    {
      "Kind": "text",
      "Section": "Add Production Redirect URIs",
      "Anchor": "add-production-redirect-uris",
      "SectionPath": [
        "Configure Production Settings",
        "Add Production Redirect URIs"
      ],
      "Text": "Go to Auth tab\nUnder Authorized redirect URLs, add your production URLs:\n\nhttps://yourdomain.com/auth/linkedin/callback\nhttps://yourdomain.com/oauth/callback",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Add Production Redirect URIs",
