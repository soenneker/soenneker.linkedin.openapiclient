      "Text": "curl -X GET \u0027https://api.linkedin.com/rest/identityMe\u0027 \\\n  -H \u0027Authorization: Bearer {ACCESS_TOKEN}\u0027 \\\n  -H \u0027LinkedIn-Version: {LATEST_VERSION}\u0027",
      "Headers": [],
      "Rows": []
    },
