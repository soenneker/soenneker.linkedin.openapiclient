    },
    {
      "Kind": "text",
      "Section": "Add Production Redirect URIs",
      "Anchor": "add-production-redirect-uris",
      "SectionPath": [
        "Configure Production Settings",
        "Add Production Redirect URIs"
      ],
      "Text": "Only HTTPS URLs are allowed. HTTP URLs will be rejected.",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Secure Your Credentials",
      "Anchor": "secure-your-credentials",
      "SectionPath": [
        "Configure Production Settings",
        "Secure Your Credentials"
      ],
      "Text": "\u2705 Store Client Secret in environment variables or secret manager\n\u2705 Never commit credentials to version control\n\u2705 Use different credentials for staging and production\n\u2705 Implement token encryption at rest",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "OAuth Flow",
