    {
      "Kind": "text",
      "Section": "How It Works",
      "Anchor": "how-it-works",
      "SectionPath": [
        "How It Works"
      ],
      "Text": "Member Authorizes: Grants your app permission to access their LinkedIn verification data via OAuth 2.0.\nFetch Verification Data: Call LinkedIn APIs to retrieve verification status and profile information.\nOptional Re-verification: The /verificationReport API also supports the optional verifiedWithinDays query parameter, allowing your application to periodically prompt members to re-verify while continuing to display their existing verification data.\nDisplay Verification Badges: Show \u0022Verified on LinkedIn\u0022 badges in your UI following our branding guidelines if the member is verified.",
      "Headers": [],
      "Rows": []
    },
