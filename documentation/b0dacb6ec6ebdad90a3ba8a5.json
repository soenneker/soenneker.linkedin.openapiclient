      "Kind": "text",
      "Section": "What Verified on LinkedIn Cannot Be Used For",
      "Anchor": "what-verified-on-linkedin-cannot-be-used-for",
      "SectionPath": [
        "Use Cases",
        "What Verified on LinkedIn Cannot Be Used For"
      ],
      "Text": "The API is designed for trust enhancement, not regulatory compliance or eligibility decisions.\nUse of the API is subject to LinkedIn\u0027s Developer Terms and Verification Policies.",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "table",
      "Section": "What Verified on LinkedIn Cannot Be Used For",
      "Anchor": "what-verified-on-linkedin-cannot-be-used-for",
      "SectionPath": [
        "Use Cases",
        "What Verified on LinkedIn Cannot Be Used For"
      ],
      "Text": "",
      "Headers": [
        "Restricted Use Case",
        "Reason"
      ],
      "Rows": [
        [
          {
            "Text": "Hiring or employment decisions",
            "Links": [],
            "Values": []
          },
          {
            "Text": "Not an employment screening tool. Do not use to rank or approve candidates.",
            "Links": [],
            "Values": []
          }
        ],
        [
          {
            "Text": "Background checks",
            "Links": [],
            "Values": []
          },
          {
            "Text": "Does not include criminal, financial, or government background data.",
            "Links": [],
            "Values": []
          }
        ],
        [
          {
            "Text": "Credit, loans, or insurance",
            "Links": [],
            "Values": []
          },
          {
            "Text": "Not related to creditworthiness or insurability.",
            "Links": [],
            "Values": []
          }
        ],
        [
          {
            "Text": "Housing eligibility",
            "Links": [],
            "Values": []
          },
          {
            "Text": "Cannot be used for rental or housing determinations.",
            "Links": [],
            "Values": []
          }
        ],
        [
          {
            "Text": "Fintech or banking KYC",
            "Links": [],
            "Values": []
          },
          {
            "Text": "Not a regulated KYC/AML service.",
            "Links": [],
            "Values": []
          }
        ],
        [
          {
            "Text": "Government or regulated identity checks",
            "Links": [],
            "Values": []
          },
          {
            "Text": "Not a substitute for official ID verification systems.",
            "Links": [],
            "Values": []
          }
        ],
        [
          {
            "Text": "Platform safety or risk scoring",
            "Links": [],
            "Values": []
          },
          {
            "Text": "Should complement \u2014 not replace your platform\u0027s trust and risk systems.",
            "Links": [],
            "Values": []
          }
