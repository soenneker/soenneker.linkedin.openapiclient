    {
      "Kind": "text",
      "Section": "Step 2: Generate an Access Token",
      "Anchor": "step-2-generate-an-access-token",
      "SectionPath": [
        "Step 2: Generate an Access Token"
      ],
      "Text": "View the Best Practices for Secure Applications page for more security info.",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Sample Request (Secure Approach)",
      "Anchor": "sample-request-secure-approach",
      "SectionPath": [
        "Step 2: Generate an Access Token",
        "Sample Request (Secure Approach)"
      ],
      "Text": "https\n\n\ncurl",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "code",
      "Section": "Sample Request (Secure Approach)",
      "Anchor": "sample-request-secure-approach",
      "SectionPath": [
        "Step 2: Generate an Access Token",
        "Sample Request (Secure Approach)"
      ],
      "Text": "POST https://www.linkedin.com/oauth/v2/accessToken HTTP/1.1\n\nContent-Type: application/x-www-form-urlencoded\ngrant_type=client_credentials\nclient_id={your_client_id}\nclient_secret={your_client_secret}",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "code",
      "Section": "Sample Request (Secure Approach)",
      "Anchor": "sample-request-secure-approach",
      "SectionPath": [
        "Step 2: Generate an Access Token",
        "Sample Request (Secure Approach)"
      ],
      "Text": "curl --location --request POST \u0027https://www.linkedin.com/oauth/v2/accessToken\u0027 \\\n--header \u0027Content-Type: application/x-www-form-urlencoded\u0027 \\\n--data-urlencode \u0027grant_type=client_credentials\u0027 \\\n--data-urlencode \u0027client_id={your_client_id}\u0027 \\\n--data-urlencode \u0027client_secret={your_client_secret}\u0027",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Sample Request (Secure Approach)",
      "Anchor": "sample-request-secure-approach",
      "SectionPath": [
        "Step 2: Generate an Access Token",
        "Sample Request (Secure Approach)"
      ],
      "Text": "A successful access token request returns a JSON object containing the following fields:",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Sample Request (Secure Approach)",
      "Anchor": "sample-request-secure-approach",
      "SectionPath": [
        "Step 2: Generate an Access Token",
        "Sample Request (Secure Approach)"
      ],
      "Text": "access_token \u2014 The access token for the application. This token must be kept secure.\nexpires_in \u2014 Seconds until token expiration.\n\nThe access token has a 30-minute lifespan and must be used immediately. You may request a new token once your current token expires.",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "code",
      "Section": "Sample Response",
      "Anchor": "sample-response",
      "SectionPath": [
        "Step 2: Generate an Access Token",
        "Sample Response"
      ],
      "Text": "{\n    \u0022access_token\u0022: \u0022AQV8...\u0022,\n    \u0022expires_in\u0022: \u00221800\u0022\n}",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Sample Response",
      "Anchor": "sample-response",
      "SectionPath": [
        "Step 2: Generate an Access Token",
        "Sample Response"
      ],
      "Text": "For error details, refer the API Error Details section.",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Step 3: Make API Requests",
      "Anchor": "step-3-make-api-requests",
      "SectionPath": [
        "Step 3: Make API Requests"
      ],
      "Text": "Once you\u0027ve received an access token, you can make API requests by including an Authorization header with your token in the HTTP call to LinkedIn\u0027s API.",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "code",
      "Section": "Sample Request",
      "Anchor": "sample-request",
      "SectionPath": [
        "Step 3: Make API Requests",
        "Sample Request"
      ],
      "Text": "GET https://api.linkedin.com/v2/jobs HTTP/1.1\n\nConnection: Keep-Alive\nAuthorization: Bearer {access_token}",
      "Headers": [],
      "Rows": []
    },
