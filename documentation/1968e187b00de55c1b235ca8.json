          {
            "Text": "entryCriteria",
            "Links": [],
            "Values": []
          },
          {
            "Text": "Entry criteria member needs to satisfy to be able to attend the event. Possible values: PUBLIC: This event is open to all members.GATED: A member needs to raise a request to attend the event.",
            "Links": [],
            "Values": [
              "PUBLIC: This event is open to all members.",
              "GATED: A member needs to raise a request to attend the event."
            ]
          },
          {
            "Text": "Enum",
            "Links": [],
            "Values": []
          }
        ],
        [
          {
            "Text": "discoveryMode",
            "Links": [],
            "Values": []
          },
          {
            "Text": "Mode in which the event can be discovered on LinkedIn. Possible values: LISTED: Event is discoverable through search/relevance/recommendation channels.URL_ONLY: Event can only be discovered via URL.",
            "Links": [],
            "Values": [
              "LISTED: Event is discoverable through search/relevance/recommendation channels.",
              "URL_ONLY: Event can only be discovered via URL."
            ]
          },
          {
            "Text": "Enum",
            "Links": [],
            "Values": []
          }
        ],
        [
          {
            "Text": "attendanceMode",
            "Links": [],
            "Values": []
          },
          {
            "Text": "Mode in which the attendees can attend an event. Possible values: IN_PERSON: The event is an offline only event with physical location associated to it and can only be attended in person.VIRTUAL: The event is an online only event, which has no physical location associated to it. It can only be attended virtually using steaming Url.IN_PERSON_OR_VIRTUAL: The event has a physical location to attend in person and also has url for attending virtually.",
            "Links": [],
            "Values": [
              "IN_PERSON: The event is an offline only event with physical location associated to it and can only be attended in person.",
              "VIRTUAL: The event is an online only event, which has no physical location associated to it. It can only be attended virtually using steaming Url.",
              "IN_PERSON_OR_VIRTUAL: The event has a physical location to attend in person and also has url for attending virtually."
