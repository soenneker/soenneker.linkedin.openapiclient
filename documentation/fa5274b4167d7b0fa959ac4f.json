    {
      "Kind": "code",
      "Section": "Sample Request",
      "Anchor": "sample-request",
      "SectionPath": [
        "Retrieve Lead Analytics",
        "Owner",
        "Sample Request"
      ],
      "Text": "GET https://api.linkedin.com/rest/dmaLeadAnalytics?q=owner\u0026owner={ORGANIZATION_URN}\u0026pivots=List((leadAnalyticsPivot:OWNER))\u0026leadTypes=List((leadType:EVENT))",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "code",
