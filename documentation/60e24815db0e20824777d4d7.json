      "Rows": [
        [
          {
            "Text": "SL-016",
            "Links": [],
            "Values": []
          },
          {
            "Text": "Pass LinkedIn InfoSec Review",
            "Links": [],
            "Values": []
          },
          {
            "Text": "Confirm that your application has passed LinkedIn\u2019s InfoSec security assessment.",
            "Links": [],
            "Values": []
          }
        ],
        [
          {
            "Text": "SL-017",
            "Links": [],
            "Values": []
          },
          {
            "Text": "Developer App Admin Management",
            "Links": [],
            "Values": []
          },
          {
            "Text": "Ensure all relevant personnel are added as admins and kept up to date.",
            "Links": [],
            "Values": []
          }
        ],
        [
          {
            "Text": "SL-018",
            "Links": [],
            "Values": []
          },
          {
            "Text": "Business Email DL Setup",
            "Links": [],
            "Values": []
          },
          {
            "Text": "Create a distribution list (DL) with correct owners and register it as the business email in the LinkedIn Developer Portal.",
            "Links": [],
            "Values": []
          }
        ],
        [
          {
            "Text": "SL-019",
            "Links": [],
            "Values": []
          },
          {
            "Text": "Support Routing Post-GA",
            "Links": [],
            "Values": []
          },
          {
            "Text": "Confirm that all post-GA support queries are routed to voli-support@linkedin.com.",
            "Links": [],
            "Values": []
          }
        ],
        [
          {
            "Text": "SL-020",
            "Links": [],
            "Values": []
          },
          {
            "Text": "Subscribe to API Status Page",
            "Links": [],
            "Values": []
          },
          {
            "Text": "Subscribe to LinkedIn API Status page and ensure you receive real-time notifications for incidents.",
            "Links": [],
            "Values": []
          }
        ],
        [
          {
            "Text": "SL-021",
            "Links": [],
            "Values": []
          },
          {
            "Text": "Monitor API Release Updates",
            "Links": [],
            "Values": []
          },
          {
            "Text": "Regularly review LinkedIn API release documentation to stay up to date with changes.",
            "Links": [],
            "Values": []
          }
        ]
      ]
    },
    {
      "Kind": "text",
      "Section": "Data Use \u0026 Retention Guidelines",
      "Anchor": "data-use--retention-guidelines",
      "SectionPath": [
        "Data Use \u0026 Retention Guidelines"
      ],
      "Text": "If LinkedIn has granted you access to the Verified on LinkedIn Plus Program, it will appear in the list of products that your application has access to on the LinkedIn developer portal. Please note that access to certain data fields may be restricted.",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Data Use \u0026 Retention Guidelines",
      "Anchor": "data-use--retention-guidelines",
      "SectionPath": [
        "Data Use \u0026 Retention Guidelines"
      ],
      "Text": "Consult your Verified on LinkedIn API Agreement for other restrictions, conditions, and data deletion obligations relating to this data. For example, the Verified on LinkedIn Agreement requires that you obtain an authenticated Member\u2019s consent before storing their verification data. If there is any conflict between these requirements and the requirements in your Agreement, the requirements that are more restrictive or more protective of the data apply. Similarly, if a given data field is encompassed by two or more of the following requirements, the shortest storage/caching duration shall apply.",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Data Use \u0026 Retention Guidelines",
      "Anchor": "data-use--retention-guidelines",
      "SectionPath": [
        "Data Use \u0026 Retention Guidelines"
      ],
      "Text": "LinkedIn reserves the right to update these requirements at any time by posting changes on our developer documentation, and it is your responsibility to review and ensure your integration remains compliant with the most current requirements. Partners are expected to make necessary updates to their systems and processes in a timely manner to remain in good standing.",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Data Use \u0026 Retention Guidelines",
      "Anchor": "data-use--retention-guidelines",
      "SectionPath": [
        "Data Use \u0026 Retention Guidelines"
      ],
      "Text": "The following requirements do not apply to data that is independently provided to you by your clients and not retrieved via the Verified on LinkedIn API.",
      "Headers": [],
      "Rows": []
    },
