      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Pathgather Configuration",
      "Anchor": "pathgather-configuration",
      "SectionPath": [
        "Configuration",
        "Pathgather Configuration"
      ],
      "Text": "Once you\u2019ve gathered the required information, follow the Pathgather configuration instructions described.",
