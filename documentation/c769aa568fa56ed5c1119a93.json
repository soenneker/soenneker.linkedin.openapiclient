              "https://learn.microsoft.com/en-us/linkedin/learning/integrations/retrieve-an-individual-learning-object#specifying-the-level-of-asset-details"
            ],
            "Values": []
          },
          {
            "Text": "No (default = 1)",
            "Links": [],
            "Values": []
