            "Values": []
          },
          {
            "Text": "The total number of learning entities matching the requested criteria",
            "Links": [],
            "Values": []
          }
        ],
        [
          {
            "Text": "count",
            "Links": [],
            "Values": []
          },
          {
            "Text": "The requested number of learning entities for the page",
            "Links": [],
            "Values": []
          }
        ],
        [
          {
            "Text": "start",
            "Links": [],
