      "Headers": [
        "Parameter",
        "Description",
        "Required"
      ],
      "Rows": [
        [
          {
            "Text": "q",
            "Links": [],
            "Values": []
          },
          {
            "Text": "The value of this parameter should always be: localeAndType.",
