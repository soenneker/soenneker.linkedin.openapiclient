        ],
        [
          {
            "Text": "includeRetired",
            "Links": [],
            "Values": []
          },
          {
            "Text": "Whether to include retired learning assets. The value of this parameter should be true or false. To retrieve active and retired learning assets, set this parameter to true.",
            "Links": [],
            "Values": []
          },
          {
            "Text": "No (default = false)",
            "Links": [],
            "Values": []
          }
        ],
        [
          {
            "Text": "start",
            "Links": [],
            "Values": []
          },
          {
            "Text": "The start index of learning assets for the page.",
            "Links": [],
            "Values": []
          },
          {
            "Text": "No (default = 0)",
            "Links": [],
            "Values": []
          }
        ],
        [
