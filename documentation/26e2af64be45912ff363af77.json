      "Kind": "text",
      "Section": "Member Data Obfuscation",
      "Anchor": "member-data-obfuscation",
      "SectionPath": [
        "Permissions",
        "Member Data Obfuscation"
      ],
      "Text": "This DMA API has member data obfuscated depending on whether member has opted into the new DMA privacy setting (opted out by default). When opted in, member data is returned. When opted out, member data is filtered out.",
      "Headers": [],
      "Rows": []
    },
