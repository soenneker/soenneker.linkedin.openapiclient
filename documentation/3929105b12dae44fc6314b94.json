        "Description"
      ],
      "Rows": [
        [
          {
            "Text": "rw_ads",
            "Links": [],
            "Values": []
          },
          {
            "Text": "Manage and read an authenticated member\u0027s Ad Accounts. To sponsor a image, the authenticated member must meet both of the following conditions: Be an ADMINISTRATOR of a Company Page or a DIRECT_SPONSORED_CONTENT_POSTER with access to Campaign Manager. Have one of the following Ad Account roles: ACCOUNT_BILLING_ADMIN,ACCOUNT_MANAGER, CAMPAIGN_MANAGER, CREATIVE_MANAGER",
            "Links": [],
            "Values": [
              "Be an ADMINISTRATOR of a Company Page or a DIRECT_SPONSORED_CONTENT_POSTER with access to Campaign Manager.",
              "Have one of the following Ad Account roles: ACCOUNT_BILLING_ADMIN,ACCOUNT_MANAGER, CAMPAIGN_MANAGER, CREATIVE_MANAGER"
            ]
          }
        ],
        [
          {
            "Text": "r_ads",
            "Links": [],
            "Values": []
          },
          {
            "Text": "Read an authenticated member\u0027s Ad Account. Restricted to Ad Accounts in which the authenticated member has one of the following Ad Account roles. ACCOUNT_BILLING_ADMINACCOUNT_MANAGERCAMPAIGN_MANAGERCREATIVE_MANAGERVIEWER",
            "Links": [],
            "Values": [
              "ACCOUNT_BILLING_ADMIN",
              "ACCOUNT_MANAGER",
              "CAMPAIGN_MANAGER",
              "CREATIVE_MANAGER",
              "VIEWER"
            ]
          }
        ]
      ]
    },
