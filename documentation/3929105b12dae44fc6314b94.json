      "Kind": "text",
      "Section": "Text Ads API",
      "Anchor": "text-ads-api",
      "SectionPath": [],
      "Text": "Create and manage Text Ads with the external Creatives API. Text ads include a headline, brief text, and an image. Place them on the right rail of various LinkedIn desktop pages.",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Requirements",
      "Anchor": "requirements",
      "SectionPath": [
        "Requirements"
      ],
      "Text": "For creation of Text ads, the following requirements must be met. See Text Ads Specifications.",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "table",
      "Section": "Permissions",
      "Anchor": "permissions",
      "SectionPath": [
