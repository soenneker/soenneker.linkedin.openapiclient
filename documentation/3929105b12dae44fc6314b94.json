    {
      "Kind": "code",
      "Section": "Create a Text Ad",
      "Anchor": "create-a-text-ad",
      "SectionPath": [
        "Create a Text Ad"
      ],
      "Text": "POST https://api.linkedin.com/rest/creatives",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "code",
      "Section": "Create a Text Ad",
      "Anchor": "create-a-text-ad",
      "SectionPath": [
        "Create a Text Ad"
      ],
      "Text": "{\n    \u0022content\u0022: {\n      \u0022textAd\u0022: {\n        \u0022landingPage\u0022: \u0022https://lnkd.in/eabXpqi\u0022,\n        \u0022headline\u0022: \u0022prod test headline\u0022,\n        \u0022description\u0022: \u0022prod test description\u0022,\n        \u0022image\u0022: \u0022urn:li:image:C4E22AQGX_uq7mQBfAA\u0022\n      }\n    },\n    \u0022campaign\u0022: \u0022urn:li:sponsoredCampaign:191989474\u0022,\n    \u0022intendedStatus\u0022: \u0022ACTIVE\u0022\n}",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "code",
      "Section": "Create a Text Ad",
      "Anchor": "create-a-text-ad",
      "SectionPath": [
        "Create a Text Ad"
      ],
      "Text": "curl --location POST -v \u0027https://api.linkedin.com/rest/creatives\u0027 \\\n-H \u0027Authorization: Bearer {INSERT_TOKEN}\u0027 \\\n-H \u0027Linkedin-Version: {version number in the format YYYYMM}\u0027 \\\n-H \u0027Content-Type: application/json\u0027 \\\n-H \u0027X-Restli-Protocol-Version: 2.0.0\u0027 \n--data \u0027{\n    \u0022content\u0022: {\n      \u0022textAd\u0022: {\n        \u0022landingPage\u0022: \u0022https://lnkd.in/eabXpqi\u0022,\n        \u0022headline\u0022: \u0022prod test headline\u0022,\n        \u0022description\u0022: \u0022prod test description\u0022,\n        \u0022image\u0022: \u0022urn:li:image:C4E22AQGX_uq7mQBfAA\u0022\n      }\n    },\n    \u0022campaign\u0022: \u0022urn:li:sponsoredCampaign:191989474\u0022,\n    \u0022intendedStatus\u0022: \u0022ACTIVE\u0022\n}\u0027",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Create a Text Ad",
      "Anchor": "create-a-text-ad",
      "SectionPath": [
        "Create a Text Ad"
      ],
      "Text": "A successful response returns a 201 Created HTTP status code and the ID in the x-restli-id response header. For example, urn:li:sponsoredCreative:164380864",
      "Headers": [],
      "Rows": []
    },
    {
