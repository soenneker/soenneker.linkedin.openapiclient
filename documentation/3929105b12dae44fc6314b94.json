      "SectionPath": [
        "Get a Text Ad"
      ],
      "Text": "GET https://api.linkedin.com/rest/creatives/{sponsoredCreativeUrn}",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "code",
      "Section": "Get a Text Ad",
      "Anchor": "get-a-text-ad",
      "SectionPath": [
        "Get a Text Ad"
      ],
      "Text": "curl --location --request GET \u0027https://api.linkedin.com/rest/creatives/{sponsoredCreativeUrn}\u0027 \\ \n-H \u0027X-Restli-Protocol-Version: 2.0.0\u0027 \\\n-H \u0027Linkedin-Version: {version number in the format YYYYMM}\u0027 \\\n-H \u0027Authorization: Bearer {INSERT_TOKEN}\u0027",
      "Headers": [],
