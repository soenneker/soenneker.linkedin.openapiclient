      "Rows": [
        [
          {
            "Text": "ADMINISTRATOR",
            "Links": [],
            "Values": []
          },
          {
            "Text": "Access to administer an organizational entity.An administrator can post updates, edit the organization\u0027s page, add other admins, view analytics, and view notifications.",
            "Links": [],
            "Values": []
          }
        ],
        [
          {
            "Text": "DIRECT_SPONSORED_CONTENT_POSTER",
            "Links": [],
            "Values": []
          },
          {
            "Text": "Access to read and create direct sponsored content (DSC) for an organizational entity.",
            "Links": [],
            "Values": []
          }
        ],
        [
          {
            "Text": "RECRUITING_POSTER",
            "Links": [],
            "Values": []
          },
          {
            "Text": "Access to post to an organizational entity.",
            "Links": [],
            "Values": []
          }
        ],
        [
          {
            "Text": "LEAD_CAPTURE_ADMINISTRATOR",
            "Links": [],
            "Values": []
          },
          {
            "Text": "Access to view and manage landing pages for the company, create new landing pages, and edit existing ones.",
            "Links": [],
            "Values": []
          }
        ],
        [
          {
            "Text": "LEAD_GEN_FORMS_MANAGER",
            "Links": [],
            "Values": []
          },
          {
            "Text": "Access to retrieve leads that belong to a specific account which is associated with a company page.",
            "Links": [],
            "Values": []
          }
        ],
        [
          {
            "Text": "ANALYST",
            "Links": [],
            "Values": []
          },
          {
            "Text": "Access to view an organization\u0027s private administrative data that relates to its social presence on LinkedIn, access limited to analytics tab to monitor the Page\u2019s performance to help drive goals. Can edit the competitors of a page.",
            "Links": [],
            "Values": []
          }
        ],
        [
          {
            "Text": "CURATOR",
            "Links": [],
            "Values": []
          },
          {
            "Text": "Access to broadcast content to employees of the organization, view Content Suggestions, create recommended content, and view and export Page analytics. Can edit the competitors of a page.",
            "Links": [],
            "Values": []
          }
        ],
        [
          {
            "Text": "CONTENT_ADMINISTRATOR",
            "Links": [],
            "Values": []
          },
          {
            "Text": "Access to create and manage Page content, including updates, pinned posts, boosting updates, events, jobs etc.",
            "Links": [],
            "Values": []
          }
        ]
      ]
