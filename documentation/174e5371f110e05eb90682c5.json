      "Kind": "text",
      "Section": "Organization Access Control",
      "Anchor": "organization-access-control",
      "SectionPath": [],
      "Text": "A role defines the privileges that a member has within the organization. You must be an authenticated member with role type ADMINISTRATOR for an organization to use many of the Organization APIs.",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Organization Access Control",
      "Anchor": "organization-access-control-1",
      "SectionPath": [
        "Organization Access Control"
      ],
      "Text": "Search for access control information by member or organizational entity URNs.",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "code",
      "Section": "Organization Access Control",
      "Anchor": "organization-access-control-1",
      "SectionPath": [
        "Organization Access Control"
      ],
      "Text": "host: api.linkedin.com\nbasePath: /v2\nscheme: https\nendpoint: /organizationAcls\nmethods: PUT, roleAssignee FINDER, organization FINDER",
      "Headers": [],
      "Rows": []
    },
