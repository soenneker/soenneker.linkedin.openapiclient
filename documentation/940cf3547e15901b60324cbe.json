      "Kind": "text",
      "Section": "Seniority",
      "Anchor": "seniority",
      "SectionPath": [],
      "Text": "The Seniority API returns the standardized job Seniority data for the Seniority ID. This API doesn\u2019t share member\npersonal data as part of the API response.",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Seniority",
      "Anchor": "seniority",
      "SectionPath": [],
      "Text": "Seniority levels categorize roles by experience level on LinkedIn. They appear in job postings and member profile positions (e.g., Entry, Senior, Manager, Director).",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Seniority",
      "Anchor": "seniority",
      "SectionPath": [],
      "Text": "Note",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Seniority",
      "Anchor": "seniority",
      "SectionPath": [],
      "Text": "This API may also be referred to as \u0022Experience Level\u0022 or \u0022Job Seniority\u0022 in other contexts.",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Seniority",
      "Anchor": "seniority",
      "SectionPath": [],
      "Text": "The service currently provides the following methods:",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Seniority",
      "Anchor": "seniority",
      "SectionPath": [],
      "Text": "Get seniority data for a specific Seniority ID.\nGet all seniorities data.",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "How to Retrieve Seniority IDs",
      "Anchor": "how-to-retrieve-seniority-ids",
      "SectionPath": [
        "How to Retrieve Seniority IDs"
      ],
      "Text": "Use GET_ALL with pagination to list all seniority levels. Seniority IDs also appear in responses from other DMA APIs such as Organizational Page Edge Analytics (demographic breakdowns by seniority).",
      "Headers": [],
      "Rows": []
    },
