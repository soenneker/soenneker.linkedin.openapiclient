        {
          "id": "3c79dac2-fbdb-4b7c-9175-a2e14a738835",
          "name": "Fetch the Authenticated User\u0027s Ad Accounts",
          "protocolProfileBehavior": {
            "disableBodyPruning": true
          },
          "request": {
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "X-Restli-Protocol-Version",
                "type": "text",
                "value": "2.0.0"
              },
              {
                "key": "LinkedIn-Version",
                "type": "text",
                "value": "{{insert_version}}"
              },
              {
                "disabled": true,
                "key": "Authorization",
                "type": "text",
                "value": "{{insert_token}}"
              }
            ],
            "method": "GET",
            "url": {
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "adAccountUsers"
              ],
              "query": [
                {
                  "key": "q",
                  "value": "authenticatedUser"
                }
              ],
              "raw": "{{baseUrl}}/adAccountUsers?q=authenticatedUser"
            }
          },
          "response": []
        },
        {
          "id": "aff29305-4ffd-4a85-b058-9fe2acd99318",
