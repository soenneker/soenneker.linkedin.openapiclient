      "Kind": "text",
      "Section": "Profile Edit API - Publications",
      "Anchor": "profile-edit-api---publications",
      "SectionPath": [],
      "Text": "This sub-resource API will allow you to create, update, and delete publications of a member.\u00A0See Publication Fields for a description of the fields available within this object.",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Supported Methods",
      "Anchor": "supported-methods",
      "SectionPath": [
        "Supported Methods"
      ],
      "Text": "CREATE | PARTIAL_UPDATE | DELETE",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "code",
      "Section": "CREATE",
      "Anchor": "create",
      "SectionPath": [
        "CREATE"
      ],
      "Text": "POST https://api.linkedin.com/v2/people/(\\$params),id:{person ID})/publications",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "code",
      "Section": "sample request body",
      "Anchor": "sample-request-body",
      "SectionPath": [
        "CREATE",
        "sample request body"
      ],
      "Text": "{\n  \u0022date\u0022: {\n    \u0022month\u0022: 2,\n    \u0022year\u0022: 2016,\n    \u0022day\u0022: 2\n  },\n  \u0022name\u0022: {\n    \u0022localized\u0022: {\n      \u0022en_US\u0022: \u0022LinkedIn API Publication\u0022\n    },\n    \u0022preferredLocale\u0022: {\n      \u0022country\u0022: \u0022US\u0022,\n      \u0022language\u0022: \u0022en\u0022\n    }\n  },\n  \u0022description\u0022: {\n    \u0022localized\u0022: {\n      \u0022en_US\u0022: {\n        \u0022rawText\u0022: \u0022API!\u0022\n      }\n    },\n    \u0022preferredLocale\u0022: {\n      \u0022country\u0022: \u0022US\u0022,\n      \u0022language\u0022: \u0022en\u0022\n    }\n  },\n  \u0022publisher\u0022: {\n    \u0022localized\u0022: {\n      \u0022en_US\u0022: \u0022LinkedIn\u0022\n    },\n    \u0022preferredLocale\u0022: {\n      \u0022country\u0022: \u0022US\u0022,\n      \u0022language\u0022: \u0022en\u0022\n    }\n  },\n  \u0022url\u0022: \u0022http://www.developer.linkedin.com\u0022,\n  \u0022authors\u0022: [\n    {\n      \u0022memberId\u0022: \u0022urn:li:person:123ABC\u0022\n    }\n  ]\n}\n}",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "sample request body",
      "Anchor": "sample-request-body",
      "SectionPath": [
        "CREATE",
        "sample request body"
      ],
      "Text": "Note",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "sample request body",
      "Anchor": "sample-request-body",
      "SectionPath": [
        "CREATE",
        "sample request body"
      ],
      "Text": "A successful response will return a 201 Created HTTP status code. To record the created entity\u0027s id, refer to the header x-linkedin-id field.",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "code",
      "Section": "PARTIAL UPDATE",
      "Anchor": "partial-update",
      "SectionPath": [
        "PARTIAL UPDATE"
      ],
      "Text": "POST https://api.linkedin.com/v2/people/(\\$params),id:{person ID})/publications/{publication ID}",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "code",
      "Section": "sample request body",
      "Anchor": "sample-request-body-1",
      "SectionPath": [
        "PARTIAL UPDATE",
        "sample request body"
      ],
      "Text": "{\n    \u0022patch\u0022: {\n        \u0022$set\u0022: {\n            \u0022date\u0022: {\n                \u0022day\u0022: 15,\n                \u0022month\u0022: 5,\n                \u0022year\u0022: 2016\n            },\n            \u0022description\u0022: {\n                \u0022localized\u0022: {\n                    \u0022en_US\u0022: {\n                        \u0022rawText\u0022: \u0022New LinkedIn Developer API!\u0022\n                    }\n                },\n                \u0022preferredLocale\u0022: {\n                    \u0022country\u0022: \u0022US\u0022,\n                    \u0022language\u0022: \u0022en\u0022\n                }\n            }\n        }\n    }\n}",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "sample request body",
      "Anchor": "sample-request-body-1",
      "SectionPath": [
