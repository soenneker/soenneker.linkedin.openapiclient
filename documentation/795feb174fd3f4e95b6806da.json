        "sample request body"
      ],
      "Text": "{\n    \u0022patch\u0022: {\n        \u0022$delete\u0022: [\n            \u0022field1\u0022,\n            \u0022field2\u0022\n        ]\n    }\n}",
      "Headers": [],
      "Rows": []
    },
