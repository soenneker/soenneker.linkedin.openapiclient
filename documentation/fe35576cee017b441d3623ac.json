    {
      "Kind": "text",
      "Section": "How to Obtain URNs",
      "Anchor": "how-to-obtain-urns",
      "SectionPath": [
        "How to Obtain URNs"
      ],
      "Text": "The Social Metadata API requires specific URNs to identify entities such as activities, comments, shares, and posts. For detailed instructions on how to obtain the necessary URNs, refer to the following documentation:",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "How to Obtain URNs",
      "Anchor": "how-to-obtain-urns",
      "SectionPath": [
        "How to Obtain URNs"
      ],
      "Text": "urn:li:activity - See Activities for instructions on obtaining Activity URNs\nurn:li:comment - See Comments for instructions on obtaining Comment URNs\nurn:li:share and urn:li:ugcPost - See Posts for instructions on obtaining Share and UGC Post URNs",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Retrieve Social Metadata for specific feed content",
      "Anchor": "retrieve-social-metadata-for-specific-feed-content",
      "SectionPath": [
        "Retrieve Social Metadata for specific feed content"
      ],
      "Text": "Retrieves a list of post URNs (urn:li:share, urn:li:ugcPost, urn:li:groupPost) authored by the specified organization.",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "BATCH_GET a Collection of Social Metadata of specific feed content",
      "Anchor": "batch_get-a-collection-of-social-metadata-of-specific-feed-content",
      "SectionPath": [
        "Retrieve Social Metadata for specific feed content",
        "BATCH_GET a Collection of Social Metadata of specific feed content"
      ],
      "Text": "The BATCH_GET method retrieves social metadata (reactions, comments, and their counts) for a collection of feed content entities. You can request metadata for multiple URNs in a single API call, making it efficient to retrieve engagement data for posts, comments, and activities.",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Sample Request",
      "Anchor": "sample-request",
      "SectionPath": [
        "Retrieve Social Metadata for specific feed content",
        "BATCH_GET a Collection of Social Metadata of specific feed content",
        "Sample Request"
      ],
      "Text": "http\n\n\ncurl",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "code",
      "Section": "Sample Request",
      "Anchor": "sample-request",
      "SectionPath": [
        "Retrieve Social Metadata for specific feed content",
        "BATCH_GET a Collection of Social Metadata of specific feed content",
        "Sample Request"
      ],
      "Text": "GET https://api.linkedin.com/rest/dmaSocialMetadata?ids=List(urn%3Ali%3Aactivity%3A{ACTIVITY_ID},urn%3Ali%3Acomment%3A%28activity%3A{ACTIVITY_ID}%2C{COMMENT_ID}%29)",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "code",
      "Section": "Sample Request",
      "Anchor": "sample-request",
      "SectionPath": [
        "Retrieve Social Metadata for specific feed content",
        "BATCH_GET a Collection of Social Metadata of specific feed content",
        "Sample Request"
      ],
      "Text": "curl -X GET \u0027https://api.linkedin.com/rest/dmaSocialMetadata?ids=List(urn%3Ali%3Aactivity%3A{ACTIVITY_ID},urn%3Ali%3Acomment%3A%28activity%3A{ACTIVITY_ID}%2C{COMMENT_ID}%29)\u0027 \\\n--header \u0027X-Restli-Protocol-Version: 2.0.0\u0027 \\\n--header \u0027Linkedin-Version: {version number in the format YYYYMM}\u0027 \\\n--header \u0027Authorization: Bearer {INSERT_TOKEN}\u0027",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "code",
      "Section": "Sample Response",
      "Anchor": "sample-response",
      "SectionPath": [
        "Retrieve Social Metadata for specific feed content",
        "BATCH_GET a Collection of Social Metadata of specific feed content",
        "Sample Response"
      ],
      "Text": "{\n    \u0022statuses\u0022: {},\n    \u0022results\u0022: {\n        \u0022urn:li:activity:{ACTIVITY_ID}\u0022: {\n            \u0022reactionSummaries\u0022: {\n                \u0022PRAISE\u0022: {\n                    \u0022reactionType\u0022: \u0022PRAISE\u0022,\n                    \u0022count\u0022: 1\n                },\n                \u0022APPRECIATION\u0022: {\n                    \u0022reactionType\u0022: \u0022APPRECIATION\u0022,\n                    \u0022count\u0022: 1\n                }\n            },\n            \u0022commentsState\u0022: \u0022OPEN\u0022,\n            \u0022commentSummary\u0022: {\n                \u0022count\u0022: 2,\n                \u0022topLevelCount\u0022: 2\n            },\n            \u0022entity\u0022: \u0022urn:li:activity:{ACTIVITY_ID}\u0022\n        },\n        \u0022urn:li:comment:(activity:{ACTIVITY_ID},{COMMENT_ID})\u0022: {\n            \u0022reactionSummaries\u0022: {\n                \u0022EMPATHY\u0022: {\n                    \u0022reactionType\u0022: \u0022EMPATHY\u0022,\n                    \u0022count\u0022: 1\n                }\n            },\n            \u0022commentsState\u0022: \u0022OPEN\u0022,\n            \u0022commentSummary\u0022: {\n                \u0022count\u0022: 0,\n                \u0022topLevelCount\u0022: 0\n            },\n            \u0022entity\u0022: \u0022urn:li:comment:(activity:{ACTIVITY_ID},{COMMENT_ID})\u0022\n        }\n    },\n    \u0022errors\u0022: {}\n}",
      "Headers": [],
      "Rows": []
    },
