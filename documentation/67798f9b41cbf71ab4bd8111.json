      "Kind": "text",
      "Section": "New Version Header",
      "Anchor": "new-version-header",
      "SectionPath": [
        "New Version Header"
      ],
      "Text": "All requests to versioned APIs will require a new LinkedIn-Version header, populated with a version identifier.",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "code",
