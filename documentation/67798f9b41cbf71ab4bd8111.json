    {
      "Kind": "text",
      "Section": "Recommendations for Migration",
      "Anchor": "recommendations-for-migration",
      "SectionPath": [
        "Recommendations for Migration"
      ],
      "Text": "In order to facilitate easy migration, you should make the base URL and version header configurable modifications to your solution. When new API versions are released, modifying configurations should take minimal time to facilitate adoption of the latest APIs.",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Notification to Partners",
      "Anchor": "notification-to-partners",
      "SectionPath": [
        "Notification to Partners"
      ],
      "Text": "When new API versions are released, LinkedIn will notify partners through standard communications channels and in our documentation release notes.",
