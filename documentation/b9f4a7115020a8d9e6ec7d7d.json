      "Kind": "text",
      "Section": "Organic Posts",
      "Anchor": "organic-posts",
      "SectionPath": [],
      "Text": "The Posts API offers an easy method for creating organic posts. For posts that include images or videos, you\u0027ll need to upload the media asset first to retrieve an Image or Video URN, which is then used to create the UGC post. Refer to the Images and Videos API for detailed instructions on uploading media files.",
      "Headers": [],
      "Rows": []
    },
