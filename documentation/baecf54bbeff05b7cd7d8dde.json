      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Get Accurate Preview",
      "Anchor": "get-accurate-preview",
      "SectionPath": [
        "Accurate Preview",
        "Get Accurate Preview"
      ],
      "Text": "iFrames returned by the API are valid upto 3 hours. When the iFrame expires, partners can fetch another iFrame by calling /adPreviews API.",
      "Headers": [],
      "Rows": []
    },
