      "Section": "Get Accurate Preview",
      "Anchor": "get-accurate-preview",
      "SectionPath": [
        "Accurate Preview",
        "Get Accurate Preview"
      ],
      "Text": "Get an accurate preview of the creative by calling the /adPreviews GET API. Partners can embed the iFrame tag returned in the response on their websites and render the preview for both Desktop and Mobile placements.",
      "Headers": [],
      "Rows": []
    },
