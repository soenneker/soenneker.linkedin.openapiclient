      "Kind": "text",
      "Section": "Retry Logic",
      "Anchor": "retry-logic",
      "SectionPath": [
        "Receiving Push Notifications",
        "Retry Logic"
      ],
      "Text": "If a push notification request sent to the registered callback URL receives an unsuccessful response (\u201C200 OK\u201D), then LinkedIn will retry sending the request.",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "table",
      "Section": "Retry Logic",
      "Anchor": "retry-logic",
