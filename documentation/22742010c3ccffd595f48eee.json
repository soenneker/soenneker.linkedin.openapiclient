        "Retry Frequency",
        "Delay Between Retry Requests"
      ],
      "Rows": [
        [
          {
            "Text": "Maximum of five retry attempts",
            "Links": [],
            "Values": []
          },
          {
            "Text": "300 seconds between retry attempts",
            "Links": [],
            "Values": []
          }
        ]
      ]
    },
    {
      "Kind": "text",
      "Section": "Retry Logic",
      "Anchor": "retry-logic",
      "SectionPath": [
        "Receiving Push Notifications",
        "Retry Logic"
      ],
      "Text": "After the maximum number of retry attempts have been sent, the notification will be dropped. Each retry from LinkedIn will have a unique ID value. Developers should be validating data received when using the ID to make subsequent API calls to handle deduplication of updates that may result from retry attempts.",
      "Headers": [],
      "Rows": []
