      "Section": "3-Legged OAuth (Authorization Code Flow)",
      "Anchor": "3-legged-oauth-authorization-code-flow",
      "SectionPath": [
        "3-Legged OAuth (Authorization Code Flow)"
      ],
      "Text": "Used for /identityMe and /verificationReport APIs. Requires member consent and authorization.",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Quick Overview",
      "Anchor": "quick-overview",
      "SectionPath": [
        "3-Legged OAuth (Authorization Code Flow)",
        "Quick Overview"
      ],
      "Text": "Redirect member to LinkedIn for authorization\nMember grants permission to your app\nLinkedIn redirects back with authorization code\nExchange code for access token\nCall APIs with the access token",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
