    {
      "Kind": "text",
      "Section": "Quick Overview",
      "Anchor": "quick-overview",
      "SectionPath": [
        "3-Legged OAuth (Authorization Code Flow)",
        "Quick Overview"
      ],
      "Text": "Partners may optionally include an OAuth 2.0 state parameter in their redirect URI to maintain session context, implement CSRF protection, or track requests. When used with Verified on LinkedIn verification flows, the state parameter is preserved and returned to the partner\u0027s registered redirect URI after verification completes.",
      "Headers": [],
      "Rows": []
