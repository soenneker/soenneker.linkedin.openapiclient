      "Section": "Sample Request",
      "Anchor": "sample-request-5",
      "SectionPath": [
        "Delete DMP Segment",
        "Sample Request"
      ],
      "Text": "DELETE https://api.linkedin.com/rest/dmpSegments/10000",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "code",
      "Section": "Sample Request",
      "Anchor": "sample-request-5",
      "SectionPath": [
        "Delete DMP Segment",
        "Sample Request"
      ],
      "Text": "curl -X DELETE \u0027https://api.linkedin.com/rest/dmpSegments/10000\u0027 \\\n-H \u0027Authorization: Bearer {INSERT_TOKEN}\u0027 \\\n-H \u0027Linkedin-Version: {version number in the format YYYYMM}\u0027 \\\n-H \u0027X-Restli-Protocol-Version: 2.0.0\u0027",
      "Headers": [],
      "Rows": []
    },
