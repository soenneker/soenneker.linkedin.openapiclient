      "Anchor": "sample-request-6",
      "SectionPath": [
        "Batch Delete DMP Segments",
        "Sample Request"
      ],
      "Text": "http\n\n\ncurl",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "code",
      "Section": "Sample Request",
      "Anchor": "sample-request-6",
      "SectionPath": [
        "Batch Delete DMP Segments",
        "Sample Request"
      ],
      "Text": "DELETE https://api.linkedin.com/rest/dmpSegments?ids=List(10001,10002)",
      "Headers": [],
      "Rows": []
    },
