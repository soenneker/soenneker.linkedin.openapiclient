    {
      "Kind": "text",
      "Section": "Find DMP Segments by Account",
      "Anchor": "find-dmp-segments-by-account",
      "SectionPath": [
        "Find DMP Segments by Account"
      ],
      "Text": "Use the q=account parameter and the account URN to find DMP segments by the associated sponsored account. For more granular results, add sourcePlatform and sourceSegmentId query parameters to the query.",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Sample Request",
      "Anchor": "sample-request-4",
      "SectionPath": [
        "Find DMP Segments by Account",
        "Sample Request"
      ],
      "Text": "http\n\n\ncurl",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "code",
      "Section": "Sample Request",
      "Anchor": "sample-request-4",
      "SectionPath": [
        "Find DMP Segments by Account",
        "Sample Request"
      ],
      "Text": "GET https://api.linkedin.com/rest/dmpSegments?q=account\u0026account=urn:li:sponsoredAccount:516848833",
      "Headers": [],
      "Rows": []
    },
