    {
      "Kind": "text",
      "Section": "Schema",
      "Anchor": "schema",
      "SectionPath": [
        "Create DMP Segment",
        "Schema"
      ],
      "Text": "A sponsored account can have a maximum of 1,000 DMP segments. Attempting to create a segment beyond this limit returns a 429 error with code SEGMENT_LIMIT_EXCEEDED. Delete unused segments to free up capacity before creating new ones.",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Sample Request",
      "Anchor": "sample-request",
      "SectionPath": [
        "Create DMP Segment",
        "Sample Request"
      ],
      "Text": "http\n\n\ncurl",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "code",
      "Section": "Sample Request",
      "Anchor": "sample-request",
      "SectionPath": [
        "Create DMP Segment",
        "Sample Request"
      ],
      "Text": "POST https://api.linkedin.com/rest/dmpSegments",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "code",
      "Section": "Sample Request",
      "Anchor": "sample-request",
      "SectionPath": [
        "Create DMP Segment",
        "Sample Request"
      ],
      "Text": "{\n   \u0022name\u0022:\u0022DMP Segment 1\u0022,\n   \u0022sourcePlatform\u0022:\u0022PARTNER_API\u0022,\n   \u0022account\u0022:\u0022urn:li:sponsoredAccount:516848833\u0022,\n   \u0022type\u0022:\u0022USER\u0022,\n   \u0022destinations\u0022:[\n      {\n         \u0022destination\u0022:\u0022LINKEDIN\u0022\n      }\n   ]\n}",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "code",
      "Section": "Sample Request",
      "Anchor": "sample-request",
      "SectionPath": [
        "Create DMP Segment",
        "Sample Request"
      ],
      "Text": "curl -X POST \u0027https://api.linkedin.com/rest/dmpSegments\u0027 \\\n-H \u0027Authorization: Bearer {INSERT_TOKEN}\u0027 \\\n-H \u0027Content-Type: application/json\u0027 \\\n-H \u0027Linkedin-Version: {version number in the format YYYYMM}\u0027 \\\n-H \u0027X-Restli-Protocol-Version: 2.0.0\u0027 \\\n--data \u0027{\n   \u0022name\u0022:\u0022DMP Segment 1\u0022,\n   \u0022sourcePlatform\u0022:\u0022PARTNER_API\u0022,\n   \u0022account\u0022:\u0022urn:li:sponsoredAccount:516848833\u0022,\n   \u0022type\u0022:\u0022USER\u0022,\n   \u0022destinations\u0022:[\n      {\n         \u0022destination\u0022:\u0022LINKEDIN\u0022\n      }\n   ]\n}\u0027",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Sample Request",
      "Anchor": "sample-request",
      "SectionPath": [
        "Create DMP Segment",
        "Sample Request"
      ],
      "Text": "A successful response returns a 201 Created HTTP status code and the segment ID in the x-restli-id response header.",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Sample Request",
      "Anchor": "sample-request",
      "SectionPath": [
        "Create DMP Segment",
        "Sample Request"
      ],
      "Text": "If the sponsored account has reached the 1,000 segment limit, the API returns a 429 error response:",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "code",
      "Section": "Sample Request",
      "Anchor": "sample-request",
      "SectionPath": [
        "Create DMP Segment",
        "Sample Request"
      ],
      "Text": "{\n  \u0022code\u0022: \u0022SEGMENT_LIMIT_EXCEEDED\u0022,\n  \u0022errorDetailType\u0022: \u0022com.linkedin.common.error.BadRequest\u0022,\n  \u0022message\u0022: \u0022Account has reached the maximum limit of 1000 segments. Please delete unused segments before creating new ones.\u0022,\n  \u0022errorDetails\u0022: {\n    \u0022inputErrors\u0022: [\n      {\n        \u0022description\u0022: \u0022Account has reached the maximum limit of 1000 segments. Please delete unused segments before creating new ones.\u0022,\n        \u0022input\u0022: {\n          \u0022value\u0022: {\n            \u0022stringValue\u0022: \u0022urn:li:sponsoredAccount:{accountId}\u0022\n          },\n          \u0022inputPath\u0022: {\n            \u0022fieldPath\u0022: \u0022/DMPSegment/account\u0022\n          }\n        },\n        \u0022code\u0022: \u0022SEGMENT_LIMIT_EXCEEDED\u0022,\n        \u0022maxValue\u0022: 1000\n      }\n    ]\n  },\n  \u0022status\u0022: 429\n}",
      "Headers": [],
      "Rows": []
    },
