    {
      "Kind": "text",
      "Section": "DMP Segments",
      "Anchor": "dmp-segments",
      "SectionPath": [],
      "Text": "DMP Segments act as staging entities, which can take in user information from a third-party provider, map them to LinkedIn member profiles, and output Ad Segments, which can then be used with other LinkedIn ads APIs. A DMP segment is tied to a sponsored account.",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "DMP Segments",
      "Anchor": "dmp-segments",
      "SectionPath": [],
      "Text": "All API requests are represented in protocol 2.0.0 and require the header:",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "code",
      "Section": "DMP Segments",
      "Anchor": "dmp-segments",
      "SectionPath": [],
      "Text": "X-Restli-Protocol-Version: 2.0.0",
      "Headers": [],
      "Rows": []
    },
