              "MAX_CLICK",
              "MAX_CONVERSION",
              "MAX_IMPRESSION",
              "ENHANCED_CONVERSION"
            ]
          }
        ],
        [
          {
            "Text": "WEBSITE_VISIT",
            "Links": [],
            "Values": []
          },
          {
            "Text": "This objective aims to get more people to visit a web site destination with the business goal of brand consideration. This objective allows for Standard Sponsored Content, Image, and Video Carousel Sponsored Content, Video Sponsored Content, Text Ads, Spotlight Dynamic Ads, and Sponsored InMail type campaign formats.",
            "Links": [],
            "Values": []
          },
          {
            "Text": "NONEMAX_CLICKENHANCED_CONVERSIONTARGET_COST_PER_CLICKCAP_COST_AND_MAXIMIZE_CLICKS",
