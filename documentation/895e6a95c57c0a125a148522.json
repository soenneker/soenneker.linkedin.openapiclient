              "MAX_CLICK",
              "ENHANCED_CONVERSION",
              "TARGET_COST_PER_CLICK"
            ]
          }
        ],
        [
          {
            "Text": "ENGAGEMENT",
            "Links": [],
            "Values": []
          },
          {
            "Text": "Engage on sponsored content posts through campaign type formats including Standard, Carousel, and Video. The ad unit includes a Follow button so you can attract and obtain more LinkedIn page followers.",
            "Links": [],
            "Values": []
          },
          {
            "Text": "NONEENHANCED_CONVERSIONMAX_CLICKTARGET_COST_PER_CLICKCAP_COST_AND_MAXIMIZE_CLICKS",
            "Links": [],
            "Values": [
