              "TARGET_COST_PER_CLICK",
              "CAP_COST_AND_MAXIMIZE_CLICKS"
            ]
          }
        ],
        [
          {
            "Text": "JOB_APPLICANT",
            "Links": [],
            "Values": []
          },
          {
            "Text": "Gain more job applicants on LinkedIn through Job Dynamic Ads, Spotlight Dynamic Ads, and Standard Sponsored Content type campaign formats.",
