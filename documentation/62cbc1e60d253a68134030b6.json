      "SectionPath": [
        "Feature Overview",
        "Schemas",
        "OrganizationalPageVisitorOfTheDay"
      ],
      "Text": "How to determine which organizational pages you can query:\nTo find the organizational pages you can query {{resource, plural}} for, please use OrganizationAuthorization\u2019s BATCH_FIND by AuthorizationAction and AuthenticatedMember\nwith an authorization action of OrganizationAnalyticsAuthorizationActionType.VISITOR_ANALYTICS_READ. For any organization returned, convert it to an organizationalPage using the OrganizationalPage pageEntity finder",
      "Headers": [],
      "Rows": []
    },
    {
