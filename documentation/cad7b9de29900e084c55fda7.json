      "Kind": "text",
      "Section": "OrganizationalPage Content Ingestion Sources",
      "Anchor": "organizationalpage-content-ingestion-sources",
      "SectionPath": [
        "OrganizationalPage Content Ingestion Sources"
      ],
      "Text": "How to determine which organizational pages you can query:\nTo find the organizational pages you can query {{resource, plural}} for, please use OrganizationAuthorization\u2019s BATCH_FIND by AuthorizationAction and AuthenticatedMember\nwith an authorization action of OrganizationContentAuthorizationActionType.ORGANIC_SHARE_CREATE. For any organization returned, convert it to an organizationalPage using the OrganizationalPage pageEntity finder",
      "Headers": [],
      "Rows": []
    },
    {
