      "Anchor": "sample-request",
      "SectionPath": [
        "OrganizationalPage Content Ingestion Sources",
        "FIND_BY_PAGE",
        "Sample Request"
      ],
      "Text": "http\n\n\ncurl",
      "Headers": [],
      "Rows": []
    },
