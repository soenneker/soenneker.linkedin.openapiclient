      "Kind": "text",
      "Section": "crmDataValidationExportJobs",
      "Anchor": "crmdatavalidationexportjobs",
      "SectionPath": [],
      "Text": "This resource handles Sales Navigator Application Platform CRM Sync data validation export jobs. The resource defines actions for CRM Sync data validation export, and provides methods to get the latest status of an export job. The CRM Sync data validation export will help partners understand if the CRM records are expired in comparison to their LinkedIn profiles.",
      "Headers": [],
      "Rows": []
    },
