      "Text": "curl -L -X POST \u0027https://api.linkedin.com/rest/jobRequisitionStages\u0027 \\\n-H \u0027X-HTTP-Method-Override: PUT\u0027 \\\n-H \u0027Content-Type: multipart/mixed; boundary=xyz\u0027 \\\n-H \u0027x-restli-method: batch_update\u0027 \\\n-H \u0027LinkedIn-Version: 202504\u0027 \\\n-H \u0027Authorization: Bearer {token}\u0027 \\\n--data \u0027--xyz\\r\\n\nContent-Type: application/x-www-form-urlencoded\\r\\n\\r\\nids[0].jobRequisitionStageId=stage_12345\u0026ids[0].jobRequisitionId=req_67890\u0026ids[0].integrationContext=urn:li:organization:1234567890\\r\\n--xyz\\r\\n \nContent-Type: application/json\\r\\n\\r\\n\n{\n  \u0022entities\u0022: {\n    \u0022jobRequisitionStageId=stage_12345\u0026jobRequisitionId=req_67890\u0026integrationContext=urn:li:organization:1234567890\u0022: {\n      \u0022stageName\u0022: \u0022Technical Interview\u0022,\n      \u0022stageType\u0022: \u0022INTERVIEW\u0022,\n      \u0022stageStatus\u0022:\u0022ACTIVE\u0022,\n      \u0022stageOrder\u0022: 2,\n      \u0022externalCreatedAt\u0022: 1670935153000,\n      \u0022externalLastModifiedAt\u0022: 1670935160000\n    },\n    \u0022jobRequisitionStageId=stage_67890\u0026jobRequisitionId=req_67890\u0026integrationContext=urn:li:organization:1234567890\u0022: {\n      \u0022stageName\u0022: \u0022Contact Candidate\u0022,\n      \u0022stageType\u0022: \u0022CONTACTED\u0022,\n      \u0022stageStatus\u0022:\u0022ACTIVE\u0022,\n      \u0022stageOrder\u0022: 3,\n      \u0022externalCreatedAt\u0022: 1670935200000,\n      \u0022externalLastModifiedAt\u0022: 1670935260000\n    }\n  }\n}\\r\\n--xyz--\u0027",
      "Headers": [],
      "Rows": []
    },
