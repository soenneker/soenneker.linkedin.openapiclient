        {
          "id": "a3bc7cea-b6c0-4d43-8f43-460982540c7f",
          "name": "Find Events by Organizer",
          "protocolProfileBehavior": {
            "disableBodyPruning": true
          },
          "request": {
            "auth": {
              "bearer": {},
              "type": "bearer"
            },
            "header": [
              {
                "key": "X-Restli-Protocol-Version",
                "value": "2.0.0"
              },
              {
                "key": "Linkedin-Version",
                "value": "{{insert_version}}"
              }
            ],
            "method": "GET",
            "url": {
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "events"
              ],
              "query": [
                {
                  "key": "q",
                  "value": "eventsByOrganizer"
                },
                {
                  "key": "organizer",
                  "value": "urn%3Ali%3Aorganization%3A7185861"
                },
                {
                  "key": "start",
                  "value": "0"
                },
                {
                  "key": "count",
                  "value": "10"
                },
                {
                  "key": "excludeCancelled",
                  "value": "true"
                },
                {
                  "key": "timeBasedFilter",
                  "value": "(lifeCycleState%3APAST)"
                },
                {
                  "key": "entryCriteria",
                  "value": "PUBLIC"
                },
                {
                  "key": "sortOrder",
                  "value": "END_TIME_DESC\n"
                }
              ],
              "raw": "{{baseUrl}}/events?q=eventsByOrganizer\u0026organizer=urn%3Ali%3Aorganization%3A7185861\u0026start=0\u0026count=10\u0026excludeCancelled=true\u0026timeBasedFilter=(lifeCycleState%3APAST)\u0026entryCriteria=PUBLIC\u0026sortOrder=END_TIME_DESC\n"
            }
          },
          "response": []
        },
