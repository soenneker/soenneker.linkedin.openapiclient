      "SectionPath": [
        "Find Ad Account Users by Accounts"
      ],
      "Text": "The inverse of the previous endpoint is to fetch all users associated with a specific ad account. This endpoint requires the q=accounts parameter and supports searching users by only a single ad account. It only returns matching results of the first account ID in the accounts query parameter even if there are multiple account IDs in the accounts query parameter.",
      "Headers": [],
      "Rows": []
    },
