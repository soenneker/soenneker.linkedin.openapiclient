    {
      "Kind": "code",
      "Section": "Sample Headers",
      "Anchor": "sample-headers",
      "SectionPath": [
        "DeveloperWebhooks Finder",
        "Sample Headers"
      ],
      "Text": "Authorization: Bearer {access_token}\nX-RestLi-Protocol-Version: 2.0.0",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "code",
      "Section": "Sample Request",
      "Anchor": "sample-request",
      "SectionPath": [
        "DeveloperWebhooks Finder",
        "Sample Request"
      ],
      "Text": "GET https://api.linkedin.com/v2/developerWebhooks?q=parentApplication\u0026queryCriteria=(webhookStatus:BLOCKED)",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "code",
      "Section": "Sample Response",
      "Anchor": "sample-response",
      "SectionPath": [
        "DeveloperWebhooks Finder",
        "Sample Response"
      ],
      "Text": "{\n    \u0022paging\u0022: {\n        \u0022start\u0022: 0,\n        \u0022count\u0022: 10,\n        \u0022links\u0022: []\n    },\n    \u0022elements\u0022: [\n        {\n            \u0022developerApplication\u0022: \u0022urn:li:developerApplication:12345678\u0022,\n            \u0022url\u0022: \u0022{webhook_url}\u0022,\n            \u0022status\u0022: \u0022BLOCKED\u0022\n        }\n    ]\n}",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Revalidate Blocked Webhooks",
      "Anchor": "revalidate-blocked-webhooks",
      "SectionPath": [
        "Revalidate Blocked Webhooks"
      ],
      "Text": "Once you\u0027ve identified the developerApplication and url with a status of BLOCKED, process all urls using the revalidateWebhook ACTION. This will trigger the webhook validation process and send a challengeRequest to the registered webhook url.",
      "Headers": [],
      "Rows": []
    },
