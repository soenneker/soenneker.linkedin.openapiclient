    {
      "Kind": "text",
      "Section": "Developer Webhooks",
      "Anchor": "developer-webhooks",
      "SectionPath": [],
      "Text": "To better support partners who provision applications and register webhooks on behalf of their customers, we\u0027ve introduced a new email notification and API for partners to verify and resolve webhook url issues.",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Permissions",
      "Anchor": "permissions",
      "SectionPath": [
        "Permissions"
      ],
      "Text": "Partners with Apply Connect and Job Posting integrations have the following permissions to manage webhook statuses for provisioned applications:",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Permissions",
      "Anchor": "permissions",
      "SectionPath": [
        "Permissions"
      ],
      "Text": "Access for parent applications to retrieve all webhooks and statuses for child apps.\nAccess for parent applications to revalidate webhooks in batches.\nReceive job status updates via webhooks.\nReceive job resync requests via webhooks.",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Requirements",
      "Anchor": "requirements",
      "SectionPath": [
        "Requirements"
      ],
      "Text": "If you are notified of child application webhook urls being blocked:",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Requirements",
      "Anchor": "requirements",
      "SectionPath": [
        "Requirements"
      ],
      "Text": "Use the DeveloperWebhooks API Finder to validate what webhook urls are in a blocked state.\nResolve any application issues to allow push events to be delivered and validated successfully.\nRevalidate any blocked webhook urls using the DeveloperWebhooks API.",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "DeveloperWebhooks Finder",
      "Anchor": "developerwebhooks-finder",
      "SectionPath": [
        "DeveloperWebhooks Finder"
      ],
      "Text": "If you received an email notification that child application webhooks have been blocked, use the DeveloperWebhooks Finder to query for all urls and associated applications with a status of BLOCKED.",
      "Headers": [],
      "Rows": []
    },
