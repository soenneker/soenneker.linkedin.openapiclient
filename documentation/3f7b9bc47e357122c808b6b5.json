    {
      "Kind": "text",
      "Section": "Query parameters",
      "Anchor": "query-parameters",
      "SectionPath": [
        "Query parameters"
      ],
      "Text": "Even though \u0027owners\u0027 is not a required field, it should always be provided to avoid costly search operations at the LinkedIn backend.\nPlease make use of as much filtering criteria as possible.\nFor createdDateStart and createdDateEnd, if not specified we will search from all timespan.\nThe limit for hosted query search is 20000, if the query is trying to access the result more than 20000, api response will return an error with status code 500.",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "code",
      "Section": "Sample Request",
      "Anchor": "sample-request",
      "SectionPath": [
        "Sample Request"
      ],
      "Text": "curl --location \u0027https://api.linkedin.com/v2/mailStubs?q=contract\u0026start=0\u0026count=5\u0026contract=urn%3Ali%3Acontract%3A{contract_id}\u0026owners=urn%3Ali%3Aseat%3A{seat_id}\u0027 \\\n--header \u0027Authorization: Bearer \u003CToken\u003E\u0027",
