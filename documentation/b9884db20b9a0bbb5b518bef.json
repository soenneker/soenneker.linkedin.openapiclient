    {
      "Kind": "text",
      "Section": "Batch Get a Collection of InstantReposts",
      "Anchor": "batch-get-a-collection-of-instantreposts",
      "SectionPath": [
        "Batch Get a Collection of InstantReposts"
      ],
      "Text": "Retrieves a list of urn:li:instantRepost values representing instant reposts on a specific post (urn:li:share, urn:li:ugcPost, or urn:li:groupPost).",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Batch Get a Collection of InstantReposts",
      "Anchor": "batch-get-a-collection-of-instantreposts",
      "SectionPath": [
        "Batch Get a Collection of InstantReposts"
      ],
      "Text": "Note: Provide instantRepost URNs as a comma-separated list in the format List(encoded_instantRepost_URN_1,encoded_instantRepost_URN_2). Each instantRepost URN follows the format urn:li:instantRepost:(POST_URN,REPOST_ID), for example: urn:li:instantRepost:(urn:li:share:{POST_ID},{REPOST_ID}). You can obtain instantRepost URNs using the repostsByReposter or repostsFromEntity finder methods.",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Sample Request",
      "Anchor": "sample-request",
      "SectionPath": [
        "Batch Get a Collection of InstantReposts",
        "Sample Request"
      ],
      "Text": "http\n\n\ncurl",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "code",
      "Section": "Sample Request",
      "Anchor": "sample-request",
      "SectionPath": [
        "Batch Get a Collection of InstantReposts",
        "Sample Request"
      ],
      "Text": "GET https://api.linkedin.com/rest/dmaInstantReposts?ids=List(urn%3Ali%3AinstantRepost%3A%28urn%3Ali%3Ashare%3A7127775805794840576%2C7127776228119306240%29)",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "code",
      "Section": "Sample Request",
      "Anchor": "sample-request",
      "SectionPath": [
        "Batch Get a Collection of InstantReposts",
        "Sample Request"
      ],
      "Text": "curl -X GET \u0027https://api.linkedin.com/rest/dmaInstantReposts?ids=List(urn%3Ali%3AinstantRepost%3A%28urn%3Ali%3Ashare%3A7127775805794840576%2C7127776228119306240%29)\u0027 \\\n--header \u0027Authorization: Bearer {INSERT_TOKEN}\u0027 \\\n--header \u0027Linkedin-Version: {version number in the format YYYYMM}\u0027 \\\n--header \u0027X-Restli-Protocol-Version: 2.0.0\u0027",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "code",
      "Section": "Sample Response",
      "Anchor": "sample-response",
      "SectionPath": [
        "Batch Get a Collection of InstantReposts",
        "Sample Response"
      ],
      "Text": "{\n    \u0022statuses\u0022: {},\n    \u0022results\u0022: {\n        \u0022urn:li:instantRepost:(urn:li:share:7127775805794840576,7127776228119306240)\u0022: {\n            \u0022id\u0022: 7127776228119306240,\n            \u0022lastModified\u0022: {\n                \u0022actor\u0022: \u0022urn:li:person:p1o8wGdEXZ\u0022,\n                \u0022time\u0022: 1699394280474\n            },\n            \u0022created\u0022: {\n                \u0022actor\u0022: \u0022urn:li:person:p1o8wGdEXZ\u0022,\n                \u0022time\u0022: 1699394280474\n            },\n            \u0022repostedContent\u0022: {\n                \u0022share\u0022: \u0022urn:li:share:7127775805794840576\u0022\n            }\n        }\n    },\n    \u0022errors\u0022: {}\n}",
      "Headers": [],
      "Rows": []
    },
