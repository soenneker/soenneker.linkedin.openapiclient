    {
      "Kind": "text",
      "Section": "How to Obtain InstantRepost URNs",
      "Anchor": "how-to-obtain-instantrepost-urns",
      "SectionPath": [
        "InstantRepost URNs",
        "How to Obtain InstantRepost URNs"
      ],
      "Text": "InstantRepost URNs are required to retrieve repost data using the DMA InstantRepost API. You can obtain these URNs through the DMA Feed Content API using either the repostsByReposter or repostsFromEntity finder methods.",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "How to Obtain InstantRepost URNs",
      "Anchor": "how-to-obtain-instantrepost-urns",
      "SectionPath": [
        "InstantRepost URNs",
        "How to Obtain InstantRepost URNs"
      ],
      "Text": "Retrieves a list of urn:li:instantRepost values representing instant reposts made by the specified organization.",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Sample Request (repostsByReposter)",
      "Anchor": "sample-request-repostsbyreposter",
      "SectionPath": [
        "InstantRepost URNs",
        "Sample Request (repostsByReposter)"
      ],
      "Text": "http\n\n\ncurl",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "code",
      "Section": "Sample Request (repostsByReposter)",
      "Anchor": "sample-request-repostsbyreposter",
      "SectionPath": [
        "InstantRepost URNs",
        "Sample Request (repostsByReposter)"
      ],
      "Text": "GET https://api.linkedin.com/rest/dmaFeedContentsExternal?reposter={ORG_URN}\u0026maxPaginationCount={MAX}\u0026q=repostsByReposter",
      "Headers": [],
      "Rows": []
