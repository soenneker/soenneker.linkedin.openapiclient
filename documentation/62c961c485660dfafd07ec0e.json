      "Kind": "text",
      "Section": "Member Follower Statistics",
      "Anchor": "member-follower-statistics",
      "SectionPath": [],
      "Text": "The memberFollowersCount API retrieves both lifetime and time-bound follower statistics for the authenticated member.",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Member Follower Statistics",
      "Anchor": "member-follower-statistics",
      "SectionPath": [],
      "Text": "Lifetime follower statistics: To retrieve lifetime follower statistics, use the me finder. The API returns lifetime follower counts.\n\nTime-bound follower statistics: To retrieve time-bound follower statistics, use the dateRange finder. The API returns the daily followers count within the specified dateRange.",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "table",
      "Section": "Permissions",
      "Anchor": "permissions",
      "SectionPath": [
        "Permissions"
      ],
      "Text": "",
      "Headers": [
        "Permission",
        "Description"
      ],
      "Rows": [
        [
          {
            "Text": "r_member_profileAnalytics",
            "Links": [],
            "Values": []
          },
          {
            "Text": "Retrieve your profile analytics, including the number of profile viewers, followers, and search appearances. Restricted to members.",
            "Links": [],
            "Values": []
          }
        ]
      ]
    },
    {
      "Kind": "text",
      "Section": "Retrieve Lifetime Follower Statistics",
      "Anchor": "retrieve-lifetime-follower-statistics",
      "SectionPath": [
        "Retrieve Lifetime Follower Statistics"
      ],
      "Text": "Call memberFollowersCount with me query parameter to retrieve lifetime follower statistics.",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Sample Request",
      "Anchor": "sample-request",
      "SectionPath": [
        "Retrieve Lifetime Follower Statistics",
        "Sample Request"
      ],
      "Text": "To fetch lifetime follower statistics for a member.",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Sample Request",
      "Anchor": "sample-request",
      "SectionPath": [
        "Retrieve Lifetime Follower Statistics",
        "Sample Request"
      ],
      "Text": "Restli 2.0:",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Sample Request",
      "Anchor": "sample-request",
      "SectionPath": [
        "Retrieve Lifetime Follower Statistics",
        "Sample Request"
      ],
      "Text": "http\n\n\ncurl",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "code",
      "Section": "Sample Request",
      "Anchor": "sample-request",
      "SectionPath": [
        "Retrieve Lifetime Follower Statistics",
        "Sample Request"
      ],
      "Text": "GET https://api.linkedin.com/rest/memberFollowersCount?q=me",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "code",
      "Section": "Sample Request",
      "Anchor": "sample-request",
      "SectionPath": [
        "Retrieve Lifetime Follower Statistics",
        "Sample Request"
      ],
      "Text": "curl -X GET \u0027https://api.linkedin.com/rest/memberFollowersCount?q=me\u0027 \\\n-H \u0027X-Restli-Protocol-Version: 2.0.0\u0027 \\\n-H \u0027Authorization: Bearer {INSERT_TOKEN}\u0027 \\\n-H \u0027Linkedin-Version: {version number in the format YYYYMM}\u0027 \\\n-H \u0027Content-Type: application/json\u0027",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "code",
      "Section": "Sample Response",
      "Anchor": "sample-response",
      "SectionPath": [
        "Retrieve Lifetime Follower Statistics",
        "Sample Response"
      ],
      "Text": "{\n    \u0022elements\u0022: [\n        {\n            \u0022memberFollowersCount\u0022: 100\n        }\n    ],\n    \u0022paging\u0022: {\n        \u0022count\u0022: 10,\n        \u0022start\u0022: 0,\n        \u0022total\u0022: 1,\n        \u0022links\u0022: []\n    }\n}",
      "Headers": [],
      "Rows": []
    },
