    {
      "Kind": "text",
      "Section": "SalesAnalyticsExportJob",
      "Anchor": "salesanalyticsexportjob",
      "SectionPath": [
        "Definitions",
        "SalesAnalyticsExportJob"
      ],
      "Text": "Contains response details of a Sales Navigator Application Platform (SNAP) data export job, namely, the job\u0027s id, current status, url to download the result from, expiration date of the download url, and the data schema of the exported csv file. These jobs are issued by customers in the LinkedIn Partner Program and their desire is to fetch temporal data regarding Activites, Activity Outcomes, Seats, Seats Tags, and Member Identity Mapping information.",
      "Headers": [],
      "Rows": []
    },
    {
