    {
      "Kind": "text",
      "Section": "Manage Application Secrets",
      "Anchor": "manage-application-secrets",
      "SectionPath": [
        "Manage Application Secrets"
      ],
      "Text": "Rotate and delete secrets for your child applications to maintain security. Each application can have up to two active secrets, allowing you to rotate credentials without service interruption.",
