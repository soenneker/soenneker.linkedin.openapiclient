    {
      "Kind": "text",
      "Section": "Error Codes",
      "Anchor": "error-codes",
      "SectionPath": [
        "Error Codes"
      ],
      "Text": "The following error codes can be returned:",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "table",
      "Section": "Error Codes",
      "Anchor": "error-codes",
      "SectionPath": [
        "Error Codes"
      ],
      "Text": "",
      "Headers": [
        "Error Code",
        "Description"
      ],
      "Rows": [
        [
          {
            "Text": "404: uniqueForeignId not found",
            "Links": [],
            "Values": []
          },
          {
            "Text": "In the situation where the requested foreign ID is not found to be associated with an application managed by the parent application making the request, an HTTP 404 response is returned.",
            "Links": [],
            "Values": []
          }
        ],
        [
          {
            "Text": "409: uniqueForeignId already exists",
            "Links": [],
            "Values": []
          },
          {
            "Text": "In the case where a create call is made and a uniqueForeignID value is provided that is already associated to a child application controlled by the parent calling application, an HTTP 409 - Conflict response code is returned. A parent application will not accept the creation of multiple tenant applications that share the same uniqueForeignId value.",
            "Links": [],
            "Values": []
          }
        ],
        [
          {
            "Text": "429: request limit exceeded",
            "Links": [],
            "Values": []
          },
          {
            "Text": "If the calling application has exceeded its call throttle limits, an HTTP 429 \u2013 Too Many Requests status code is returned.",
            "Links": [],
            "Values": []
          }
        ]
      ]
