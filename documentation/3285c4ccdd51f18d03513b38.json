    {
      "Kind": "text",
      "Section": "Retrieve boost analytics",
      "Anchor": "retrieve-boost-analytics",
      "SectionPath": [
        "Retrieve boost analytics"
      ],
      "Text": "The boostAnalytics API returns Boost performance analytics for boosted posts owned by the authenticated member or by a sponsoring organization. The response externalizes a curated set of sponsored metrics shown on the boosted post in the LinkedIn flagship app: impressions, clicks, clickThroughRate, reactions, comments, shares, follows, spend, and approximateMemberReach.",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Retrieve boost analytics",
      "Anchor": "retrieve-boost-analytics",
      "SectionPath": [
        "Retrieve boost analytics"
      ],
      "Text": "Call boostAnalytics with q=boostAnalytics to retrieve one analytics record per requested target post. The response returns records in the same order as the targetPosts request list.",
      "Headers": [],
      "Rows": []
    },
