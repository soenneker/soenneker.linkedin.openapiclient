        "Update Endorsements",
        "sample request"
      ],
      "Text": "{\n    \u0022patch\u0022: {\n        \u0022$set\u0022: {\n            \u0022status\u0022: \u0022HIDDEN\u0022\n        }\n    }\n}",
      "Headers": [],
      "Rows": []
    },
    {
