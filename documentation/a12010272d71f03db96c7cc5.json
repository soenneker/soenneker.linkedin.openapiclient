        "Update Endorsements"
      ],
      "Text": "POST https://api.linkedin.com/v2/endorsement/urn%3Ali%3Aendorsement%3A%28urn%3Ali%3Aperson%3A123ABC%2C123456%29",
      "Headers": [],
      "Rows": []
