      "Rows": []
    },
    {
      "Kind": "code",
      "Section": "Retrieve Endorsements by Endorser",
      "Anchor": "retrieve-endorsements-by-endorser",
      "SectionPath": [
        "Retrieve Endorsements by Endorser"
      ],
      "Text": "GET https://api.linkedin.com/v2/endorsement?q=endorser\u0026statusFilters=List(ACCEPTED,PENDING)",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "table",
      "Section": "Query Parameters",
