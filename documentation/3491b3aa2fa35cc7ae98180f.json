    },
    {
      "Kind": "text",
      "Section": "/identityMe \u2014 Version 202510.03 (Latest)",
      "Anchor": "identityme--version-20251003-latest",
      "SectionPath": [
        "What\u2019s New in the Latest Release",
        "Release Highlights \u2013 Latest Version",
        "/identityMe \u2014 Version 202510.03 (Latest)"
      ],
      "Text": "Removed basicInfo.headline\nAdded basicInfo.primaryEmailAddress\nAll other fields in mostRecentEducation and primaryCurrentPosition remain unchanged",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "/verificationReport \u2014 Version 202607 (Latest)",
      "Anchor": "verificationreport--version-202607-latest",
      "SectionPath": [
        "What\u2019s New in the Latest Release",
        "Release Highlights \u2013 Latest Version",
        "/verificationReport \u2014 Version 202607 (Latest)"
      ],
      "Text": "What changed vs. 202510:",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "/verificationReport \u2014 Version 202607 (Latest)",
      "Anchor": "verificationreport--version-202607-latest",
      "SectionPath": [
        "What\u2019s New in the Latest Release",
        "Release Highlights \u2013 Latest Version",
        "/verificationReport \u2014 Version 202607 (Latest)"
      ],
      "Text": "Added optional verifiedWithinDays query parameter.\nPartners can now request freshness validation for existing verifications.\nExisting verification data, including verifiedDetails, continues to be returned and is never removed or invalidated.\nverificationUrl is returned when an existing verification is older than the requested freshness window, allowing eligible members to re-verify.",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "/validationStatus \u2014 Version 202510 (Latest)",
      "Anchor": "validationstatus--version-202510-latest",
      "SectionPath": [
        "What\u2019s New in the Latest Release",
        "Release Highlights \u2013 Latest Version",
        "/validationStatus \u2014 Version 202510 (Latest)"
      ],
      "Text": "No schema or behavior changes compared to 202507. The API continues to:",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "/validationStatus \u2014 Version 202510 (Latest)",
      "Anchor": "validationstatus--version-202510-latest",
      "SectionPath": [
        "What\u2019s New in the Latest Release",
        "Release Highlights \u2013 Latest Version",
        "/validationStatus \u2014 Version 202510 (Latest)"
      ],
      "Text": "Return verificationStatus.workplace\nReturn verificationStatus.identity\nReturn profileInformationStatus\nUse 2-legged application authorization (r_validation_status)\nSupport bulk and single-member validation checks",
      "Headers": [],
      "Rows": []
    },
