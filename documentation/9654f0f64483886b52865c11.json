      ],
      "Text": "{\n    \u0022patch\u0022: {\n        \u0022$set\u0022: {\n            \u0022degreeName\u0022: {\n                \u0022localized\u0022: {\n                    \u0022en_US\u0022: \u0022Bachelor of Science (B.S.)\u0022\n                },\n                \u0022preferredLocale\u0022: {\n                    \u0022country\u0022: \u0022US\u0022,\n                    \u0022language\u0022: \u0022en\u0022\n                }\n            },\n            \u0022schoolName\u0022: {\n                \u0022localized\u0022: {\n                    \u0022en_US\u0022: \u0022Stanford University\u0022\n                },\n                \u0022preferredLocale\u0022: {\n                    \u0022country\u0022: \u0022US\u0022,\n                    \u0022language\u0022: \u0022en\u0022\n                }\n            },\n            \u0022startMonthYear\u0022: {\n                \u0022year\u0022: 2013\n            }\n        }\n    }\n}",
      "Headers": [],
      "Rows": []
    },
