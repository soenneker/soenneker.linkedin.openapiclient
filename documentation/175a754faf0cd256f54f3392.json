      "Kind": "text",
      "Section": "Industry Taxonomy Versions - Standardized Data API",
      "Anchor": "industry-taxonomy-versions---standardized-data-api",
      "SectionPath": [],
      "Text": "The Industry Taxonomy Versions - Standardized Data API provides standardized industry data across the LinkedIn platform. The API offers a hierarchical/tree structure to easily navigate through a comprehensive list of 400\u002B industries that are aligned with NAICS.",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Supported Methods",
      "Anchor": "supported-methods",
      "SectionPath": [
        "Supported Methods"
      ],
      "Text": "GET | BATCH_GET | GET_ALL",
      "Headers": [],
      "Rows": []
    },
