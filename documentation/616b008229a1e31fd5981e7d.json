      "Section": "Retrieve Recommendation Requests",
      "Anchor": "retrieve-recommendation-requests",
      "SectionPath": [
        "Retrieve Recommendation Requests"
      ],
      "Text": "GET https://api.linkedin.com/v2/recommendationRequest/urn%3Ali%3ArecommendationRequest%3A%28urn%3Ali%3Aperson%3A123ABC%2C123456%29",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "code",
      "Section": "sample request body",
      "Anchor": "sample-request-body-1",
      "SectionPath": [
        "Retrieve Recommendation Requests",
        "sample request body"
      ],
      "Text": "{\n    \u0022created\u0022: 1490373303379,\n    \u0022id\u0022: 267254,\n    \u0022lastModified\u0022: 1490383550104,\n    \u0022numRequests\u0022: 1,\n    \u0022relationship\u0022: \u0022RECOMMENDER_REPORTED_TO_RECOMMENDEE\u0022,\n    \u0022requestee\u0022: \u0022urn:li:person:444FFF\u0022,\n    \u0022requesteeEntity\u0022: \u0022urn:li:position:(urn:li:person:444FFF,40855915)\u0022,\n    \u0022requester\u0022: \u0022urn:li:person:123ABC\u0022,\n    \u0022requesterEntity\u0022: \u0022urn:li:position:(urn:li:person:123ABC,40170411)\u0022,\n    \u0022status\u0022: \u0022PENDING\u0022\n}",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "sample request body",
      "Anchor": "sample-request-body-1",
      "SectionPath": [
        "Retrieve Recommendation Requests",
        "sample request body"
      ],
      "Text": "For more information, refer to the Recommendation Request schema.",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "sample request body",
      "Anchor": "sample-request-body-1",
      "SectionPath": [
        "Retrieve Recommendation Requests",
        "sample request body"
      ],
