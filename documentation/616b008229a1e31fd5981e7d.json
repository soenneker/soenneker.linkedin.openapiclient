    {
      "Kind": "text",
      "Section": "Update Recommendation Requests",
      "Anchor": "update-recommendation-requests",
      "SectionPath": [
        "Update Recommendation Requests"
      ],
      "Text": "You can update an recommendation request status, requesteeEntity, relationship, notification or previousRecommendation of one you have given or received by doing the following:",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "code",
      "Section": "Update Recommendation Requests",
      "Anchor": "update-recommendation-requests",
      "SectionPath": [
        "Update Recommendation Requests"
      ],
      "Text": "POST https://api.linkedin.com/v2/recommendationRequest/urn:li:recommendationRequest:(urn:li:person:123ABC,123456)",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Update Recommendation Requests",
      "Anchor": "update-recommendation-requests",
      "SectionPath": [
        "Update Recommendation Requests"
      ],
      "Text": "You can construct the recommendationUrn by taking the requester personUrn and th recommendationRequestID.",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Update Recommendation Requests",
      "Anchor": "update-recommendation-requests",
      "SectionPath": [
        "Update Recommendation Requests"
      ],
      "Text": "Example: urn:li:recommendationRequest:({**requester personUrn**},{**recommendationRequestID**})",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Update Recommendation Requests",
      "Anchor": "update-recommendation-requests",
      "SectionPath": [
        "Update Recommendation Requests"
      ],
