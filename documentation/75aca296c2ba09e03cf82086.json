      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Schema",
      "Anchor": "schema",
      "SectionPath": [
        "Schema"
      ],
      "Text": "field urlMatchRuleExpression will replace the field matchRules. While the field matchRules is still allowed for this moment, we would suggest and all examples in our api are using the field urlMatchRuleExpression.",
      "Headers": [],
      "Rows": []
    },
    {
