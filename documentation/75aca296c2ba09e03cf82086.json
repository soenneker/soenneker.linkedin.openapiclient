      "Rows": [
        [
          {
            "Text": "EXACT",
            "Links": [],
            "Values": []
          },
          {
            "Text": "Matches if the URL and the match value are exactly the same.",
            "Links": [],
            "Values": []
          }
        ],
        [
          {
            "Text": "STARTS_WITH",
            "Links": [],
            "Values": []
          },
          {
            "Text": "Matches if the URL starts with the matchValue.",
            "Links": [],
            "Values": []
          }
        ],
        [
          {
            "Text": "CONTAINS",
            "Links": [],
            "Values": []
          },
          {
            "Text": "Matches if the URL contains the matchValue at any location.",
