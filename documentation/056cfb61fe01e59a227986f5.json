    {
      "Kind": "text",
      "Section": "How to Retrieve Geo IDs",
      "Anchor": "how-to-retrieve-geo-ids",
      "SectionPath": [
        "How to Retrieve Geo IDs"
      ],
      "Text": "Geo IDs appear in responses from other DMA APIs such as Organizations and Organizational Page Edge Analytics. Use GET or BATCH_GET to resolve known Geo IDs.",
      "Headers": [],
      "Rows": []
    },
