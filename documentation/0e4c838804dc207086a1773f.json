      ],
      "Text": "Daily validation - Run bulk validation once per day for all members\nIdentify changes - Filter members with INVALID or VALID_WITH_UPDATES status\nFetch fresh data - Call /verificationReport and /identityMe only for changed members\nUpdate database - Store latest verification and profile data",
      "Headers": [],
      "Rows": []
    },
