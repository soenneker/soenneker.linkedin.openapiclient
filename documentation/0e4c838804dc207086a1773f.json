    {
      "Kind": "text",
      "Section": "Key Differences from Other APIs",
      "Anchor": "key-differences-from-other-apis",
      "SectionPath": [
        "Key Differences from Other APIs"
      ],
      "Text": "Use Case: Use this API to check if any of your members\u0027 profile or verification information has changed. This allows you to efficiently identify which members need data refreshes, then pull only the changed member data using /verificationReport and /identityMe.",
      "Headers": [],
      "Rows": []
    },
