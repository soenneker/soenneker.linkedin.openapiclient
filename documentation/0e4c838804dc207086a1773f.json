      "Kind": "text",
      "Section": "Validation Status API (/validationStatus)",
      "Anchor": "validation-status-api-validationstatus",
      "SectionPath": [],
      "Text": "The Validation Status API (/validationStatus) allows enterprise partners to retrieve the current validation status of LinkedIn members at scale. This API is optimized for bulk or single-member checks and provides validation results across three categories.",
      "Headers": [],
      "Rows": []
    },
    {
