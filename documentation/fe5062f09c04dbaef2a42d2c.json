              "ORGANIC_SHARE_CREATE",
              "ORGANIC_SHARE_EDIT",
              "ORGANIC_SHARE_DELETE",
              "DARK_SHARE_CREATE",
              "DARK_SHARE_EDIT",
              "DARK_SHARE_DELETE",
              "DARK_SHARE_VIEW_AS_AUTHOR"
            ]
          }
        ],
        [
