    {
      "Kind": "text",
      "Section": "Get Organization Authorization Information",
      "Anchor": "get-organization-authorization-information",
      "SectionPath": [
        "Fetch Organization Authorization Information",
        "Get Organization Authorization Information"
      ],
      "Text": "Use the personUrn, organizationUrn, and OrganizationAuthorizationAction to lookup Organization Authorization information on behalf of authenticated members. API calls with insufficient permissions receive a 403 Forbidden response.",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Sample Request",
      "Anchor": "sample-request",
      "SectionPath": [
        "Fetch Organization Authorization Information",
        "Get Organization Authorization Information",
        "Sample Request"
      ],
      "Text": "http\n\n\ncurl",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "code",
      "Section": "Sample Request",
      "Anchor": "sample-request",
      "SectionPath": [
        "Fetch Organization Authorization Information",
        "Get Organization Authorization Information",
        "Sample Request"
      ],
      "Text": "GET https://api.linkedin.com/rest/organizationAuthorizations/(impersonator:{PERSON_URN},organization:{ORGANIZATION_URN},action:(organizationRoleAuthorizationAction:(actionType:ADMINISTRATOR_READ)))",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "code",
      "Section": "Sample Request",
      "Anchor": "sample-request",
      "SectionPath": [
        "Fetch Organization Authorization Information",
        "Get Organization Authorization Information",
        "Sample Request"
      ],
      "Text": "curl -X GET \u0027https://api.linkedin.com/rest/organizationAuthorizations/(impersonator:{PERSON_URN},organization:{ORGANIZATION_URN},action:(organizationRoleAuthorizationAction:(actionType:ADMINISTRATOR_READ)))\u0027 \\\n-H \u0027X-Restli-Protocol-Version: 2.0.0\u0027 \\\n-H \u0027Authorization: Bearer {INSERT_TOKEN}\u0027 \\\n-H \u0027Linkedin-Version: {version number in the format YYYYMM}\u0027 \\\n-H \u0027Content-Type: application/json\u0027",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "code",
      "Section": "Sample Response",
      "Anchor": "sample-response",
      "SectionPath": [
        "Fetch Organization Authorization Information",
        "Get Organization Authorization Information",
        "Sample Response"
      ],
      "Text": "{\n    \u0022impersonator\u0022: \u0022urn:li:person:12345678\u0022,\n    \u0022action\u0022: {\n        \u0022OrganizationRoleAuthorizationActionType\u0022: {\n            \u0022actionType\u0022: \u0022ADMINISTRATOR_READ\u0022\n        }\n    },\n    \u0022organization\u0022: \u0022urn:li:organization:11111111\u0022,\n    \u0022status\u0022: {\n        \u0022com.linkedin.organization.Approved\u0022: {}\n    }\n}",
      "Headers": [],
      "Rows": []
    },
    {
