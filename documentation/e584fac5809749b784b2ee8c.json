    {
      "Kind": "code",
      "Section": "Sample Request",
      "Anchor": "sample-request",
      "SectionPath": [
        "Retrieve Organization Relationship Statistics",
        "Sample Request"
      ],
      "Text": "GET https://api.linkedin.com/rest/dmaOrganizationRelationshipStatistics?q=statisticSortType\u0026organization={ORGANIZATION_URN}\u0026timeWindow=(value:THREE_MONTHS)\u0026sortType=(value:EMPLOYEE_INFLOWS)",
