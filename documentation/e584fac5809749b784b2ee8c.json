    {
      "Kind": "text",
      "Section": "Organization Relationship Statistics",
      "Anchor": "organization-relationship-statistics",
      "SectionPath": [],
      "Text": "How to determine which organizational pages are eligible for queries:\nTo find the organizations you can query relationship statistics for, please use OrganizationAuthorization\u0027s BATCH_FIND by AuthorizationAction and AuthenticatedMember with an authorization action of TalentBrandAuthorizationActionType.TALENT_BRAND_ANALYTICS_READ.",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Feature Overview",
      "Anchor": "feature-overview",
      "SectionPath": [
        "Feature Overview"
      ],
      "Text": "The Organization Relationship Statistics API returns relationship statistics between a given organization (company, school, or showcase page) and its related organizations for a specified time period. This API helps organization admins understand the connections and engagement between their organization and other companies on LinkedIn.",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Feature Overview",
      "Anchor": "feature-overview",
      "SectionPath": [
        "Feature Overview"
      ],
      "Text": "A primary use case is tracking page visitors who are employees of related organizations. Example: A company can see which other companies\u0027 employees are visiting its LinkedIn organization page, providing insights into talent pools, partnership opportunities, and competitive intelligence.",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Feature Overview",
      "Anchor": "feature-overview",
      "SectionPath": [
        "Feature Overview"
      ],
      "Text": "The relationship statistics are sorted by statistical type and include metrics like employee counts, visitor counts, and trends over time.",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Feature Names",
      "Anchor": "feature-names",
      "SectionPath": [
        "Feature Overview",
        "Feature Names"
      ],
      "Text": "This feature may also be referred to as:",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Feature Names",
      "Anchor": "feature-names",
      "SectionPath": [
        "Feature Overview",
        "Feature Names"
      ],
      "Text": "Organization Relationship Analytics\nCompany Relationship Statistics\nTalent Brand Analytics (in the context of recruitment and employer branding)",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Feature Names",
      "Anchor": "feature-names",
      "SectionPath": [
        "Feature Overview",
        "Feature Names"
      ],
      "Text": "The service currently provides the following method:",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Feature Names",
      "Anchor": "feature-names",
      "SectionPath": [
        "Feature Overview",
        "Feature Names"
      ],
      "Text": "statisticSortType - Finds a list of relationship statistics between a given organization and its related organizations for a specified time period, sorted by the statistic type.",
      "Headers": [],
      "Rows": []
    },
