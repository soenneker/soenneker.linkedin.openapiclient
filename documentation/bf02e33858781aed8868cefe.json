      "Kind": "text",
      "Section": "adAccounts",
      "Anchor": "adaccounts",
      "SectionPath": [],
      "Text": "The LinkedIn ads platform allows advertisers to create multiple accounts for both Text Ads and Sponsored Content. Use the Ad Accounts API to create and manage accounts.",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Supported Methods",
      "Anchor": "supported-methods",
      "SectionPath": [
        "Supported Methods"
      ],
      "Text": "CREATE | GET | SEARCH\u00A0FINDER | UPDATE",
      "Headers": [],
      "Rows": []
    },
    {
