      "Section": "Schema",
      "Anchor": "schema",
      "SectionPath": [
        "Schema"
      ],
      "Text": "",
      "Headers": [
        "Field Name",
        "Type",
        "Description"
      ],
      "Rows": [
        [
          {
            "Text": "currency",
            "Links": [],
            "Values": []
          },
          {
            "Text": "string, default=\u0022USD\u0022",
            "Links": [],
            "Values": []
          },
          {
            "Text": "The ISO 4217 currency code of the account, such as \u0027USD\u0027 for United States Dollar. Note: Advertisers selecting BRL as a currency will see their account budget, advertising bids, and spend in BRL, but their account will be billed in USD. We recommend communicating this to advertisers in your application if they opt for BRL. Learn more",
            "Links": [
              "https://learn.microsoft.com/en-us/linkedin/shared/references/reference-tables/currency-codes",
              "https://www.linkedin.com/help/linkedin/answer/41250"
            ],
            "Values": []
          }
        ],
        [
          {
            "Text": "id",
            "Links": [],
            "Values": []
          },
          {
            "Text": "long",
            "Links": [],
            "Values": []
          },
          {
            "Text": "Unique internal ID representing the account.",
            "Links": [],
            "Values": []
          }
        ],
        [
          {
            "Text": "name",
            "Links": [],
            "Values": []
          },
          {
            "Text": "string",
            "Links": [],
            "Values": []
          },
          {
            "Text": "A label for the account.",
            "Links": [],
            "Values": []
          }
        ],
        [
          {
            "Text": "notifiedOnCampaignOptimization",
            "Links": [],
            "Values": []
          },
          {
            "Text": "boolean, default=\u0022false\u0022",
            "Links": [],
            "Values": []
          },
          {
            "Text": "Indicates if the campaign contact is notified about campaign optimization opportunities.",
            "Links": [],
            "Values": []
          }
        ],
        [
          {
            "Text": "notifiedOnCreativeApproval",
            "Links": [],
            "Values": []
          },
          {
            "Text": "boolean, default=\u0022false\u0022",
            "Links": [],
            "Values": []
          },
          {
            "Text": "Indicates if the creative contact is notified when a creative has been reviewed and approved.",
            "Links": [],
            "Values": []
          }
        ],
        [
          {
            "Text": "notifiedOnCreativeRejection",
            "Links": [],
            "Values": []
          },
          {
            "Text": "boolean, default=\u0022false\u0022",
            "Links": [],
            "Values": []
          },
          {
            "Text": "Indicates if the creative contact is notified when a creative has been rejected due to content.",
            "Links": [],
            "Values": []
          }
        ],
        [
          {
            "Text": "notifiedOnEndOfCampaign",
            "Links": [],
            "Values": []
          },
          {
            "Text": "boolean, default=\u0022false\u0022",
            "Links": [],
            "Values": []
          },
          {
            "Text": "Indicates if the campaign contact is notified when an associated campaign has been completed.",
            "Links": [],
            "Values": []
          }
        ],
        [
          {
            "Text": "notifiedOnNewFeaturesEnabled",
            "Links": [],
            "Values": []
          },
          {
            "Text": "boolean, default=\u0022false\u0022",
            "Links": [],
            "Values": []
          },
          {
            "Text": "Indicates if the account owner is notified about new Campaign Manager features.",
            "Links": [],
            "Values": []
          }
        ],
        [
          {
            "Text": "reference",
            "Links": [],
            "Values": []
          },
          {
            "Text": "optional URN",
            "Links": [],
            "Values": []
          },
          {
            "Text": "The entity on whose behalf the account advertises. Must either be in the format urn:li:person:{id} or urn:li:organization:{id}.",
            "Links": [],
            "Values": []
          }
        ],
        [
          {
            "Text": "servingStatuses",
            "Links": [],
            "Values": []
          },
          {
            "Text": "string[], default=\u0022[]\u0022",
            "Links": [],
            "Values": []
          },
          {
            "Text": "An array of enums with information about the account\u0027s system serving statuses. If an account is eligible for serving, then this array will have a single element: RUNNABLE Otherwise, this array will contain one or more reasons why the account is not servable: STOPPED BILLING_HOLD ACCOUNT_TOTAL_BUDGET_HOLD ACCOUNT_END_DATE_HOLD RESTRICTED_HOLD INTERNAL_HOLD",
            "Links": [],
            "Values": [
              "RUNNABLE",
              "STOPPED",
              "BILLING_HOLD",
              "ACCOUNT_TOTAL_BUDGET_HOLD",
              "ACCOUNT_END_DATE_HOLD",
              "RESTRICTED_HOLD",
              "INTERNAL_HOLD"
            ]
          }
        ],
        [
          {
            "Text": "status",
            "Links": [],
            "Values": []
          },
          {
            "Text": "string, default=\u0022ACTIVE\u0022",
            "Links": [],
            "Values": []
          },
          {
            "Text": "ACTIVE - Account is active; this is the default stateCANCELED - Account has been permanently canceledDRAFT - Account is in draft status, meaning it\u0027s not yet fully set up and it is not serving",
            "Links": [],
            "Values": [
              "ACTIVE - Account is active; this is the default state",
              "CANCELED - Account has been permanently canceled",
              "DRAFT - Account is in draft status, meaning it\u0027s not yet fully set up and it is not serving"
            ]
          }
        ],
        [
          {
            "Text": "type",
            "Links": [],
            "Values": []
          },
          {
            "Text": "string",
            "Links": [],
            "Values": []
          },
          {
            "Text": "BUSINESS \u2013 This is the only value allowed when creating accounts through the API. ENTERPRISE \u2013 This value cannot be used to create accounts through the API and is reserved for accounts created by LinkedIn\u0027s internal ad operations systems.",
            "Links": [],
            "Values": [
              "BUSINESS \u2013 This is the only value allowed when creating accounts through the API.",
              "ENTERPRISE \u2013 This value cannot be used to create accounts through the API and is reserved for accounts created by LinkedIn\u0027s internal ad operations systems."
            ]
          }
        ],
        [
          {
            "Text": "test",
            "Links": [],
            "Values": []
          },
          {
            "Text": "boolean, default=\u0022false\u0022",
            "Links": [],
            "Values": []
          },
          {
            "Text": "Flag showing whether this account is marked as a test account. An account can be marked as test only during creation. This is an immutable field.",
            "Links": [],
            "Values": []
          }
        ]
