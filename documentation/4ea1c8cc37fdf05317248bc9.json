      ],
      "Rows": [
        [
          {
            "Text": "w_organization_social",
            "Links": [],
            "Values": []
          },
          {
            "Text": "Post, comment, and like posts on behalf of an organization. Restricted to the company admin, DSC poster, or content admin.",
            "Links": [],
            "Values": []
          }
        ],
        [
          {
            "Text": "r_organization_social",
            "Links": [],
            "Values": []
          },
          {
            "Text": "Retrieve your organizations\u0027 posts, including any comments, likes, and other engagement data with AUTHOR injection.",
            "Links": [],
            "Values": []
          }
        ],
        [
          {
            "Text": "w_member_social",
            "Links": [],
            "Values": []
          },
          {
            "Text": "Post, comment, and like posts on behalf of authenticated member.",
            "Links": [],
            "Values": []
          }
        ],
        [
          {
            "Text": "r_member_social",
            "Links": [],
            "Values": []
          },
          {
            "Text": "Retrieve posts, comments, reactions, and other engagement data on behalf of authenticated member.",
            "Links": [],
            "Values": []
          }
        ],
        [
          {
            "Text": "rw_ads",
            "Links": [],
            "Values": []
          },
          {
            "Text": "Create ads and creatives for a sponsored account.",
            "Links": [],
            "Values": []
          }
        ],
        [
          {
            "Text": "r_ads",
            "Links": [],
            "Values": []
          },
          {
            "Text": "Read an authenticated member\u0027s Ad Account. Restricted to Ad Accounts in which the authenticated member has one of the following Ad Account roles.ACCOUNT_BILLING_ADMIN ACCOUNT_MANAGER CAMPAIGN_MANAGER CREATIVE_MANAGER VIEWER",
            "Links": [],
            "Values": []
          }
        ]
      ]
    },
    {
      "Kind": "text",
      "Section": "Permissions",
      "Anchor": "permissions",
      "SectionPath": [
        "Permissions"
      ],
      "Text": "The following permission checks are performed when uploading a document:",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Permissions",
      "Anchor": "permissions",
      "SectionPath": [
        "Permissions"
      ],
      "Text": "For documents with company URN owners, the caller must have ADMIN or DSC permissions for the company page.\nFor documents with SponsoredContentAccount URN owners, all GET\u0027s and UPDATE\u0027s are permitted.\nFor documents with person URN owners, the caller must match the document owner.",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Permissions",
      "Anchor": "permissions",
      "SectionPath": [
        "Permissions"
      ],
      "Text": "Invalid permissions results in the following API response:",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "code",
      "Section": "Permissions",
      "Anchor": "permissions",
      "SectionPath": [
        "Permissions"
      ],
      "Text": "{\n    \u0022message\u0022: \u0022Accessing this document resource is forbidden. Please check your permissions for this resource\u0022,\n    \u0022status\u0022: 403\n}",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Permissions",
      "Anchor": "permissions",
      "SectionPath": [
        "Permissions"
      ],
      "Text": "Important",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Permissions",
      "Anchor": "permissions",
      "SectionPath": [
        "Permissions"
      ],
      "Text": "The file size can\u0027t exceed 100MB and 300 pages. The following file types are supported: PPT, PPTX, DOC, DOCX, and PDF.",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Schema",
