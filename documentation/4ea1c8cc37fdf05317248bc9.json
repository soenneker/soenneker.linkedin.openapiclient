            "Values": []
          },
          {
            "Text": "URN",
            "Links": [],
            "Values": []
          },
          {
            "Text": "URN of the entity that owns this asset. Can be a person(urn:li:person:123), or organization(urn:li:organization:123) URN",
            "Links": [],
