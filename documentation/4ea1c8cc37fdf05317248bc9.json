        "Create Document content"
      ],
      "Text": "POST https://api.linkedin.com/rest/posts",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "code",
      "Section": "Create Document content",
      "Anchor": "create-document-content",
      "SectionPath": [
        "Managing Document content",
        "Create Document content"
      ],
      "Text": "{\n    \u0022author\u0022: \u0022urn:li:organization:1234567\u0022,\n    \u0022commentary\u0022: \u0022test strings!\u0022,\n    \u0022visibility\u0022: \u0022PUBLIC\u0022,\n    \u0022distribution\u0022: {\n        \u0022feedDistribution\u0022: \u0022MAIN_FEED\u0022,\n        \u0022targetEntities\u0022: [],\n        \u0022thirdPartyDistributionChannels\u0022: []\n    },\n    \u0022content\u0022: {\n        \u0022media\u0022: {\n            \u0022title\u0022:\u0022Example.pdf\u0022,\n            \u0022id\u0022: \u0022urn:li:document:D5510AQFx87994pYx0Q\u0022\n        }\n    },\n    \u0022lifecycleState\u0022: \u0022PUBLISHED\u0022,\n    \u0022isReshareDisabledByAuthor\u0022: false\n}",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "code",
      "Section": "Create Document content",
      "Anchor": "create-document-content",
      "SectionPath": [
        "Managing Document content",
        "Create Document content"
      ],
      "Text": "curl --location --request POST \u0027https://api.linkedin.com/rest/posts\u0027 \\\n--header \u0027Linkedin-Version: {version number in the format YYYYMM}\u0027 \\\n--header \u0027Authorization: Bearer {INSERT_TOKEN}\u0027 \\\n--header \u0027Content-Type: application/json\u0027 \\\n--data-raw \u0027{\n    \u0022author\u0022: \u0022urn:li:organization:1234567\u0022,\n    \u0022commentary\u0022: \u0022test strings!\u0022,\n    \u0022visibility\u0022: \u0022PUBLIC\u0022,\n    \u0022distribution\u0022: {\n        \u0022feedDistribution\u0022: \u0022MAIN_FEED\u0022,\n        \u0022targetEntities\u0022: [],\n        \u0022thirdPartyDistributionChannels\u0022: []\n    },\n    \u0022content\u0022: {\n        \u0022media\u0022: {\n            \u0022title\u0022:\u0022Example.pdf\u0022,\n            \u0022id\u0022: \u0022urn:li:document:D5510AQFx87994pYx0Q\u0022\n        }\n    },\n    \u0022lifecycleState\u0022: \u0022PUBLISHED\u0022,\n    \u0022isReshareDisabledByAuthor\u0022: false\n}\u0027",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Sample Response",
      "Anchor": "sample-response-4",
      "SectionPath": [
        "Managing Document content",
        "Create Document content",
        "Sample Response"
      ],
      "Text": "A successful response returns a 201 Created HTTP status code and the ID in the x-restli-id response header.",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Get Document content",
      "Anchor": "get-document-content",
      "SectionPath": [
        "Managing Document content",
        "Get Document content"
      ],
      "Text": "Retrieve document content associated with a Post performing GET call to the Posts API on a post that was created with document content. Example post ID: urn:li:share:6876614985750310912",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Get Document content",
      "Anchor": "get-document-content",
      "SectionPath": [
        "Managing Document content",
        "Get Document content"
      ],
      "Text": "http\n\n\ncurl",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "code",
      "Section": "Get Document content",
      "Anchor": "get-document-content",
      "SectionPath": [
        "Managing Document content",
        "Get Document content"
      ],
      "Text": "GET https://api.linkedin.com/rest/posts/{postId}",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "code",
      "Section": "Get Document content",
      "Anchor": "get-document-content",
      "SectionPath": [
        "Managing Document content",
        "Get Document content"
      ],
      "Text": "curl --location --request GET \u0027https://api.linkedin.com/rest/posts/urn:li:share:6876614985750310912 \\\n--header \u0027Linkedin-Version: {version number in the format YYYYMM}\u0027 \\\n--header \u0027Authorization: Bearer {INSERT_TOKEN}\u0027",
      "Headers": [],
      "Rows": []
    },
