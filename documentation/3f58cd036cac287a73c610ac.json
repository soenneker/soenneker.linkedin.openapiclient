    {
      "Kind": "text",
      "Section": "Applicant notification experience",
      "Anchor": "applicant-notification-experience",
      "SectionPath": [
        "Applicant notification experience"
      ],
      "Text": "As job applications are updated with the available actions, an applicant will be able to view or be notified of them. The following guide shows what the experience looks like for actions: APPLICATION_VIEWED, RESUME_DOWNLOADED, APPLICATION_REJECTED.",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Application submitted",
      "Anchor": "application-submitted",
      "SectionPath": [
        "Applicant notification experience",
        "Application submitted"
      ],
      "Text": "This is a default action triggered once an application is submitted, this does not require a partner to send an API update. An applicant can view this status in three places: LinkedIn email notification, LinkedIn job posting they applied to, and My Jobs.",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Application viewed",
      "Anchor": "application-viewed",
      "SectionPath": [
        "Applicant notification experience",
        "Application viewed"
      ],
      "Text": "This action is triggered once an application record is viewed within the ATS. An applicant can view this status in three places: LinkedIn email notification, LinkedIn job posting they applied to, and My Jobs.",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Resume downloaded",
      "Anchor": "resume-downloaded",
      "SectionPath": [
        "Applicant notification experience",
        "Resume downloaded"
      ],
      "Text": "This action is triggered once an application resume is downloaded or displayed within a document viewer in the ATS. An applicant can view this status in two places: LinkedIn job posting they applied to and My Jobs.",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Application rejected",
      "Anchor": "application-rejected",
      "SectionPath": [
        "Applicant notification experience",
        "Application rejected"
      ],
      "Text": "This action is triggered once an application is rejected within the ATS. An applicant will receive a LinkedIn email notification after 72 hours of the action being updated.",
      "Headers": [],
      "Rows": []
    }
  ]
