      "Kind": "text",
      "Section": "Sync job application notifications",
      "Anchor": "sync-job-application-notifications",
      "SectionPath": [],
      "Text": "Deliver real-time feedback to applicants. LinkedIn supports three applicant notifications to give LinkedIn members greater insight into where their application stands: Application Viewed, Resume Downloaded, and Application Rejected. Once a customer is posting jobs to LinkedIn with LinkedIn Easy Apply, you must begin sending these application lifecycle events.",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Sync job application notifications",
      "Anchor": "sync-job-application-notifications",
      "SectionPath": [],
      "Text": "Note",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Sync job application notifications",
      "Anchor": "sync-job-application-notifications",
      "SectionPath": [],
      "Text": "LinkedIn will only communicate these events to the applicant if the customer has given consent through the \u201CApplicant notifications\u201D checkbox within the Customer Onboarding Widget.",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Requirements",
      "Anchor": "requirements",
      "SectionPath": [
        "Requirements"
      ],
      "Text": "For every applicant that was received through LinkedIn, begin sending application lifecycle events.",
      "Headers": [],
      "Rows": []
    },
