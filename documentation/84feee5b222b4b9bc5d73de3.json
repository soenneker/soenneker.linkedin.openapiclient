    {
      "Kind": "text",
      "Section": "Connect",
      "Anchor": "connect",
      "SectionPath": [
        "Connect"
      ],
      "Text": "With the Connect component, sales professionals can send connection invites along with personal messages, to solidify leads and add them to their network.",
      "Headers": [],
      "Rows": []
    },
    {
