    {
      "Kind": "text",
      "Section": "Icebreakers",
      "Anchor": "icebreakers",
      "SectionPath": [
        "Icebreakers"
      ],
      "Text": "Ice Breakers informs sales professionals on a leads\u0027 key activities and interests, and commonalities shared with a sales professional. If a user taps on the light bulb button in Messaging module, the Icebreakers component will load and contain the Recent Activity and Highlights modules. Recent Activity and Highlights can also be loaded individually.",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Icebreakers",
      "Anchor": "icebreakers",
      "SectionPath": [
        "Icebreakers"
      ],
      "Text": "Important",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Icebreakers",
      "Anchor": "icebreakers",
      "SectionPath": [
        "Icebreakers"
      ],
      "Text": "The Icebreakers module is not supported as a standalone module in Inline Mode.",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Recent Activity",
      "Anchor": "recent-activity",
      "SectionPath": [
        "Recent Activity"
      ],
      "Text": "The Recent Activity component displays updates for a lead, including job updates, news about their company, and shares they have created, liked or commented on.",
