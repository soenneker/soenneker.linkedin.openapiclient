    {
      "Kind": "text",
      "Section": "Messaging",
      "Anchor": "messaging",
      "SectionPath": [
        "Messaging"
      ],
      "Text": "The Messaging component enables sales professionals to send private messages to their connections and InMail to new leads.",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Messaging",
      "Anchor": "messaging",
      "SectionPath": [
        "Messaging"
      ],
      "Text": "Important",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Messaging",
      "Anchor": "messaging",
      "SectionPath": [
        "Messaging"
      ],
      "Text": "If the recipient is not a 1st or 2nd degree connection, an InMail will be sent to the recipient when using this module. For 1st and 2nd degree connections, a normal message will be sent.",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Messaging",
      "Anchor": "messaging",
      "SectionPath": [
