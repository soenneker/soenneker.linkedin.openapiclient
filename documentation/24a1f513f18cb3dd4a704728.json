    {
      "Kind": "text",
      "Section": "Metrics Definition for Member Post Analytics",
      "Anchor": "metrics-definition-for-member-post-analytics",
      "SectionPath": [
        "Metrics Definition for Member Post Analytics"
      ],
      "Text": "The VIDEO_PLAY, VIDEO_VIEWER, and VIDEO_WATCH_TIME metrics are only available for posts that contain a video. If the post doesn\u0027t contain a video, these metrics won\u0027t be returned.\nThe VIDEO_VIEWER and VIDEO_WATCH_TIME metrics don\u0027t support daily aggregation or time-bound queries.",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "table",
      "Section": "Query Parameters",
      "Anchor": "query-parameters",
      "SectionPath": [
        "Metrics Definition for Member Post Analytics",
        "Query Parameters"
      ],
      "Text": "",
      "Headers": [
        "Name",
        "Description",
        "Format",
        "Optional"
      ],
      "Rows": [
        [
          {
            "Text": "q",
            "Links": [],
            "Values": []
          },
          {
            "Text": "Finder name. Value must be entity.",
            "Links": [],
            "Values": []
          },
          {
            "Text": "String",
            "Links": [],
            "Values": []
          },
          {
            "Text": "No",
            "Links": [],
            "Values": []
          }
        ],
        [
          {
            "Text": "entity",
            "Links": [],
            "Values": []
          },
          {
            "Text": "URN for the entity that contains a video and whose type should be ugcPost or share.",
            "Links": [],
            "Values": []
          },
          {
            "Text": "URN. For example, urn:li:ugcPost:6443156446455693312.",
            "Links": [],
            "Values": []
          },
          {
            "Text": "No",
            "Links": [],
            "Values": []
          }
        ],
        [
          {
            "Text": "queryType",
            "Links": [],
            "Values": []
          },
          {
            "Text": "Type of analytics requested.",
            "Links": [],
            "Values": []
          },
          {
            "Text": "String. Options: VIDEO_PLAY, VIDEO_VIEWER, VIDEO_WATCH_TIME.",
            "Links": [],
            "Values": []
          },
          {
            "Text": "No",
            "Links": [],
            "Values": []
          }
        ],
        [
          {
            "Text": "aggregation",
            "Links": [],
            "Values": []
          },
          {
            "Text": "Type of aggregation.",
            "Links": [],
            "Values": []
          },
          {
            "Text": "String. Options: DAILY: The query result will be a list of data points with metric counts broken down by day for the content. TOTAL (default): The query result will be a single data point with the total number of metric counts for the content.",
            "Links": [],
            "Values": []
          },
          {
            "Text": "Yes",
            "Links": [],
            "Values": []
          }
        ],
        [
          {
            "Text": "dateRange",
            "Links": [],
            "Values": []
          },
          {
            "Text": "The time range for fetching analytics.",
            "Links": [],
            "Values": []
          },
          {
            "Text": "The time range for which the analytics will be fetched. If missing, it will return analytics for the lifetime of the video. It is an object with start and end fields holding the start and end date/time. The time range is inclusive of the start and exclusive of the end. The start and end fields are both optional.",
            "Links": [],
            "Values": []
          },
          {
            "Text": "Yes",
            "Links": [],
            "Values": []
          }
        ]
      ]
    },
