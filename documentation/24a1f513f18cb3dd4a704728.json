    {
      "Kind": "code",
      "Section": "Sample Request",
      "Anchor": "sample-request",
      "SectionPath": [
        "Metrics Definition for Member Post Analytics",
        "Sample Request"
      ],
      "Text": "GET https://api.linkedin.com/rest/memberCreatorVideoAnalytics?q=entity\u0026entity=(share:urn%3Ali%3Ashare%3A7325786486870552578)\u0026queryType=VIDEO_PLAY\u0026aggregation=DAILY\u0026dateRange=(start:(day:4,month:5,year:2024),end:(day:6,month:5,year:2024))",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "code",
      "Section": "Sample Request",
      "Anchor": "sample-request",
      "SectionPath": [
        "Metrics Definition for Member Post Analytics",
        "Sample Request"
      ],
      "Text": "curl -X GET \u0027https://api.linkedin.com/rest/memberCreatorVideoAnalytics?q=entity\u0026entity=(share:urn%3Ali%3Ashare%3A7325786486870552578)\u0026queryType=VIDEO_PLAY\u0026aggregation=DAILY\u0026dateRange=(start:(day:4,month:5,year:2024),end:(day:6,month:5,year:2024))\u0027 \\\n-H \u0027X-Restli-Protocol-Version: 2.0.0\u0027 \\\n-H \u0027Authorization: Bearer {INSERT_TOKEN}\u0027 \\\n-H \u0027Linkedin-Version: {version number in the format YYYYMM}\u0027 \\\n-H \u0027Content-Type: application/json\u0027",
      "Headers": [],
      "Rows": []
    },
