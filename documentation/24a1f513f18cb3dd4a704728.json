      "Kind": "text",
      "Section": "Member Video Statistics",
      "Anchor": "member-video-statistics",
      "SectionPath": [],
      "Text": "The memberCreatorVideoAnalytics API retrieves video analytics from the member posts for an authenticated member.",
      "Headers": [],
      "Rows": []
    },
    {
