    {
      "Kind": "table",
      "Section": "Metrics Definition for Member Post Analytics",
      "Anchor": "metrics-definition-for-member-post-analytics",
      "SectionPath": [
        "Metrics Definition for Member Post Analytics"
      ],
      "Text": "",
      "Headers": [
        "Metric",
        "Definition"
      ],
      "Rows": [
        [
          {
            "Text": "VIDEO_PLAY",
            "Links": [],
            "Values": []
          },
          {
            "Text": "Video plays count with play-pause cycles for at least 2 seconds. Auto-looping videos are counted as one when loaded. Each subsequent auto-looped play doesn\u0027t increase this metric. Analytics data for this metric won\u0027t be available after one year of post creation.",
            "Links": [],
            "Values": []
          }
        ],
        [
          {
            "Text": "VIDEO_VIEWER",
            "Links": [],
            "Values": []
          },
          {
            "Text": "Unique viewers who made engaged plays on the video. Auto-looping videos are counted as one when loaded. Each subsequent auto-looped play doesn\u0027t increase this metric. Analytics data for this metric won\u0027t be available after one year of post creation.",
            "Links": [],
            "Values": []
          }
        ],
        [
          {
            "Text": "VIDEO_WATCH_TIME",
            "Links": [],
            "Values": []
          },
          {
            "Text": "The total time the video was watched, in milliseconds. Video auto-looping will continue to increase this metric for each subsequent play.",
            "Links": [],
            "Values": []
          }
        ]
      ]
    },
    {
      "Kind": "text",
      "Section": "Metrics Definition for Member Post Analytics",
      "Anchor": "metrics-definition-for-member-post-analytics",
