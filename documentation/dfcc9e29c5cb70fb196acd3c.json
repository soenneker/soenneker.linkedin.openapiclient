    {
      "Kind": "text",
      "Section": "Getting Started - Reporting",
      "Anchor": "getting-started---reporting",
      "SectionPath": [],
      "Text": "LinkedIn\u0027s Reporting APIs enable you to leverage\u00A0LinkedIn marketing data\u00A0to\u00A0automate internal reporting and gain valuable insights. Partners can integrate LinkedIn data into their solutions to retrieve performance data, targeting information,\u00A0audience insights, and much more. This guide provides a brief look at how these APIs can be used to provide valuable insights into audiences, impressions, targeting, and budgeting data.",
      "Headers": [],
      "Rows": []
    },
