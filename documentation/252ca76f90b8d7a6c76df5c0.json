      "Kind": "text",
      "Section": "Sync Interactions via Batch Update",
      "Anchor": "sync-interactions-via-batch-update",
      "SectionPath": [
        "Sync Interactions via Batch Update"
      ],
      "Text": "Perform HTTP PUT on the /tcrmInteractions endpoint to send talent CRM interactions to LinkedIn. Batch requests require the x-restli-method: batch_update header. Multiple records can be sent in a single API request as indicated in the example below.",
      "Headers": [],
      "Rows": []
    },
