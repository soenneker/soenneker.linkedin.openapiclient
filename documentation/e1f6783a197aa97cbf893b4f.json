      "Section": "Event Role Assignment",
      "Anchor": "event-role-assignment",
      "SectionPath": [],
      "Text": "The Event Role Assignment API returns the event attendees data and its associated role of an event. This API contains person URN as part of the API response and provides the finder method to get the event attendee of an event.",
      "Headers": [],
      "Rows": []
    },
