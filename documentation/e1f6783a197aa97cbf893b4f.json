    {
      "Kind": "text",
      "Section": "Retrieve Event Attendees for your Organization",
      "Anchor": "retrieve-event-attendees-for-your-organization",
      "SectionPath": [
        "Retrieve Event Attendees for your Organization"
      ],
      "Text": "This endpoint returns all event attendees within an event. This endpoint requires q=event with a event URN in the event parameter and an optional role to only fetch specific role among all attendees in a single event.",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Retrieve Event Attendees for your Organization",
      "Anchor": "retrieve-event-attendees-for-your-organization",
      "SectionPath": [
        "Retrieve Event Attendees for your Organization"
      ],
      "Text": "Since an organization can have a large volume of Events, this API supports pagination using the start and count parameters.",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Sample Request",
      "Anchor": "sample-request",
      "SectionPath": [
        "Retrieve Event Attendees for your Organization",
        "Sample Request"
      ],
      "Text": "http\n\n\ncurl",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "code",
      "Section": "Sample Request",
      "Anchor": "sample-request",
      "SectionPath": [
        "Retrieve Event Attendees for your Organization",
        "Sample Request"
      ],
      "Text": "GET https://api.linkedin.com/rest/dmaEventRoleAssignments?q=event\u0026event=urn%3Ali%3Aevent%3A7130261648786829313\u0026start=0\u0026count=2",
      "Headers": [],
      "Rows": []
