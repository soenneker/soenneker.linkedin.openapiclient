      "Kind": "text",
      "Section": "Data Freshness",
      "Anchor": "data-freshness",
      "SectionPath": [],
      "Text": "This guide focuses on refresh strategies for keeping data current and is only available for Plus tier. For initial data retrieval, call /verificationReport and /identityMe directly when the member authorizes your app.",
      "Headers": [],
      "Rows": []
    },
