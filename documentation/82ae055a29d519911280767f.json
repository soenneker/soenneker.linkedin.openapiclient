      "Section": "Example: Access Revoked",
      "Anchor": "example-access-revoked",
      "SectionPath": [
        "Method 2: Push Notifications",
        "Event Payload",
        "Example: Access Revoked"
      ],
      "Text": "When a member revokes your application\u0027s access, verification and profile status fields are not included:",
      "Headers": [],
      "Rows": []
    },
