    {
      "Kind": "text",
      "Section": "URN URL Encoding",
      "Anchor": "urn-url-encoding",
      "SectionPath": [
        "How to Use This API",
        "Permissions",
        "URN URL Encoding"
      ],
      "Text": "The {ORGANIZATION_URN} must be URL-encoded in the API request.Organization URN is in the format urn:li:organization:{organization id} and represents a LinkedIn Company Page.\nUse this API to find the Organization ID.",
      "Headers": [],
      "Rows": []
    },
