      "Kind": "text",
      "Section": "IAB Categories - Standardized Data API",
      "Anchor": "iab-categories---standardized-data-api",
      "SectionPath": [],
      "Text": "Mobile apps and web domains/pages are divided into categories called Interactive Advertising Bureau (IAB) Categories. These categories sort advertisers into standardized industries and segments. Though these categories do not change often, you should use this reference API to get current IAB categories. This API allows advertisers to align with LinkedIn\u0027s IAB Categories.",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Supported Methods",
      "Anchor": "supported-methods",
      "SectionPath": [
        "Supported Methods"
      ],
      "Text": "GET| GET_ALL",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "table",
      "Section": "Schema",
      "Anchor": "schema",
      "SectionPath": [
        "Schema"
      ],
      "Text": "",
      "Headers": [
        "Field Name",
        "Description"
      ],
      "Rows": [
        [
          {
            "Text": "displayName",
            "Links": [],
            "Values": []
          },
          {
            "Text": "This field contains localized strings used to describe the category based on locale request. Currently, we only support en_US.",
            "Links": [],
            "Values": []
          }
        ],
        [
          {
            "Text": "iabName",
            "Links": [],
            "Values": []
          },
          {
            "Text": "Original IAB category name as specified in OpenRTB 2.3 spec in the English language.",
            "Links": [],
            "Values": []
          }
        ],
        [
          {
            "Text": "id",
            "Links": [],
            "Values": []
          },
          {
            "Text": "The unique string used to represent the category. For example, IAB12-18.",
            "Links": [],
            "Values": []
          }
        ],
        [
          {
            "Text": "parentId",
            "Links": [],
            "Values": []
          },
          {
            "Text": "The unique string used to represent the parent category. For example, IAB12. If it is a parent category, this field can be null.",
            "Links": [],
            "Values": []
          }
        ]
      ]
    },
