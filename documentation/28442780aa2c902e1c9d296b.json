    {
      "Kind": "text",
      "Section": "API Overview",
      "Anchor": "api-overview",
      "SectionPath": [
        "API Overview"
      ],
      "Text": "Use the /simpleJobPosting API to create, update, renew and close jobs on LinkedIn. This wiki describes how to close jobs. To know more about this API, refer to API Overview.",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "API Endpoint",
      "Anchor": "api-endpoint",
      "SectionPath": [
        "API Overview",
        "API Endpoint"
      ],
      "Text": "Use the following endpoint to submit a task to create, close, update, or renew one or more jobs asynchronously:",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "code",
      "Section": "API Endpoint",
      "Anchor": "api-endpoint",
      "SectionPath": [
        "API Overview",
        "API Endpoint"
      ],
      "Text": "POST https://api.linkedin.com/v2/simpleJobPostings",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "code",
      "Section": "API Endpoint",
      "Anchor": "api-endpoint",
      "SectionPath": [
        "API Overview",
        "API Endpoint"
      ],
      "Text": "POST https://api.linkedin.com/rest/simpleJobPostings",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "API Authorization",
      "Anchor": "api-authorization",
      "SectionPath": [
        "API Overview",
        "API Authorization"
      ],
      "Text": "All requests below require access tokens obtained via the OAuth2.0 Client Credentials flow.",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "API Authorization",
      "Anchor": "api-authorization",
      "SectionPath": [
        "API Overview",
        "API Authorization"
      ],
      "Text": "Important",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "API Authorization",
      "Anchor": "api-authorization",
      "SectionPath": [
        "API Overview",
        "API Authorization"
      ],
      "Text": "We strongly recommend to use same access token for all concurrent and consecutive calls. An access token has a lifespan of 30 mins. Only on expiry of the existing token, new token should be generated.",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Sample Request for Premium Jobs",
      "Anchor": "sample-request-for-premium-jobs",
      "SectionPath": [
        "Sample Request for Premium Jobs"
      ],
