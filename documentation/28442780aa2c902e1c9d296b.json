      "Section": "Close Jobs",
      "Anchor": "close-jobs",
      "SectionPath": [],
      "Text": "To close a job, re-post the job using the same externalJobPostingId value, but set jobPostingOperationType to CLOSE.",
      "Headers": [],
      "Rows": []
    },
