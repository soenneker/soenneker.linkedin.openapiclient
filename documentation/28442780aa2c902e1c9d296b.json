      "Anchor": "sample-request-for-premium-jobs",
      "SectionPath": [
        "Sample Request for Premium Jobs"
      ],
      "Text": "The header for making the request is X-Restli-Method: batch_create.",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "code",
      "Section": "Sample Request for Premium Jobs",
      "Anchor": "sample-request-for-premium-jobs",
      "SectionPath": [
        "Sample Request for Premium Jobs"
      ],
      "Text": "Authorization: Bearer {token}\nx-restli-method: batch_create",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "code",
      "Section": "Sample Request for Premium Jobs",
      "Anchor": "sample-request-for-premium-jobs",
      "SectionPath": [
        "Sample Request for Premium Jobs"
      ],
      "Text": "Authorization: Bearer {token}\nx-restli-method: batch_create\nLinkedin-Version: 202603",
      "Headers": [],
      "Rows": []
    },
