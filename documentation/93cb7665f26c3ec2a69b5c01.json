      "Section": "Profile Details API (/identityMe)",
      "Anchor": "profile-details-api-identityme",
      "SectionPath": [],
      "Text": "The Profile Details API endpoint (/identityMe) retrieves LinkedIn member profile information including name, email, profile photo, and profile URL. Plus tier also provides access to current job and education details.",
      "Headers": [],
      "Rows": []
    },
