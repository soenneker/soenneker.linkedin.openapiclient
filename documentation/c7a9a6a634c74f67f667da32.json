      "Section": "Geo",
      "Anchor": "geo",
      "SectionPath": [],
      "Text": "Bing Geo is LinkedIn location taxonomy. Geo API will provide the display name for a given geo ID, or a set of geo IDs.",
      "Headers": [],
      "Rows": []
    },
    {
