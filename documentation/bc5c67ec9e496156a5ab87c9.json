      "Kind": "text",
      "Section": "Profile Edit API - Projects",
      "Anchor": "profile-edit-api---projects",
      "SectionPath": [],
      "Text": "This sub-resource API will allow you to create, update, and delete projects of a member.\u00A0See Project Fields for a description of the fields available within this object.",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Supported Methods",
      "Anchor": "supported-methods",
      "SectionPath": [
        "Supported Methods"
      ],
      "Text": "CREATE | PARTIAL_UPDATE | DELETE",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "code",
      "Section": "CREATE",
      "Anchor": "create",
      "SectionPath": [
        "CREATE"
      ],
      "Text": "POST https://api.linkedin.com/v2/people/id={person ID}/projects",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "code",
      "Section": "sample request body",
      "Anchor": "sample-request-body",
      "SectionPath": [
        "CREATE",
        "sample request body"
      ],
      "Text": "{\n  \u0022singleDate\u0022: true,\n  \u0022description\u0022: {\n    \u0022preferredLocale\u0022: {\n      \u0022country\u0022: \u0022US\u0022,\n      \u0022language\u0022: \u0022en\u0022\n    },\n    \u0022localized\u0022: {\n      \u0022en_US\u0022: {\n        \u0022rawText\u0022: \u0022Awesome platform!\u0022\n      }\n    }\n  },\n  \u0022url\u0022: \u0022http://www.developer.linkedin.com\u0022,\n  \u0022title\u0022: {\n    \u0022preferredLocale\u0022: {\n      \u0022country\u0022: \u0022US\u0022,\n      \u0022language\u0022: \u0022en\u0022\n    },\n    \u0022localized\u0022: {\n      \u0022en_US\u0022: \u0022LinkedIn API Project\u0022\n    }\n  },\n  \u0022members\u0022: [\n    {\n      \u0022memberId\u0022: \u0022urn:li:person:123ABC\u0022,\n      \u0022name\u0022: {\n        \u0022preferredLocale\u0022: {\n          \u0022country\u0022: \u0022US\u0022,\n          \u0022language\u0022: \u0022en\u0022\n        },\n        \u0022localized\u0022: {\n          \u0022en_US\u0022: \u0022test engineer\u0022\n        }\n      }\n    },\n    {\n      \u0022memberId\u0022: \u0022urn:li:person:456DEF\u0022,\n      \u0022name\u0022: {\n        \u0022preferredLocale\u0022: {\n          \u0022country\u0022: \u0022US\u0022,\n          \u0022language\u0022: \u0022en\u0022\n        },\n        \u0022localized\u0022: {\n          \u0022en_US\u0022: \u0022test engineer 2\u0022\n        }\n      }\n    }\n  ]\u0022startMonthYear\u0022: {\n    \u0022year\u0022: 2016,\n    \u0022month\u0022: 1\n  },\n  \u0022occupation\u0022: \u0022urn:li:position:(urn:li:person:123ABC,677616236)\u0022\n}",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "sample request body",
      "Anchor": "sample-request-body",
      "SectionPath": [
        "CREATE",
        "sample request body"
      ],
      "Text": "Note",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "sample request body",
      "Anchor": "sample-request-body",
      "SectionPath": [
        "CREATE",
        "sample request body"
      ],
      "Text": "A successful response will return a 201 Created HTTP status code. To record the created entity\u0027s id, refer to the header x-linkedin-id field.",
      "Headers": [],
      "Rows": []
    },
    {
