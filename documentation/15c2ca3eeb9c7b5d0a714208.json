    {
      "Kind": "text",
      "Section": "Member Data Obfuscation",
      "Anchor": "member-data-obfuscation",
      "SectionPath": [
        "Overview",
        "Member Data Obfuscation"
      ],
      "Text": "Member data obfuscation is performed per activity level to see if an activity\u0027s author is opted in or out for sharing their data. The DomainEntity field will be empty when the author is opted out for sharing their data.",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Locate the Activity URN",
      "Anchor": "locate-the-activity-urn",
      "SectionPath": [
        "How to Use the API (Usability Guide)",
        "Locate the Activity URN"
      ],
      "Text": "Activity URNs can be obtained from LinkedIn feed URLs:",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Locate the Activity URN",
      "Anchor": "locate-the-activity-urn",
      "SectionPath": [
        "How to Use the API (Usability Guide)",
        "Locate the Activity URN"
      ],
      "Text": "Navigate to a LinkedIn post or activity on linkedin.com\nClick on the three dots menu (\u22EF) on the post\nSelect \u0022Copy link to post\u0022 from the menu\nThe copied URL will be in the format: https://www.linkedin.com/feed/update/urn:li:activity:{id}\nExtract the activity URN portion: urn:li:activity:{id}",
      "Headers": [],
      "Rows": []
    },
    {
