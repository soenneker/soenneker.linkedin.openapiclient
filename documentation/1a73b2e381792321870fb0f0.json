    {
      "Kind": "text",
      "Section": "Example 1",
      "Anchor": "example-1",
      "SectionPath": [
        "Example 1"
      ],
      "Text": "All reserved characters need to be escaped with a backslash, even if those characters are not used in one of the supported elements or templates.\nReserved characters that need escaping are listed in the text section.",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "code",
      "Section": "Sample",
      "Anchor": "sample",
      "SectionPath": [
        "Example 1",
        "Sample"
      ],
      "Text": "{\n   \u0022commentary\u0022: \u0022Hello, these are some bullet points:\\n\\n\\\\* Point 1\\n\\\\* Point 2\\n\\\\* Point 3\u0022\n}",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "code",
      "Section": "content",
      "Anchor": "content",
      "SectionPath": [
        "Language Grammar",
        "content"
      ],
      "Text": "content ::= LittleText\u002B | \u0027EOF\u0027",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "code",
      "Section": "LittleText",
      "Anchor": "littletext",
      "SectionPath": [
        "Language Grammar",
        "LittleText"
      ],
      "Text": "LittleText ::= LittleElement\u002B",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "code",
      "Section": "LittleElement",
      "Anchor": "littleelement",
      "SectionPath": [
        "Language Grammar",
        "LittleElement"
      ],
      "Text": "LittleElement ::= TextElement | MentionElement | HashtagElement | HashtagTemplate",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "code",
      "Section": "HashtagTemplate",
      "Anchor": "hashtagtemplate",
      "SectionPath": [
        "Language Grammar",
        "HashtagTemplate"
      ],
      "Text": "HashtagTemplate ::=  \u0027{hashtag|\u0027 ( # | \uFF03) \u0027|\u0027 Text}\u0027",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "code",
      "Section": "MentionElement",
      "Anchor": "mentionelement",
      "SectionPath": [
        "Language Grammar",
        "MentionElement"
      ],
      "Text": "MentionElement ::= \u0027@\u0027 FallbackText? \u0027(\u0027 \u0027Urn\u0027 \u0027)\u0027",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "code",
      "Section": "Hashtag Element",
      "Anchor": "hashtag-element",
      "SectionPath": [
        "Language Grammar",
        "Hashtag Element"
      ],
      "Text": "HashtagElement ::= \u0027#\u0027 SINGLE_WORD",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Fallback Text",
      "Anchor": "fallback-text",
      "SectionPath": [
        "Language Grammar",
        "Fallback Text"
      ],
      "Text": "Text to be rendered and displayed (e.g. in place of MentionElement URN)",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "code",
      "Section": "Fallback Text",
      "Anchor": "fallback-text",
      "SectionPath": [
        "Language Grammar",
        "Fallback Text"
      ],
      "Text": "FallbackText ::= \u0027[\u0027 Text \u0027]\u0027",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "code",
      "Section": "Text",
      "Anchor": "text",
      "SectionPath": [
        "Language Grammar",
        "Text"
      ],
      "Text": "Text ::= ( NON_RESERVED_CHAR_SEQUENCES | \u0027\u0022\\\\|\u0022 | \u0022\\\\{\u0022 | \u0022\\\\}\u0022 | \u0022\\\\@\u0022 | \u0022\\\\[\u0022 | \u0022\\\\]\u0022 | \u0022\\\\(\u0022 | \u0022\\\\)\u0022 | \u0022\\\\\u003C\u0022 | \u0022\\\\\u003E\u0022 | \u0022\\\\#\u0022 | \u0022\\\\\\\\\u0022 | \u0022\\\\*\u0022 | \u0022\\\\_\u0022 | \u0022\\\\~\u0022\u0027 )\u002B",
      "Headers": [],
      "Rows": []
    }
