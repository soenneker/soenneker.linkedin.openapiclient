      "Section": "Example 1",
      "Anchor": "example-1",
      "SectionPath": [
        "Example 1"
      ],
      "Text": "{\n   \u0022commentary\u0022: \u0022This example mentions a {hashtag|\\\\#|MyTestTag}\u0022\n}",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Example 1",
