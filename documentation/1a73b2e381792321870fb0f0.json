    {
      "Kind": "text",
      "Section": "little Text Format",
      "Anchor": "little-text-format",
      "SectionPath": [],
      "Text": "Deprecation Notice:\nThe Marketing Version 202510 (Marketing October 2025) will be sunset on October 15, 2026. We recommend that you migrate to the latest versioned APIs to avoid disruptions. For information on all the supported versions, refer to the migrations documentation.\nIf you haven\u2019t yet migrated and have questions, submit a request on the LinkedIn Developer Support Portal.",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "little Text Format",
      "Anchor": "little-text-format",
      "SectionPath": [],
      "Text": "little is a representation of user-generated text with a focus on capturing non-textual information in a concise manner.",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "little Text Format",
      "Anchor": "little-text-format",
      "SectionPath": [],
      "Text": "In the Posts API, commentary text is stored as a text string along with an array of attributes. little is a simplified replacement for this model used in the Posts API.",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "little Text Format",
      "Anchor": "little-text-format",
      "SectionPath": [],
      "Text": "Note",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "little Text Format",
      "Anchor": "little-text-format",
      "SectionPath": [],
      "Text": "Characters reserved for little elements must be escaped to be treated as plaintext. See Text for a list of reserved characters.",
      "Headers": [],
      "Rows": []
    },
