          {
            "Text": "JP-A-01",
            "Links": [],
            "Values": []
          },
          {
            "Text": "Demonstrate ability to generate an access token using the OAuth2 Client Credentials method. Requests for tokens should not use GET HTTP methods.",
            "Links": [],
            "Values": []
          }
        ],
        [
          {
            "Text": "JP-A-02",
            "Links": [],
            "Values": []
          },
          {
            "Text": "Confirm ability to periodically verify that an access token is valid.",
            "Links": [],
            "Values": []
          }
        ],
        [
          {
            "Text": "JP-A-03",
            "Links": [],
            "Values": []
          },
          {
            "Text": "Confirm ability to detect access token expiry.",
            "Links": [],
            "Values": []
          }
        ],
        [
          {
            "Text": "JP-A-04",
            "Links": [],
            "Values": []
          },
          {
            "Text": "Confirm ability to retrigger OAuth 2.0 Client Credentials flow in case token has expired or been invalidated.",
            "Links": [],
            "Values": []
          }
        ]
      ]
    }
