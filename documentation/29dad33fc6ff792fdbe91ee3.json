      "Kind": "text",
      "Section": "Organization Services Page Providers",
      "Anchor": "organization-services-page-providers",
      "SectionPath": [],
      "Text": "The Organization Services Page Providers DMA API is used to fetch services page provider information for organizations. This API allows you to retrieve the services page configuration for an organization.",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Organization Services Page Providers",
      "Anchor": "organization-services-page-providers",
      "SectionPath": [],
      "Text": "This API currently provides the following methods:",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Organization Services Page Providers",
      "Anchor": "organization-services-page-providers",
      "SectionPath": [],
      "Text": "Finder organization to return the services page provider for a given organization.",
      "Headers": [],
      "Rows": []
    },
