      "Section": "Titles - Standardized Data API",
      "Anchor": "titles---standardized-data-api",
      "SectionPath": [],
      "Text": "The titles API provides standardized job title data across the LinkedIn platform. Each position or job is mapped to a list of titles and their higher granularities.",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Supported Methods",
      "Anchor": "supported-methods",
