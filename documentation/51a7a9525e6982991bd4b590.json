      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Retrieve seatholders",
      "Anchor": "retrieve-seatholders",
      "SectionPath": [
        "Retrieve seatholders"
      ],
      "Text": "The SeatsV2 requires usage of pagination. Requests that do not specify the start and count parameters will fail.",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Retrieve seatholders",
      "Anchor": "retrieve-seatholders",
      "SectionPath": [
        "Retrieve seatholders"
      ],
      "Text": "Retrieve seatholders for a contract using the following endpoint:",
      "Headers": [],
      "Rows": []
    },
    {
