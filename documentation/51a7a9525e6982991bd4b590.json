      "Section": "Retrieve seatholders",
      "Anchor": "retrieve-seatholders",
      "SectionPath": [
        "Retrieve seatholders"
      ],
      "Text": "GET https://api.linkedin.com/v2/seatsV2?q=attributes\u0026start=0\u0026count=5",
      "Headers": [],
      "Rows": []
