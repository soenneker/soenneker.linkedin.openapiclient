      "Section": "Live Videos",
      "Anchor": "live-videos",
      "SectionPath": [],
      "Text": "The Live Videos API allows you to interact with LinkedIn Live Videos, providing information about organization live video data. This API doesn\u2019t share member personal data as part of the API response.",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Live Videos",
      "Anchor": "live-videos",
      "SectionPath": [],
      "Text": "The service currently provides the following methods:",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Live Videos",
      "Anchor": "live-videos",
      "SectionPath": [],
      "Text": "Get: Retrieves information about a live video\nBatch Get: Retrieves information list of live videos",
      "Headers": [],
      "Rows": []
    },
