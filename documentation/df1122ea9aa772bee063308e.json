      "Kind": "text",
      "Section": "Degree",
      "Anchor": "degree",
      "SectionPath": [],
      "Text": "The degrees API provides standardized member degree and diploma data across the LinkedIn platform.",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Degree",
      "Anchor": "degree",
      "SectionPath": [],
      "Text": "Degrees represent academic qualifications on LinkedIn member profiles (e.g., Bachelor\u0027s, Master\u0027s, PhD).",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Degree",
      "Anchor": "degree",
      "SectionPath": [],
      "Text": "Note",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Degree",
      "Anchor": "degree",
      "SectionPath": [],
      "Text": "This API may also be referred to as \u0022Diploma\u0022 or \u0022Academic Qualification\u0022 in other contexts.",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Degree",
      "Anchor": "degree",
      "SectionPath": [],
      "Text": "The service currently provides the following methods:",
