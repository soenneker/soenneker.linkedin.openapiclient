      "Kind": "text",
      "Section": "Profile Edit API - Certifications",
      "Anchor": "profile-edit-api---certifications",
      "SectionPath": [],
      "Text": "The use of this API is restricted to those developers approved by LinkedIn and subject to applicable data restrictions in their agreements.",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Profile Edit API - Certifications",
      "Anchor": "profile-edit-api---certifications",
      "SectionPath": [],
      "Text": "This sub-resource API will allow you to create, update, and delete certifications of a member, with the member\u0027s authorization.",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Supported Methods",
      "Anchor": "supported-methods",
      "SectionPath": [
        "Supported Methods"
      ],
      "Text": "CREATE | PARTIAL UPDATE | DELETE",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "code",
      "Section": "CREATE",
      "Anchor": "create",
      "SectionPath": [
        "CREATE"
      ],
      "Text": "POST https://api.linkedin.com/v2/people/id={person ID}/certifications",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "code",
      "Section": "sample request body",
      "Anchor": "sample-request-body",
      "SectionPath": [
        "CREATE",
        "sample request body"
      ],
      "Text": "{\n    \u0022authority\u0022: {\n        \u0022localized\u0022: {\n            \u0022en_US\u0022: \u0022National Coding Authority\u0022\n        },\n        \u0022preferredLocale\u0022: {\n            \u0022country\u0022: \u0022US\u0022,\n            \u0022language\u0022: \u0022en\u0022\n        }\n    },\n    \u0022company\u0022: \u0022urn:li:organization:12345\u0022,\n    \u0022endMonthYear\u0022: {\n        \u0022month\u0022: 1,\n        \u0022year\u0022: 2005\n    },\n    \u0022licenseNumber\u0022: {\n        \u0022localized\u0022: {\n            \u0022en_US\u0022: \u0022L.N. 123456\u0022\n        },\n        \u0022preferredLocale\u0022: {\n            \u0022country\u0022: \u0022US\u0022,\n            \u0022language\u0022: \u0022en\u0022\n        }\n    },\n    \u0022name\u0022: {\n        \u0022localized\u0022: {\n            \u0022en_US\u0022: \u0022Certified LinkedIn Developer\u0022\n        },\n        \u0022preferredLocale\u0022: {\n            \u0022country\u0022: \u0022US\u0022,\n            \u0022language\u0022: \u0022en\u0022\n        }\n    },\n    \u0022startMonthYear\u0022: {\n        \u0022month\u0022: 1,\n        \u0022year\u0022: 2003\n    },\n    \u0022url\u0022: \u0022www.certification.linkedin.com\u0022\n}",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "sample request body",
      "Anchor": "sample-request-body",
      "SectionPath": [
        "CREATE",
        "sample request body"
      ],
      "Text": "Note",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "sample request body",
      "Anchor": "sample-request-body",
      "SectionPath": [
        "CREATE",
        "sample request body"
      ],
      "Text": "A successful response will return a 201 Created HTTP status code. To record the created entity\u0027s id, refer to the header x-linkedin-id field.",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "code",
      "Section": "PARTIAL UPDATE",
      "Anchor": "partial-update",
      "SectionPath": [
        "PARTIAL UPDATE"
      ],
      "Text": "POST https://api.linkedin.com/v2/people/id={person ID}/certifications/{certification ID}",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "code",
      "Section": "sample request body",
      "Anchor": "sample-request-body-1",
      "SectionPath": [
        "PARTIAL UPDATE",
        "sample request body"
      ],
      "Text": "{\n    \u0022patch\u0022: {\n        \u0022$set\u0022: {\n            \u0022authority\u0022: {\n                \u0022localized\u0022: {\n                    \u0022en_US\u0022: \u0022National Coding Program\u0022\n                },\n                \u0022preferredLocale\u0022: {\n                    \u0022country\u0022: \u0022US\u0022,\n                    \u0022language\u0022: \u0022en\u0022\n                }\n            },\n            \u0022name\u0022: {\n                \u0022localized\u0022: {\n                    \u0022en_US\u0022: \u0022Certified LinkedIn Engineer\u0022\n                },\n                \u0022preferredLocale\u0022: {\n                    \u0022country\u0022: \u0022US\u0022,\n                    \u0022language\u0022: \u0022en\u0022\n                }\n            },\n            \u0022url\u0022: \u0022www.certification.linkedin.com/professional-engineer\u0022\n        }\n    }\n}",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "sample request body",
      "Anchor": "sample-request-body-1",
      "SectionPath": [
        "PARTIAL UPDATE",
        "sample request body"
      ],
      "Text": "Sample Json to delete one or more fields. If you attempt to delete a field that is mandatory, the API will return a 422 Error Response. See Certification Fields for allowed list of fields for this resource.",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "code",
      "Section": "sample request body",
      "Anchor": "sample-request-body-2",
      "SectionPath": [
        "PARTIAL UPDATE",
        "sample request body"
      ],
      "Text": "{\n    \u0022patch\u0022: {\n        \u0022$delete\u0022: [\n            \u0022field1\u0022,\n            \u0022field2\u0022\n        ]\n    }\n}",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "code",
      "Section": "DELETE",
      "Anchor": "delete",
      "SectionPath": [
        "DELETE"
      ],
      "Text": "DELETE https://api.linkedin.com/v2/people/id={person ID}/certifications/{certification ID}",
      "Headers": [],
      "Rows": []
    }
  ]
