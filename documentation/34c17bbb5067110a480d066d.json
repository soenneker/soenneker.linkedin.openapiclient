      "Kind": "text",
      "Section": "Admin Content",
      "Anchor": "admin-content",
      "SectionPath": [],
      "Text": "The Admin Content API returns media gallery asset data for the organization (i.e., Company, School, and Showcase). MediaAssets contain media information such as images, videos, and more. This API doesn\u2019t share member personal data as part of the API response.",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Admin Content",
      "Anchor": "admin-content",
      "SectionPath": [],
      "Text": "The service currently provides the following methods:",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Admin Content",
      "Anchor": "admin-content",
      "SectionPath": [],
      "Text": "Find all media assets for a given organization",
      "Headers": [],
      "Rows": []
    },
    {
