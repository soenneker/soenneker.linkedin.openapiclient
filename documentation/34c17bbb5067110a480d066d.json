            "Links": [],
            "Values": []
          },
          {
            "Text": "Retrieve your organization\u2019s media assets (e.g. images, videos). Restricted to organizations in which the authenticated member has one of the following company page roles. ADMINISTRATORCONTENT_ADMINISTRATOR",
            "Links": [],
            "Values": [
              "ADMINISTRATOR",
              "CONTENT_ADMINISTRATOR"
            ]
          }
        ]
      ]
