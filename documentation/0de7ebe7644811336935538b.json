      "Kind": "text",
      "Section": "Profile Edit API - Volunteering Experiences",
      "Anchor": "profile-edit-api---volunteering-experiences",
      "SectionPath": [],
      "Text": "This sub-resource API will allow you to create, update, and delete volunteering experiences of a member.\u00A0See Volunteering Experience Fields for a description of the fields available within this object.",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Supported Methods",
      "Anchor": "supported-methods",
      "SectionPath": [
        "Supported Methods"
      ],
      "Text": "CREATE | PARTIAL_UPDATE | DELETE",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "code",
      "Section": "CREATE",
      "Anchor": "create",
      "SectionPath": [
        "CREATE"
      ],
      "Text": "POST https://api.linkedin.com/v2/people/id={person ID}/volunteeringExperiences",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "code",
      "Section": "sample request body",
      "Anchor": "sample-request-body",
      "SectionPath": [
        "CREATE",
        "sample request body"
      ],
      "Text": "{\n    \u0022cause\u0022: \u0022education\u0022,\n    \u0022company\u0022: \u0022urn:li:organization:0000\u0022,\n    \u0022companyName\u0022: {\n        \u0022localized\u0022: {\n            \u0022en_US\u0022: \u0022LinkedIn\u0022\n        },\n        \u0022preferredLocale\u0022: {\n            \u0022country\u0022: \u0022US\u0022,\n            \u0022language\u0022: \u0022en\u0022\n        }\n    },\n    \u0022description\u0022: {\n        \u0022localized\u0022: {\n            \u0022en_US\u0022: {\n                \u0022rawText\u0022: \u0022Helper!\u0022\n            }\n        },\n        \u0022preferredLocale\u0022: {\n            \u0022country\u0022: \u0022US\u0022,\n            \u0022language\u0022: \u0022en\u0022\n        }\n    },\n    \u0022localizedRole\u0022: \u0022Volunteer\u0022,\n    \u0022role\u0022: {\n        \u0022localized\u0022: {\n            \u0022en_US\u0022: \u0022Volunteer\u0022\n        },\n        \u0022preferredLocale\u0022: {\n            \u0022country\u0022: \u0022US\u0022,\n            \u0022language\u0022: \u0022en\u0022\n        }\n    },\n    \u0022singleDate\u0022: false,\n    \u0022startMonthYear\u0022: {\n        \u0022month\u0022: 2,\n        \u0022year\u0022: 2016\n    }\n}",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "sample request body",
      "Anchor": "sample-request-body",
      "SectionPath": [
        "CREATE",
        "sample request body"
      ],
      "Text": "Note",
      "Headers": [],
      "Rows": []
