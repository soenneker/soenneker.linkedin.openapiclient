      "Kind": "text",
      "Section": "adCampaignGroups",
      "Anchor": "adcampaigngroups",
      "SectionPath": [],
      "Text": "Campaign groups provide advertisers a way to manage status, budget, and measure performance across multiple related campaigns.",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
