    {
      "Kind": "text",
      "Section": "Comment URNs",
      "Anchor": "comment-urns",
      "SectionPath": [
        "Comment URNs"
      ],
      "Text": "A comment URN is a composite URN combining the parent thread URN (post or comment) with the comment ID.",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "code",
      "Section": "Comment URNs",
      "Anchor": "comment-urns",
      "SectionPath": [
        "Comment URNs"
      ],
      "Text": "urn:li:comment:(\u003Cpost_or_comment_urn\u003E,\u003Ccomment_id\u003E)",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "code",
      "Section": "Example \u2014 Top-Level Comment",
      "Anchor": "example--top-level-comment",
      "SectionPath": [
        "Example \u2014 Top-Level Comment"
      ],
      "Text": "Post URN:       urn:li:activity:{ACTIVITY_ID}\nComment ID:     {COMMENT_ID}\nComment URN:    urn:li:comment:(urn:li:activity:{ACTIVITY_ID},{COMMENT_ID})",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Example \u2014 Nested Comment",
      "Anchor": "example--nested-comment",
      "SectionPath": [
        "Example \u2014 Nested Comment"
      ],
      "Text": "A nested comment is also known as a reply or comment reply. When a user replies to an existing comment on LinkedIn, it creates a nested comment structure where the reply is linked to its parent comment.",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "code",
      "Section": "Example \u2014 Nested Comment",
      "Anchor": "example--nested-comment",
      "SectionPath": [
        "Example \u2014 Nested Comment"
      ],
      "Text": "Parent Comment URN:   urn:li:comment:(urn:li:activity:{ACTIVITY_ID},{PARENT_COMMENT_ID})\nReply Comment ID:     {REPLY_COMMENT_ID}\nNested Comment URN:   urn:li:comment:(urn:li:comment:(urn:li:activity:{ACTIVITY_ID},{PARENT_COMMENT_ID}),{REPLY_COMMENT_ID})",
      "Headers": [],
      "Rows": []
    },
