      "Section": "Access",
      "Anchor": "access",
      "SectionPath": [
        "Access"
      ],
      "Text": "An organizational admin can access a comment through this API if one of the following is true:",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Access",
      "Anchor": "access",
      "SectionPath": [
        "Access"
      ],
      "Text": "That organization/organizationalPage created the comment\nThat organization/organizationalPage created the post or comment that the requested comment is under",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Access",
      "Anchor": "access",
      "SectionPath": [
        "Access"
      ],
      "Text": "If a non-authorized viewer tries to access comments, the API will throw 403.",
