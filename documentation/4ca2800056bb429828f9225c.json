      "Kind": "text",
      "Section": "Comments API",
      "Anchor": "comments-api",
      "SectionPath": [],
      "Text": "DMA Comment API returns comments or nested comments on a post or a comment. DMA comment API only supports BATCH_GET.",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Comments API",
      "Anchor": "comments-api",
      "SectionPath": [],
      "Text": "The service currently provides the following methods:",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Comments API",
      "Anchor": "comments-api",
      "SectionPath": [],
      "Text": "BATCH_GET - List of DMA comments for the given set of ids (commentUrns)",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Comment Example",
      "Anchor": "comment-example",
      "SectionPath": [
