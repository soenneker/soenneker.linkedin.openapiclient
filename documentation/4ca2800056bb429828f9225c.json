      "Kind": "text",
      "Section": "Obtaining Comment URNs",
      "Anchor": "obtaining-comment-urns",
      "SectionPath": [
        "Example \u2014 Nested Comment",
        "Obtaining Comment URNs"
      ],
      "Text": "There are two methods to obtain Comment URNs:",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Method 1: Using the commentsOnEntity Finder",
      "Anchor": "method-1-using-the-commentsonentity-finder",
      "SectionPath": [
        "Example \u2014 Nested Comment",
        "Obtaining Comment URNs",
        "Method 1: Using the commentsOnEntity Finder"
      ],
      "Text": "Use the DMA Feed Content API\u0027s commentsOnEntity finder to retrieve comment URNs for an entity.",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Method 1: Using the commentsOnEntity Finder",
      "Anchor": "method-1-using-the-commentsonentity-finder",
      "SectionPath": [
        "Example \u2014 Nested Comment",
        "Obtaining Comment URNs",
        "Method 1: Using the commentsOnEntity Finder"
      ],
      "Text": "Step 1: Call the commentsOnEntity finder:",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "code",
      "Section": "Method 1: Using the commentsOnEntity Finder",
      "Anchor": "method-1-using-the-commentsonentity-finder",
      "SectionPath": [
        "Example \u2014 Nested Comment",
        "Obtaining Comment URNs",
        "Method 1: Using the commentsOnEntity Finder"
      ],
      "Text": "GET https://api.linkedin.com/rest/dmaFeedContentsExternal?q=commentsOnEntity\u0026entity=urn%3Ali%3Aactivity%3A{ACTIVITY_ID}\u0026start=0\u0026count=100\u0026maxPaginationCount=100",
      "Headers": [],
      "Rows": []
    },
    {
      "Kind": "text",
      "Section": "Method 1: Using the commentsOnEntity Finder",
      "Anchor": "method-1-using-the-commentsonentity-finder",
