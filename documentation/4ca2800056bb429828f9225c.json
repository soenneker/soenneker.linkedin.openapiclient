      ],
      "Rows": [
        [
          {
            "Text": "r_dma_admin_pages_content",
            "Links": [],
            "Values": []
          },
          {
            "Text": "Retrieve your organization\u2019s comments and comments made under your organization\u0027s posts or comments. Restricted to organizations in which the authenticated member has the following company page role. ADMINISTRATORCONTENT_ADMINISTRATOR",
            "Links": [],
            "Values": [
              "ADMINISTRATOR",
              "CONTENT_ADMINISTRATOR"
            ]
          }
        ]
      ]
    },
    {
      "Kind": "text",
