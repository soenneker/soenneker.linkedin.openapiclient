                              "type": "string"
                            }
                          },
                          "facetName": {
                            "type": "string"
                          },
                          "$URN": {
                            "type": "string"
                          },
                          "availableEntityFinders": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
