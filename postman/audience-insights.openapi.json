              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "required": [
                    "paging",
                    "elements"
                  ],
                  "type": "object",
                  "properties": {
                    "paging": {
                      "required": [
                        "start",
                        "count",
                        "links"
                      ],
                      "type": "object",
                      "properties": {
                        "start": {
                          "type": "integer"
                        },
                        "count": {
                          "type": "integer"
                        },
                        "links": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        }
                      }
                    },
                    "elements": {
                      "type": "array",
                      "items": {
                        "required": [
                          "entityTypes",
                          "facetName",
                          "$URN",
                          "availableEntityFinders"
                        ],
                        "type": "object",
                        "properties": {
                          "entityTypes": {
                            "type": "array",
