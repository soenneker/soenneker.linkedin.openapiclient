    "/leadnotifications/<webhook id>": {
      "delete": {
        "summary": "[PUSH] Delete a registered webhook by id",
        "description": "[Delete a lead notification subsription](https://learn.microsoft.com/en-us/linkedin/marketing/integrations/lead-sync/leadsync?tabs=http#delete-lead-notification-url)\n\nWhen an integration is deleted, the associated webhooks should also be deleted to ensure that lead notifications are not unnecessarily being sent.",
