{"info":{"_postman_id":"ce7f8bd1-b44b-4e0c-b71d-72127ba642e7","name":"Verified on LinkedIn","description":"The Verified on LinkedIn API allows you to access trusted verification signals from LinkedIn members, enabling you to display verified identity and workplace information directly within your platform.","schema":"https://schema.getpostman.com/json/collection/v2.0.0/collection.json"},"item":[{"name":"Identity Me API","item":[{"name":"version-202510.03","item":[{"name":"identityMe","id":"05ed7a1c-71cb-4901-ac5e-b3bb3826e007","protocolProfileBehavior":{"disableBodyPruning":true},"request":{"method":"GET","header":[{"key":"LinkedIn-Version","value":"202510.03"}],"url":"https://api.linkedin.com/rest/identityMe","description":"The **Identity API** (`/identityMe`) provides a simple way for partners to retrieve LinkedIn Member profile details. [Learn more ](https://learn.microsoft.com/en-us/linkedin/consumer/integrations/verified-on-linkedin/api-reference/identity-me?context=linkedin%2Fconsumer%2Fcontext) by viewing our public documentation."},"response":[{"id":"cd0aec97-0050-4ca8-b628-e7641e0a017e","name":"identityMe-200","originalRequest":{"method":"GET","header":[{"key":"LinkedIn-Version","value":"202510.03"}],"url":"https://api.linkedin.com/rest/identityMe"},"_postman_previewlanguage":null,"header":null,"cookie":[],"responseTime":null,"body":"{\n\t\"lastRefreshedAt\": 1760631246905,\n\t\"basicInfo\": {\n    \t\"profileUrl\": \"https://www.linkedin.com/profile-thirdparty-redirect/AFw7Tw9YDLbPn8exJln1FFI074SVkNAH8eIr_u-rdXZCPyXMUTb3sTCE81RbfN_yO7870\",\n    \t\"profilePicture\": {\n        \t\"croppedImage\": {\n            \t\"downloadUrl\": \"https://media.licdn.com/dms/image/v2/0hYE9aEqulDqnnCpvzUnx8dZy2T5yhR8\",\n                \"downloadUrlExpiresAt\": 1763596800000\n        \t}\n    \t},\n    \t\"lastName\": {\n        \t\"localized\": {\n            \t\"en_US\": \"Doe\"\n        \t},\n        \t\"preferredLocale\": {\n            \t\"country\": \"US\",\n      