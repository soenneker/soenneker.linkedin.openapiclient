,"response":[{"id":"8f01c8ce-2e41-45e1-9406-04bf2196c9c9","name":"Fetch verifications","originalRequest":{"method":"GET","header":[{"key":"Linkedin-Version","value":"202510"}],"url":"https://api.linkedin.com/rest/verificationReport"},"_postman_previewlanguage":null,"header":null,"cookie":[],"responseTime":null,"body":"{\n  \"verifications\": [\"IDENTITY\", \"WORKPLACE\"],\n  \"id\": \"Yw-zU_kyua\"\n}"},{"id":"6149c6be-c9d6-42b9-91b4-e0c0df470ed1","name":"Fetch verification with Identity criteria","originalRequest":{"method":"GET","header":[{"key":"Linkedin-Version","value":"202510"}],"url":{"raw":"https://api.linkedin.com/rest/verificationReport?verificationCriteria=IDENTITY","protocol":"https","host":["api","linkedin","com"],"path":["rest","verificationReport"],"query":[{"key":"verificationCriteria","value":"IDENTITY"}]}},"_postman_previewlanguage":null,"header":null,"cookie":[],"responseTime":null,"body":"{\n  \"verifications\": [\"IDENTITY\"],\n  \"id\": \"Yw-zU_kyua\"\n}"},{"id":"21fec06c-4e43-4ded-a75a-c5e04f23c893","name":"Fetch verification with Workplace criteria","originalRequest":{"method":"GET","header":[{"key":"Linkedin-Version","value":"202510"}],"url":{"raw":"https://api.linkedin.com/rest/verificationReport?verificationCriteria=WORKPLACE","protocol":"https","host":["api","linkedin","com"],"path":["rest","verificationReport"],"query":[{"key":"verificationCriteria","value":"WORKPLACE"}]}},"_postman_previewlanguage":null,"header":null,"cookie":[],"responseTime":null,"body":"{\n  \"verifications\": [\"IDENTITY\"],\n  \"id\": \"Yw-zU_kyua\",\n  \"verificationUrl\": \"https://www.linkedin.com/trust/verification?isDeeplinkToCCT=true&verificationUrl=https%3A%2F%2Fwww.linkedin.com%2Fverify%3FentryPoint%3Dfederation_external_api%26partnerId%3DAgFAAk4lCixcPAbCBxA%26verificationCriteria%3D2522WORK_EMAIL_ADDRESS%2522%2%2522WORK_EMAIL_ADDRESS%2255D%257D\"\n}\n"},{"id":"5b15103c-80b9-4bff-81e2-df64242c6c16","name":"Fetch verifications with Identity and Workplace criteria","originalRequest":{"method":"GET","header":[{"key":"Linkedin-Version","value":"202510"}],"url":{"raw":"https://api.linkedin.com/rest/verificationReport?verificationCriteria=IDENTITY&verificationCriteria=WORKPLACE","protocol":"https","host":["api","linkedin","com"],"path":["rest","verificationReport"],"query":[{"key":"verificationCriteria","value":"IDENTITY"},{"key":"verificationCriteria","value":"WORKPLACE"}]}},"_postman_previewlanguage":null,"header":null,"cookie":[],"responseTime":null,"body":"{\n  \"verifications\": [\"IDENTITY\", \"WORKPLACE\"],\n  \"id\": \"Yw-zU_kyua\"\n}\n"}]}],"id":"f52b03e9-b375-4d0e-9155-0d781346c543","description":"`/verificationReport` API is versioned api. use the latest verison- version-202510 in request header."}],"id":"e2a85f26-c47e-45ee-acd8-822acfb99953","description":"The **Verification Report API** allows partners to retrieve the verified categories (for example, `IDENTITY`, `WORKPLACE`) associated with a LinkedIn Member, or to obtain a `verificationUrl` that enables Members to complete eligible verifications on LinkedIn. VerificationCriteria does not filter out verifications, it is only for the verificationUrl generated to show which categories the partner is interested in."},{"name":"Validation Status API","item":[{"name":"version-202510","item":[{"name":"validationStatus","id":"f636187a-f753-47b8-984e-e793ab20fa55","protocolProfileBehavior":{"disableBodyPruning":true},"request":{"method":"POST","header":[{"key":"Linkedin-Version","value":"202510"}],"body":{"mode":"raw","raw":"{\n  \"validationQueries\": [\n    {\n      \"id\": \"string\"\n    }\n  ]\n}","options":{"raw":{"language":"json"}}},"url":{"raw":"https://api.linkedin.com/rest/validationStatus?action=retrieve","protocol":"https","host":["api","linkedin","com"],"path":["rest","validationStatus"],"query":[{"key":"action","value":"retrieve"}]},"description":"The **Validation Status API** lets Plus-tier partners check the current validation state of LinkedIn members at scale (single or bulk). It returns compact status flags for `identity`, `workplace`, and `profileInformationStatus.`[Learn more ](https://learn.microsoft.com/en-us/linkedin/consumer/integrations/verified-on-linkedin/api-reference/validation-status?context=linkedin%2Fconsumer%2Fcontext) by viewing our public documentation."},"response":[{"id":"67e1f299-5a3a-471a-8e24-42aa91479800","name":"Single Member Validation","originalRequest":{"method":"POST","header":[{"key":"Linkedin-Version","value":"202510"}],"body":{"mode":"raw","raw":"{\n  \"validationQueries\": [\n    {\n      \"id\": \"abc123\"\n    }\n  ]\n}","options":{"raw":{"language":"json"}}},"url":{"raw":"https://api.linkedin.com/rest/validationStatus?action=retrieve","protocol":"https","host":["api","linkedin","com"],"path":["rest","validationStatus"],"query":[{"key":"action","value":"retrieve"}]}},"_postman_previewlanguage":null,"header":null,"cookie":[],"responseTime":null,"body":"{\n  \"value\": [\n    {\n      \"id\": \"abc123\",\n      \"verificationStatus\": {\n        \"identity\": \"VALID\",\n        \"workplace\": \"VALID\"\n      },\n      \"profileInformationStatus\": \"VALID\"\n    }\n  ]\n}"},{"id":"7f5f1f3f-a4da-478b-b505-d921d5fa5719","name":"Bulk Member Validation","originalRequest":{"method":"POST","header":[{"key":"Linkedin-Version","value":"202510"}],"body":{"mode":"raw","raw":"{\n  \"validationQueries\": [\n    {\n      \"id\": \"abc123\"\n    },\n    {\n      \"id\": \"def456\"\n    },\n    {\n      \"id\": \"ghi789\"\n    }\n  ]\n}\n","options":{"raw":{"language":"json"}}},"url":{"raw":"https://api.linkedin.com/rest/validationStatus?action=retrieve","protocol":"https","host":["api","linkedin","com"],"path":["rest","validationStatus"],"query":[{"key":"action","value":"retrieve"}]}},"_postman_previewlanguage":null,"header":null,"cookie":[],"responseTime":null,"body":"{\n  \"value\": [\n    {\n      \"id\": \"abc123\",\n      \"verificationStatus\": {\n        \"identity\": \"VALID\",\n        \"workplace\": \"VALID_WITH_UPDATES\"\n      },\n      \"profileInformationStatus\": \"VALID\"\n    },\n    {\n      \"id\": \"def456\",\n      \"verificationStatus\": {\n        \"identity\": \"INVALID\",\n        \"workplace\": \"VALID\"\n      },\n      \"profileInformationStatus\": \"INVALID\"\n    },\n    {\n      \"id\": \"ghi789\",\n      \"verificationStatus\": {\n        \"identity\": \"VALID\",\n        \"workplace\": \"VALID\"\n      },\n      \"profileInformationStatus\": \"VALID\"\n    }\n  ]\n}"}]}],"id":"6153b63d-e8fc-4111-911c-052ec061c7bf","description":"`/validationStatus` API is versioned api. use the latest verison-202510 in request header."}],"id":"aa57a0f4-00f0-49b7-8b3c-24da5e554e24","description":"The **Validation Status API** lets Plus-tier partners check the current validation state of LinkedIn members at scale (single or bulk). It returns compact status flags for `identity`, `workplace`, and `profileInformationStatus` so you can quickly identify which members need fresh profile or verification data. This endpoint uses **2-legged OAuth (client credentials)** — no member consent required — and supports up to **500 member IDs per request** (use the `id` from `/identityMe` or `/verificationReport`)."}],"auth":{"type":"oauth2","oauth2":{"addTokenTo":"header"}},"event":[{"listen":"prerequest","script":{"id":"ced4215a-ecd0-4f52-b3cd-e03ff3fb9c32","type":"text/javascript","packages":{},"requests":{},"exec":[""]}},{"listen":"test","script":{"id":"77983299-e4df-4b82-a2d7-7b03968955dc","type":"text/javascript","packages":{},"requests":{},"exec":[""]}}]}